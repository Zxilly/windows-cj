@When[Windows_Win32_System_Console == "on"]
public let MOUSE_EVENT: UInt32 = 2u32
@When[Windows_Win32_System_Console == "on"]
public let WINDOW_BUFFER_SIZE_EVENT: UInt32 = 4u32
@When[Windows_Win32_System_Console == "on"]
public let MENU_EVENT: UInt32 = 8u32
@When[Windows_Win32_System_Console == "on"]
public let FOCUS_EVENT: UInt32 = 16u32
