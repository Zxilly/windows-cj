package windows

import std.collection.*
import std.fs.*

let GENERATED_FILE_MARKER = "Generated by windows-gen. DO NOT EDIT."

class CliConfig {
    public let features: ArrayList<String> = ArrayList<String>()
    public let inputJsonPaths: ArrayList<String> = ArrayList<String>()
    public let supportPackageDirs: ArrayList<String> = ArrayList<String>()
    public var outputDir: String = ".generated/windows"
    public var packageName: String = "windows_gen"
    public var manifestPath: String = ""
    public var clean: Bool = false
    public var dryRun: Bool = false
    public var listFeatures: Bool = false
    public var printLinkOptions: Bool = false
    public var help: Bool = false
    public var common: Bool = false
}

class GeneratedPackageWriter {
    let outputDir: String
    let dryRun: Bool
    let writtenFiles: ArrayList<String> = ArrayList<String>()

    public init(outputDir: String, dryRun: Bool) {
        this.outputDir = outputDir
        this.dryRun = dryRun
    }

    public func writeFile(relativePath: String, content: String): Unit {
        writtenFiles.add(relativePath)
        if (dryRun) {
            return
        }
        let fullPath = "${outputDir}/${relativePath}"
        ensureDir(directoryOf(fullPath))
        File.writeTo(fullPath, addGeneratedFileHeader(relativePath, content).toArray())
    }

    public func files(): ArrayList<String> {
        return writtenFiles
    }
}

func addGeneratedFileHeader(relativePath: String, content: String): String {
    let header = generatedFileHeader(relativePath)
    if (header.isEmpty() || startsWithString(content, header)) {
        return content
    }
    return header + content
}

func generatedFileHeader(relativePath: String): String {
    if (endsWithString(relativePath, ".cj")) {
        return "// ${GENERATED_FILE_MARKER}\n\n"
    }
    if (endsWithString(relativePath, ".toml")) {
        return "# ${GENERATED_FILE_MARKER}\n\n"
    }
    return ""
}

main(args: Array<String>): Int64 {
    try {
        let config = parseArgs(args)
        if (config.help) {
            printUsage()
            return 0
        }
        let records = loadSymbolRecords(config)
        if (config.listFeatures) {
            printFeatures(records)
            return 0
        }
        if (config.printLinkOptions) {
            printFeatureLinkOptions(config, records)
            return 0
        }
        generate(config, records)
        return 0
    } catch (err: Exception) {
        println("windows bindgen error: ${err}")
        return 1
    }
}

func parseArgs(args: Array<String>): CliConfig {
    let config = CliConfig()
    var i: Int64 = 0
    while (i < Int64(args.size)) {
        let arg = args[i]
        match (arg) {
            case "--feature" =>
                i += 1
                if (i >= Int64(args.size)) {
                    throw Exception("--feature requires a value")
                }
                addUnique(config.features, args[i])
            case "--input-json" =>
                i += 1
                if (i >= Int64(args.size)) {
                    throw Exception("--input-json requires a value")
                }
                addUnique(config.inputJsonPaths, args[i])
            case "--support-package-dir" =>
                i += 1
                if (i >= Int64(args.size)) {
                    throw Exception("--support-package-dir requires a value")
                }
                addUnique(config.supportPackageDirs, args[i])
            case "--out" =>
                i += 1
                if (i >= Int64(args.size)) {
                    throw Exception("--out requires a value")
                }
                config.outputDir = args[i]
            case "--manifest" =>
                i += 1
                if (i >= Int64(args.size)) {
                    throw Exception("--manifest requires a value")
                }
                config.manifestPath = args[i]
            case "--common" =>
                config.common = true
                config.packageName = "windows_common"
                if (config.outputDir == ".generated/windows") {
                    config.outputDir = "windows-common"
                }
            case "--clean" => config.clean = true
            case "--dry-run" => config.dryRun = true
            case "--list-features" => config.listFeatures = true
            case "--print-link-options" => config.printLinkOptions = true
            case "--print-link-option" => config.printLinkOptions = true
            case "--help" =>
                config.help = true
            case _ => throw Exception("unknown argument: ${arg}")
        }
        i += 1
    }
    if (config.common && config.supportPackageDirs.isEmpty()) {
        addUnique(config.supportPackageDirs, "windows-version")
        addUnique(config.supportPackageDirs, "windows-registry")
        addUnique(config.supportPackageDirs, "windows-threading")
        addUnique(config.supportPackageDirs, "windows-services")
        addUnique(config.supportPackageDirs, "windows-winui3")
        addUnique(config.supportPackageDirs, "windows-webview2")
    }
    if (config.features.isEmpty() && !config.common && !config.listFeatures && !config.help) {
        addUnique(config.features, "all")
    }
    return config
}

func loadSymbolRecords(config: CliConfig): ArrayList<SymbolRecord> {
    if (config.help) {
        return ArrayList<SymbolRecord>()
    }
    let winmdFiles = loadWinmdJsonFiles(config.inputJsonPaths)
    return buildSymbolRecords(winmdFiles)
}

func generate(config: CliConfig, records: ArrayList<SymbolRecord>): Unit {
    ensureCommonFeatureSelection(config)
    validateRequestedFeatures(config.features, records)
    if (config.clean && !config.dryRun) {
        removeIfExists(config.outputDir, recursive: true)
    }

    let selected = selectedSymbolsForConfig(config, records)
    let selectedByName = recordsByFullName(selected)
    let supportDeps = collectSupportDependencyNames(config.packageName, selected, selectedByName)
    let writer = GeneratedPackageWriter(config.outputDir, config.dryRun)
    writer.writeFile("cjpm.toml", renderCjpmToml(config.packageName, supportDeps: supportDeps))
    writer.writeFile("src/mod.cj", "package ${config.packageName}\n")
    if (!supportDeps.isEmpty()) {
        writer.writeFile("src/support_deps.cj", renderSupportDependencyImports(config.packageName, supportDeps: supportDeps))
    }
    writer.writeFile("src/impl/mod.cj", "package ${config.packageName}.impl\n")
    writeImplFiles(writer, selected, config.packageName, selectedByName)
    let namespaces = selectedNamespaces(selected)
    writeIntermediateNamespaceModules(writer, namespaces, config.packageName)
    for (namespace in namespaces) {
        writer.writeFile(namespaceToRelativePath(namespace), "package ${namespaceToPackage(namespace, config.packageName)}\n")
        writeFacadeFiles(writer, namespace, selected, config.packageName)
    }

    let manifest = renderManifest(config.features, selected, writer.files(), config.packageName)
    if (!config.manifestPath.isEmpty()) {
        if (!config.dryRun) {
            ensureDir(directoryOf(config.manifestPath))
            File.writeTo(config.manifestPath, manifest.toArray())
        }
    } else {
        writer.writeFile("codegen-manifest.json", manifest)
    }
}

func ensureCommonFeatureSelection(config: CliConfig): Unit {
    if (config.common && config.features.isEmpty()) {
        for (feature in collectCommonFeatureNames(config.supportPackageDirs)) {
            addUnique(config.features, feature)
        }
        if (config.features.isEmpty()) {
            throw Exception("--common did not find support package imports; pass --feature or --support-package-dir")
        }
    }
}

func featureLinkOptions(config: CliConfig, records: ArrayList<SymbolRecord>): ArrayList<String> {
    ensureCommonFeatureSelection(config)
    validateRequestedFeatures(config.features, records)
    let selected = selectedSymbolsForConfig(config, records)
    let selectedByName = recordsByFullName(selected)
    let supportDeps = collectSupportDependencyNames(config.packageName, selected, selectedByName)
    return collectSupportLinkOptions(supportDeps)
}

func printFeatureLinkOptions(config: CliConfig, records: ArrayList<SymbolRecord>): Unit {
    println(joinStrings(featureLinkOptions(config, records), " "))
}

func validateRequestedFeatures(features: ArrayList<String>, records: ArrayList<SymbolRecord>): Unit {
    if (contains(features, "all")) {
        return
    }
    let available = featureNamesFromRecords(records)
    for (feature in features) {
        var found = false
        for (candidate in available) {
            if (candidate == feature) {
                found = true
                break
            }
        }
        if (!found) {
            throw Exception("unknown feature: ${feature}")
        }
    }
}

func selectSymbols(features: ArrayList<String>, records: ArrayList<SymbolRecord>): ArrayList<SymbolRecord> {
    return selectSymbolsFromRecords(features, records)
}

func selectedSymbolsForConfig(config: CliConfig, records: ArrayList<SymbolRecord>): ArrayList<SymbolRecord> {
    let selected = selectSymbols(config.features, records)
    if (config.common) {
        return filterCommonSymbols(selected)
    }
    return selected
}

func filterCommonSymbols(symbols: ArrayList<SymbolRecord>): ArrayList<SymbolRecord> {
    let filtered = ArrayList<SymbolRecord>()
    for (symbol in symbols) {
        match (symbol.typeDef) {
            case Some(typeDef) =>
                if (!hasPInvokeMethods(typeDef)) {
                    filtered.add(symbol)
                }
            case None => filtered.add(symbol)
        }
    }
    return filtered
}

func recordsByFullName(records: ArrayList<SymbolRecord>): HashMap<String, SymbolRecord> {
    let recordsByName = HashMap<String, SymbolRecord>()
    for (record in records) {
        recordsByName.add(record.fullName, record)
    }
    return recordsByName
}

func selectSymbolsFromRecords(features: ArrayList<String>, records: ArrayList<SymbolRecord>): ArrayList<SymbolRecord> {
    let selectedNames = ArrayList<String>()
    let selectedNameSet = HashSet<String>()
    let recordsByName = HashMap<String, SymbolRecord>()
    for (record in records) {
        recordsByName.add(record.fullName, record)
    }

    if (contains(features, "all")) {
        for (record in records) {
            selectedNames.add(record.fullName)
            selectedNameSet.add(record.fullName)
        }
    } else {
        for (record in records) {
            if (contains(features, record.namespace)) {
                if (!selectedNameSet.contains(record.fullName)) {
                    selectedNames.add(record.fullName)
                    selectedNameSet.add(record.fullName)
                }
            }
        }
    }

    var cursor: Int64 = 0
    while (cursor < Int64(selectedNames.size)) {
        let fullName = selectedNames[cursor]
        if (recordsByName.contains(fullName)) {
            let record = recordsByName.get(fullName).getOrThrow()
            for (dependency in record.dependencies) {
                if (!selectedNameSet.contains(dependency) && recordsByName.contains(dependency)) {
                    selectedNames.add(dependency)
                    selectedNameSet.add(dependency)
                }
            }
        }
        cursor += 1
    }

    let selected = ArrayList<SymbolRecord>()
    for (record in records) {
        if (selectedNameSet.contains(record.fullName)) {
            selected.add(record)
        }
    }
    return selected
}

func selectedNamespaces(symbols: ArrayList<SymbolRecord>): ArrayList<String> {
    let namespaces = ArrayList<String>()
    for (symbol in symbols) {
        addUnique(namespaces, symbol.namespace)
    }
    sortStrings(namespaces)
    return namespaces
}

func renderCjpmToml(packageName: String, supportDeps!: ArrayList<String> = ArrayList<String>()): String {
    var dependencyPrefix = "../.."
    if (packageName == "windows_common") {
        dependencyPrefix = ".."
    }
    let linkOptions = collectSupportLinkOptions(supportDeps)
    var content = "[package]\n" +
        "  name = \"${packageName}\"\n" +
        "  version = \"0.1.0\"\n" +
        "  description = \"Generated Windows API support symbols for Cangjie\"\n" +
        "  output-type = \"static\"\n" +
        "  cjc-version = \"1.1.0\"\n" +
        "  compile-option = \"-Woff unused\"\n"
    if (!linkOptions.isEmpty()) {
        content += "  link-option = \"${joinStrings(linkOptions, " ")}\"\n"
    }
    if (!supportDeps.isEmpty()) {
        content += "\n[dependencies]\n"
        content += renderStableDependencyLines(dependencyPrefix, supportDeps)
    }
    return content
}

func collectSupportLinkOptions(supportDeps: ArrayList<String>): ArrayList<String> {
    let options = ArrayList<String>()
    for (dependency in stableSupportDependencyNames()) {
        if (contains(supportDeps, dependency)) {
            for (option in stableSupportDependencyLinkOptions(dependency)) {
                addUnique(options, option)
            }
        }
    }
    return options
}

func stableSupportDependencyLinkOptions(dependency: String): Array<String> {
    match (dependency) {
        case "windows_collections" => return ["-lole32", "-loleaut32", "-lwindowsapp"]
        case "windows_core" => return []
        case "windows_future" => return ["-lole32", "-loleaut32", "-lwindowsapp"]
        case "windows_implement" => return ["-loleaut32", "-lwindowsapp"]
        case "windows_interface" => return ["-loleaut32", "-lwindowsapp"]
        case "windows_numerics" => return ["-ld2d1", "-lole32", "-loleaut32", "-lwindowsapp"]
        case "windows_result" => return []
        case _ => return []
    }
}

func renderStableDependencyLines(prefix: String, supportDeps: ArrayList<String>): String {
    var content = ""
    for (dependency in stableSupportDependencyNames()) {
        if (contains(supportDeps, dependency)) {
            content += "  ${dependency} = { path = \"${prefix}/${stableSupportDependencyPath(dependency)}\" }\n"
        }
    }
    return content
}

func renderSupportDependencyImports(packageName: String, supportDeps!: ArrayList<String> = ArrayList<String>()): String {
    var content = "package ${packageName}\n\n"
    for (dependency in stableSupportDependencyNames()) {
        if (contains(supportDeps, dependency)) {
            content += "import ${dependency} as ${dependency}\n"
        }
    }
    return content
}

func collectSupportDependencyNames(
    packageName: String,
    symbols: ArrayList<SymbolRecord>,
    symbolsByName: HashMap<String, SymbolRecord>
): ArrayList<String> {
    let dependencies = ArrayList<String>()
    for (symbol in symbols) {
        let source = renderImplSource(symbol, symbolsByName)
        collectSupportDependencyNamesFromSource(packageName, dependencies, source)
    }
    return dependencies
}

func collectSupportDependencyNamesFromSource(
    packageName: String,
    dependencies: ArrayList<String>,
    source: String
): Unit {
    for (dependency in stableSupportDependencyNames()) {
        if (dependency != packageName && source.contains("${dependency}.")) {
            addUnique(dependencies, dependency)
        }
    }
}

func stableSupportDependencyNames(): Array<String> {
    return [
        "windows_common",
        "windows_core",
        "windows_collections",
        "windows_future",
        "windows_implement",
        "windows_interface",
        "windows_libloading",
        "windows_numerics",
        "windows_polyfill",
        "windows_result",
        "windows_strings"
    ]
}

func stableSupportDependencyPath(dependency: String): String {
    match (dependency) {
        case "windows_common" => return "windows-common"
        case "windows_core" => return "windows-core"
        case "windows_collections" => return "windows-collections"
        case "windows_future" => return "windows-future"
        case "windows_implement" => return "windows-implement"
        case "windows_interface" => return "windows-interface"
        case "windows_libloading" => return "windows-libloading"
        case "windows_numerics" => return "windows-numerics"
        case "windows_polyfill" => return "windows-polyfill"
        case "windows_result" => return "windows-result"
        case "windows_strings" => return "windows-strings"
        case _ => return dependency
    }
}

func writeImplFiles(
    writer: GeneratedPackageWriter,
    symbols: ArrayList<SymbolRecord>,
    packageName: String,
    symbolsByName: HashMap<String, SymbolRecord>
): Unit {
    var chunkIndex: Int64 = 0
    var count: Int64 = 0
    var body = ""
    var importsPolyfill = false
    var importsCore = false
    var importsLibloading = false
    for (symbol in symbols) {
        let rendered = renderImplSource(symbol, symbolsByName)
        if (rendered.contains("windows_polyfill.")) {
            importsPolyfill = true
        }
        if (rendered.contains("windows_core.")) {
            importsCore = true
        }
        if (rendered.contains("windows_libloading.")) {
            importsLibloading = true
        }
        body += rendered
        body += "\n\n"
        count += 1
        if (count >= 512) {
            writer.writeFile("src/impl/symbols_${chunkIndex}.cj", renderImplChunk(packageName, body, importsPolyfill, importsCore, importsLibloading))
            chunkIndex += 1
            count = 0
            body = ""
            importsPolyfill = false
            importsCore = false
            importsLibloading = false
        }
    }
    if (count > 0) {
        writer.writeFile("src/impl/symbols_${chunkIndex}.cj", renderImplChunk(packageName, body, importsPolyfill, importsCore, importsLibloading))
    }
}

func renderImplChunk(
    packageName: String,
    body: String,
    importsPolyfill: Bool,
    importsCore: Bool,
    importsLibloading: Bool
): String {
    var content = "package ${packageName}.impl\n\n"
    if (importsCore) {
        content += "import windows_core as windows_core\n"
    }
    if (importsPolyfill) {
        content += "import windows_polyfill as windows_polyfill\n"
    }
    if (importsLibloading) {
        content += "import windows_libloading as windows_libloading\n"
    }
    if (importsCore || importsPolyfill || importsLibloading) {
        content += "\n"
    }
    content += body
    return content
}

func renderImplSource(symbol: SymbolRecord, symbolsByName: HashMap<String, SymbolRecord>): String {
    return renderSymbolImpl(symbol, symbolsByName)
}

func writeFacadeFiles(
    writer: GeneratedPackageWriter,
    namespace: String,
    symbols: ArrayList<SymbolRecord>,
    packageName: String
): Unit {
    let namespaceDir = namespaceToDirectory(namespace)
    var chunkIndex: Int64 = 0
    var count: Int64 = 0
    var importNames = ArrayList<String>()
    var aliases = ""
    for (symbol in symbols) {
        if (symbol.namespace == namespace) {
            addUnique(importNames, symbol.implName)
            aliases += "public type ${symbol.name} = ${symbol.implName}\n"
            match (symbol.typeDef) {
                case Some(typeDef) =>
                    if (isInterfaceType(typeDef)) {
                        match (guidAttributeLiteral(typeDef)) {
                            case Some(_) =>
                                addUnique(importNames, "${symbol.implName}Vtbl")
                                aliases += "public type ${symbol.name}Vtbl = ${symbol.implName}Vtbl\n"
                            case None => ()
                        }
                    }
                case None => ()
            }
            count += 1
            if (count >= 512) {
                writer.writeFile(
                    "${namespaceDir}/facade_${chunkIndex}.cj",
                    renderFacadeContent(namespace, packageName, importNames, aliases)
                )
                chunkIndex += 1
                count = 0
                importNames = ArrayList<String>()
                aliases = ""
            }
        }
    }
    if (count > 0) {
        writer.writeFile(
            "${namespaceDir}/facade_${chunkIndex}.cj",
            renderFacadeContent(namespace, packageName, importNames, aliases)
        )
    }
}

func renderFacadeContent(
    namespace: String,
    packageName: String,
    importNames: ArrayList<String>,
    aliases: String
): String {
    var content = "package ${namespaceToPackage(namespace, packageName)}\n\n"
    content += renderFacadeImplImports(packageName, importNames)
    content += "\n"
    content += aliases
    return content
}

func renderFacadeImplImports(packageName: String, importNames: ArrayList<String>): String {
    var content = ""
    var i: Int64 = 0
    while (i < Int64(importNames.size)) {
        let group = ArrayList<String>()
        var count: Int64 = 0
        while (count < 64 && i < Int64(importNames.size)) {
            group.add(importNames[i])
            i += 1
            count += 1
        }
        content += "import ${packageName}.impl.{${joinStrings(group, ", ")}}\n"
    }
    return content
}

func renderManifest(
    features: ArrayList<String>,
    symbols: ArrayList<SymbolRecord>,
    files: ArrayList<String>,
    packageName: String
): String {
    sortStrings(files)
    let names = ArrayList<String>()
    for (symbol in symbols) {
        names.add(symbol.fullName)
    }
    sortStrings(names)
    return "{\n" +
        "  \"generated_by\": \"${jsonEscape(GENERATED_FILE_MARKER)}\",\n" +
        "  \"package_name\": \"${jsonEscape(packageName)}\",\n" +
        "  \"requested_features\": ${jsonStringArray(features)},\n" +
        "  \"selected_symbols\": ${jsonStringArray(names)},\n" +
        "  \"files\": ${jsonStringArray(files)}\n" +
        "}\n"
}

func namespaceToPackage(namespace: String, packageName: String): String {
    let parts = namespacePartsWithoutRoot(namespace)
    if (parts.isEmpty()) {
        return packageName
    }
    return "${packageName}.${joinStrings(parts, ".")}"
}

func namespaceToRelativePath(namespace: String): String {
    return "${namespaceToDirectory(namespace)}/mod.cj"
}

func namespaceToDirectory(namespace: String): String {
    let parts = namespacePartsWithoutRoot(namespace)
    if (parts.isEmpty()) {
        return "src"
    }
    return "src/${joinStrings(parts, "/")}"
}

func writeIntermediateNamespaceModules(
    writer: GeneratedPackageWriter,
    namespaces: ArrayList<String>,
    packageName: String
): Unit {
    let written = ArrayList<String>()
    for (namespace in namespaces) {
        let parts = namespacePartsWithoutRoot(namespace)
        var count: Int64 = 1
        while (count < Int64(parts.size)) {
            let relativePath = "src/${joinFirstStrings(parts, count, "/")}/mod.cj"
            if (!contains(written, relativePath)) {
                writer.writeFile(relativePath, "package ${packageName}.${joinFirstStrings(parts, count, ".")}\n")
                written.add(relativePath)
            }
            count += 1
        }
    }
}

func namespacePartsWithoutRoot(namespace: String): ArrayList<String> {
    let parts = splitString(namespace, b'.')
    let result = ArrayList<String>()
    var i: Int64 = 0
    if (!parts.isEmpty() && parts[0] == "Windows") {
        i = 1
    }
    while (i < Int64(parts.size)) {
        result.add(parts[i])
        i += 1
    }
    return result
}

func printFeatures(records: ArrayList<SymbolRecord>): Unit {
    printUsage()
    println("")
    println("Available features:")
    println("  all")
    for (feature in featureNamesFromRecords(records)) {
        println("  ${feature}")
    }
}

func printUsage(): Unit {
    println("windows bindgen CLI")
    println("Usage: windows --input-json <winmd.json> [--input-json more.json] [--common] [--support-package-dir <dir>] --feature <namespace|all> [--out .generated/windows] [--clean] [--dry-run] [--print-link-options]")
}

func addUnique(values: ArrayList<String>, value: String): Unit {
    if (!contains(values, value)) {
        values.add(value)
    }
}

func contains(values: ArrayList<String>, value: String): Bool {
    for (item in values) {
        if (item == value) {
            return true
        }
    }
    return false
}

func startsWithString(value: String, prefix: String): Bool {
    let bytes = value.toArray()
    let prefixBytes = prefix.toArray()
    if (prefixBytes.size > bytes.size) {
        return false
    }
    var i: Int64 = 0
    while (i < Int64(prefixBytes.size)) {
        if (bytes[i] != prefixBytes[i]) {
            return false
        }
        i += 1
    }
    return true
}

func endsWithString(value: String, suffix: String): Bool {
    let bytes = value.toArray()
    let suffixBytes = suffix.toArray()
    if (suffixBytes.size > bytes.size) {
        return false
    }
    let start = Int64(bytes.size) - Int64(suffixBytes.size)
    var i: Int64 = 0
    while (i < Int64(suffixBytes.size)) {
        if (bytes[start + i] != suffixBytes[i]) {
            return false
        }
        i += 1
    }
    return true
}

func sortStrings(values: ArrayList<String>): Unit {
    var i: Int64 = 1
    while (i < Int64(values.size)) {
        let value = values[i]
        var j = i - 1
        while (j >= 0 && values[j] > value) {
            values[j + 1] = values[j]
            j -= 1
        }
        values[j + 1] = value
        i += 1
    }
}

func jsonStringArray(values: ArrayList<String>): String {
    var content = "["
    var first = true
    for (value in values) {
        if (!first) {
            content += ", "
        }
        content += "\"${jsonEscape(value)}\""
        first = false
    }
    content += "]"
    return content
}

func jsonEscape(value: String): String {
    let bytes = value.toArray()
    var result = ""
    for (byte in bytes) {
        if (byte == b'\\') {
            result += "\\\\"
        } else if (byte == b'"') {
            result += "\\\""
        } else if (byte == b'\n') {
            result += "\\n"
        } else if (byte == b'\r') {
            result += "\\r"
        } else {
            result += String.fromUtf8([byte])
        }
    }
    return result
}

func directoryOf(path: String): String {
    let bytes = path.toArray()
    var lastSep: Int64 = -1
    var i: Int64 = 0
    while (i < Int64(bytes.size)) {
        if (bytes[i] == b'/' || bytes[i] == b'\\') {
            lastSep = i
        }
        i += 1
    }
    if (lastSep >= 0) {
        return String.fromUtf8(bytes[0..lastSep])
    }
    return "."
}

func ensureDir(dirPath: String): Unit {
    if (dirPath == "." || dirPath.isEmpty()) {
        return
    }
    if (directoryExists(dirPath)) {
        return
    }
    Directory.create(dirPath, recursive: true)
}

func directoryExists(path: String): Bool {
    try {
        Directory.readFrom(path)
        return true
    } catch (_: Exception) {
        return false
    }
}

func splitString(value: String, sep: Byte): ArrayList<String> {
    let bytes = value.toArray()
    let result = ArrayList<String>()
    var start: Int64 = 0
    var i: Int64 = 0
    while (i < Int64(bytes.size)) {
        if (bytes[i] == sep) {
            if (i > start) {
                result.add(String.fromUtf8(bytes[start..i]))
            }
            start = i + 1
        }
        i += 1
    }
    if (start < Int64(bytes.size)) {
        result.add(String.fromUtf8(bytes[start..Int64(bytes.size)]))
    }
    return result
}

func joinStrings(values: ArrayList<String>, separator: String): String {
    var result = ""
    var first = true
    for (value in values) {
        if (!first) {
            result += separator
        }
        result += value
        first = false
    }
    return result
}

func joinFirstStrings(values: ArrayList<String>, count: Int64, separator: String): String {
    var result = ""
    var i: Int64 = 0
    while (i < count && i < Int64(values.size)) {
        if (i > 0) {
            result += separator
        }
        result += values[i]
        i += 1
    }
    return result
}
