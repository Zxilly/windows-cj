package windows

import std.collection.*
import std.fs.*
import stdx.crypto.digest.*
import stdx.encoding.hex.*

let GENERATED_FILE_MARKER = "Generated by windows-gen. DO NOT EDIT."

class CliConfig {
    public let features: ArrayList<String> = ArrayList<String>()
    public let filters: ArrayList<String> = ArrayList<String>()
    public let inputJsonPaths: ArrayList<String> = ArrayList<String>()
    public let inputJsonDirs: ArrayList<String> = ArrayList<String>()
    public let supportPackageDirs: ArrayList<String> = ArrayList<String>()
    public var outputDir: String = ".generated/windows"
    public var packageName: String = "windows_gen"
    public var manifestPath: String = ""
    public var clean: Bool = false
    public var dryRun: Bool = false
    public var listFeatures: Bool = false
    public var printLinkOptions: Bool = false
    public var help: Bool = false
    public var common: Bool = false
    public var sys: Bool = false
    public var implement: Bool = false
    public var noComment: Bool = false
    public let derives: ArrayList<String> = ArrayList<String>()
    public let referenceArgs: ArrayList<String> = ArrayList<String>()
}

public class BindgenConfig {
    public let features: Array<String>
    public let filters: Array<String>
    public let inputJsonPaths: Array<String>
    public let inputJsonDirs: Array<String>
    public let supportPackageDirs: Array<String>
    public let outputDir: String
    public let packageName: String
    public let manifestPath: String
    public let clean: Bool
    public let dryRun: Bool
    public let common: Bool
    public let sys: Bool
    public let implement: Bool
    public let noComment: Bool
    public let derives: Array<String>
    public let referenceArgs: Array<String>

    init(config: CliConfig) {
        this.features = copyStrings(config.features)
        this.filters = copyStrings(config.filters)
        this.inputJsonPaths = copyStrings(config.inputJsonPaths)
        this.inputJsonDirs = copyStrings(config.inputJsonDirs)
        this.supportPackageDirs = copyStrings(config.supportPackageDirs)
        this.outputDir = config.outputDir
        this.packageName = config.packageName
        this.manifestPath = config.manifestPath
        this.clean = config.clean
        this.dryRun = config.dryRun
        this.common = config.common
        this.sys = config.sys
        this.implement = config.implement
        this.noComment = config.noComment
        this.derives = copyStrings(config.derives)
        this.referenceArgs = copyStrings(config.referenceArgs)
    }
}

public class BindgenBuilder {
    private let config = CliConfig()

    public init() {}

    public func feature(value: String): BindgenBuilder {
        addUnique(config.features, value)
        return this
    }

    public func filter(value: String): BindgenBuilder {
        addUnique(config.filters, value)
        return this
    }

    public func inputJson(path: String): BindgenBuilder {
        addUnique(config.inputJsonPaths, path)
        return this
    }

    public func inputDir(path: String): BindgenBuilder {
        addUnique(config.inputJsonDirs, path)
        return this
    }

    public func supportPackageDir(path: String): BindgenBuilder {
        addUnique(config.supportPackageDirs, path)
        return this
    }

    public func outputDir(path: String): BindgenBuilder {
        config.outputDir = path
        return this
    }

    public func packageName(value: String): BindgenBuilder {
        config.packageName = value
        return this
    }

    public func manifest(path: String): BindgenBuilder {
        config.manifestPath = path
        return this
    }

    public func common(): BindgenBuilder {
        config.common = true
        config.packageName = "windows_common"
        if (config.outputDir == ".generated/windows") {
            config.outputDir = "windows-common"
        }
        return this
    }

    public func clean(): BindgenBuilder {
        config.clean = true
        return this
    }

    public func dryRun(): BindgenBuilder {
        config.dryRun = true
        return this
    }

    public func sys(): BindgenBuilder {
        config.sys = true
        return this
    }

    public func implement(): BindgenBuilder {
        config.implement = true
        return this
    }

    public func noComment(): BindgenBuilder {
        config.noComment = true
        return this
    }

    public func derive(value: String): BindgenBuilder {
        for (entry in splitString(value, b',')) {
            let trimmed = trimAscii(entry)
            if (!trimmed.isEmpty()) {
                addUnique(config.derives, trimmed)
            }
        }
        return this
    }

    public func reference(value: String): BindgenBuilder {
        addUnique(config.referenceArgs, value)
        return this
    }

    public func configSnapshot(): BindgenConfig {
        finalizeConfigDefaults(config)
        return BindgenConfig(config)
    }

    public func selectedSymbols(records: ArrayList<SymbolRecord>): ArrayList<SymbolRecord> {
        finalizeConfigDefaults(config)
        validateRequestedFeatures(config.features, records)
        validateRequestedFilters(config.filters, records)
        return selectedSymbolsForConfig(config, records)
    }

    public func linkOptions(records: ArrayList<SymbolRecord>): ArrayList<String> {
        finalizeConfigDefaults(config)
        return featureLinkOptions(config, records)
    }

    public func write(records: ArrayList<SymbolRecord>): Unit {
        finalizeConfigDefaults(config)
        generate(config, records)
    }

    public func loadAndWrite(): Unit {
        finalizeConfigDefaults(config)
        generate(config, loadSymbolRecords(config))
    }
}

class GeneratedPackageWriter {
    let outputDir: String
    let dryRun: Bool
    let noComment: Bool
    let writtenFiles: ArrayList<String> = ArrayList<String>()
    let writtenFileContent: HashMap<String, String> = HashMap<String, String>()

    public init(outputDir: String, dryRun: Bool) {
        this.outputDir = outputDir
        this.dryRun = dryRun
        this.noComment = false
    }

    public init(outputDir: String, dryRun: Bool, noComment!: Bool) {
        this.outputDir = outputDir
        this.dryRun = dryRun
        this.noComment = noComment
    }

    public func writeFile(relativePath: String, content: String): Unit {
        let rendered = if (noComment) {
            normalizeGeneratedFileContent(content)
        } else {
            normalizeGeneratedFileContent(addGeneratedFileHeader(relativePath, content))
        }
        match (writtenFileContent.get(relativePath)) {
            case Some(previous) =>
                if (previous != rendered) {
                    throw Exception("conflicting generated content for ${relativePath}")
                }
                return
            case None =>
                writtenFileContent.add(relativePath, rendered)
        }
        addUnique(writtenFiles, relativePath)
        if (dryRun) {
            return
        }
        let fullPath = "${outputDir}/${relativePath}"
        ensureDir(directoryOf(fullPath))
        File.writeTo(fullPath, rendered.toArray())
    }

    public func files(): ArrayList<String> {
        return writtenFiles
    }

    public func fileHashes(): HashMap<String, String> {
        let hashes = HashMap<String, String>()
        for (relativePath in writtenFiles) {
            match (writtenFileContent.get(relativePath)) {
                case Some(content) =>
                    hashes.add(relativePath, sha256Hex(content))
                case None =>
                    throw Exception("missing generated content for ${relativePath}")
            }
        }
        hashes
    }
}

func sha256Hex(content: String): String {
    let digest = SHA256()
    digest.write(content.toArray())
    toHexString(digest.finish())
}

func addGeneratedFileHeader(relativePath: String, content: String): String {
    let header = generatedFileHeader(relativePath)
    if (header.isEmpty() || startsWithString(content, header)) {
        return content
    }
    return header + content
}

func normalizeGeneratedFileContent(content: String): String {
    let bytes = content.toArray()
    var end = Int64(bytes.size)
    while (end > 0) {
        let byte = bytes[end - 1]
        if (byte != b'\n' && byte != b'\r' && byte != b' ' && byte != b'\t') {
            break
        }
        end -= 1
    }
    if (end == 0) {
        return "\n"
    }
    return String.fromUtf8(bytes[0..end]) + "\n"
}

func generatedFileHeader(relativePath: String): String {
    if (endsWithString(relativePath, ".cj")) {
        return "// ${GENERATED_FILE_MARKER}\n\n"
    }
    if (endsWithString(relativePath, ".toml")) {
        return "# ${GENERATED_FILE_MARKER}\n\n"
    }
    return ""
}

main(args: Array<String>): Int64 {
    try {
        let config = parseArgs(args)
        if (config.help) {
            printUsage()
            return 0
        }
        let records = loadSymbolRecords(config)
        if (config.listFeatures) {
            printFeatures(records)
            return 0
        }
        if (config.printLinkOptions) {
            printFeatureLinkOptions(config, records)
            return 0
        }
        generate(config, records)
        return 0
    } catch (err: Exception) {
        println("windows bindgen error: ${err}")
        return 1
    }
}

func parseArgs(args: Array<String>): CliConfig {
    let config = CliConfig()
    var i: Int64 = 0
    while (i < Int64(args.size)) {
        let arg = args[i]
        match (arg) {
            case "--feature" =>
                i += 1
                if (i >= Int64(args.size)) {
                    throw Exception("--feature requires a value")
                }
                addUnique(config.features, args[i])
            case "--filter" =>
                i += 1
                if (i >= Int64(args.size)) {
                    throw Exception("--filter requires a value")
                }
                addUnique(config.filters, args[i])
            case "--input-json" =>
                i += 1
                if (i >= Int64(args.size)) {
                    throw Exception("--input-json requires a value")
                }
                addUnique(config.inputJsonPaths, args[i])
            case "--input-dir" =>
                i += 1
                if (i >= Int64(args.size)) {
                    throw Exception("--input-dir requires a value")
                }
                addUnique(config.inputJsonDirs, args[i])
            case "--support-package-dir" =>
                i += 1
                if (i >= Int64(args.size)) {
                    throw Exception("--support-package-dir requires a value")
                }
                addUnique(config.supportPackageDirs, args[i])
            case "--out" =>
                i += 1
                if (i >= Int64(args.size)) {
                    throw Exception("--out requires a value")
                }
                config.outputDir = args[i]
            case "--manifest" =>
                i += 1
                if (i >= Int64(args.size)) {
                    throw Exception("--manifest requires a value")
                }
                config.manifestPath = args[i]
            case "--common" =>
                config.common = true
                config.packageName = "windows_common"
                if (config.outputDir == ".generated/windows") {
                    config.outputDir = "windows-common"
                }
            case "--clean" => config.clean = true
            case "--dry-run" => config.dryRun = true
            case "--list-features" => config.listFeatures = true
            case "--print-link-options" => config.printLinkOptions = true
            case "--print-link-option" => config.printLinkOptions = true
            case "--sys" => config.sys = true
            case "--implement" => config.implement = true
            case "--no-comment" => config.noComment = true
            case "--derive" =>
                i += 1
                if (i >= Int64(args.size)) {
                    throw Exception("--derive requires a value")
                }
                for (entry in splitString(args[i], b',')) {
                    let trimmed = trimAscii(entry)
                    if (!trimmed.isEmpty()) {
                        addUnique(config.derives, trimmed)
                    }
                }
            case "--reference" =>
                i += 1
                if (i >= Int64(args.size)) {
                    throw Exception("--reference requires a value")
                }
                addUnique(config.referenceArgs, args[i])
            case "--help" =>
                config.help = true
            case _ => throw Exception("unknown argument: ${arg}")
        }
        i += 1
    }
    finalizeConfigDefaults(config)
    return config
}

func finalizeConfigDefaults(config: CliConfig): Unit {
    if (config.common && config.supportPackageDirs.isEmpty()) {
        addUnique(config.supportPackageDirs, "windows-version")
        addUnique(config.supportPackageDirs, "windows-registry")
        addUnique(config.supportPackageDirs, "windows-threading")
        addUnique(config.supportPackageDirs, "windows-services")
        addUnique(config.supportPackageDirs, "windows-runtime")
        addUnique(config.supportPackageDirs, "windows-winui3")
    }
    if (config.features.isEmpty() && config.filters.isEmpty() && !config.common && !config.listFeatures && !config.help) {
        addUnique(config.features, "all")
    }
}

func loadSymbolRecords(config: CliConfig): ArrayList<SymbolRecord> {
    if (config.help) {
        return ArrayList<SymbolRecord>()
    }
    let winmdFiles = loadWinmdJsonFiles(expandedInputJsonPaths(config))
    return buildSymbolRecords(winmdFiles)
}

func expandedInputJsonPaths(config: CliConfig): ArrayList<String> {
    let paths = ArrayList<String>()
    for (path in config.inputJsonPaths) {
        addUnique(paths, path)
    }
    for (dir in config.inputJsonDirs) {
        let entries = Directory.readFrom(dir)
        let names = ArrayList<String>()
        for (entry in entries) {
            if (endsWithString(entry.name, ".json")) {
                names.add(entry.name)
            }
        }
        sortStrings(names)
        for (name in names) {
            addUnique(paths, "${dir}/${name}")
        }
    }
    return paths
}

func generate(config: CliConfig, records: ArrayList<SymbolRecord>): Unit {
    ensureCommonFeatureSelection(config)
    validateRequestedFeatures(config.features, records)
    validateRequestedFilters(config.filters, records)
    if (config.clean && !config.dryRun) {
        removeIfExists(config.outputDir, recursive: true)
    }

    let renderOptions = renderOptionsFromCliConfig(config)
    let selectionRules = requestedSelectionRules(config)
    let nativeSelected = selectSymbols(selectionRules, records)
    var selected = nativeSelected
    if (config.common) {
        selected = filterCommonSymbols(nativeSelected)
    }
    if (!renderOptions.references.isEmpty()) {
        selected = filterReferencedSymbols(selected, renderOptions.references)
    }
    let selectedByName = recordsByFullName(selected)
    let nativeSelectedByName = recordsByFullName(nativeSelected)
    let supportDeps = collectSupportDependencyNames(config.packageName, selected, selectedByName, renderOptions)
    addReferencePackagesToSupportDeps(supportDeps, renderOptions.references, config.packageName)
    let commonHelperFiles = ArrayList<GeneratedNativeHelperFile>()
    if (config.common) {
        for (file in commonNativeHelperFiles(nativeSelected, config.packageName, nativeSelectedByName)) {
            commonHelperFiles.add(file)
        }
        collectSupportDependencyNamesFromGeneratedNativeHelpers(config.packageName, supportDeps, commonHelperFiles)
    }
    let writer = GeneratedPackageWriter(config.outputDir, config.dryRun, noComment: renderOptions.noComment)
    writer.writeFile("cjpm.toml", renderCjpmToml(config.packageName, supportDeps: supportDeps))
    writer.writeFile("src/mod.cj", "package ${config.packageName}\n")
    if (!supportDeps.isEmpty()) {
        writer.writeFile("src/support_deps.cj", renderSupportDependencyImports(config.packageName, supportDeps: supportDeps))
    }
    if (config.common) {
        writeCommonNativeHelperFiles(writer, commonHelperFiles)
    }
    writer.writeFile("src/impl/mod.cj", "package ${config.packageName}.impl\n")
    writeImplFiles(writer, selected, config.packageName, selectedByName, renderOptions)
    let namespaces = selectedNamespaces(selected)
    writeIntermediateNamespaceModules(writer, namespaces, config.packageName)
    for (namespace in namespaces) {
        writer.writeFile(namespaceToRelativePath(namespace), "package ${namespaceToPackage(namespace, config.packageName)}\n")
        writeFacadeFiles(writer, namespace, selected, config.packageName)
    }

    let manifest = renderManifest(selectionRules, selected, writer.files(), writer.fileHashes(), config.packageName)
    if (!config.manifestPath.isEmpty()) {
        if (!config.dryRun) {
            ensureDir(directoryOf(config.manifestPath))
            File.writeTo(config.manifestPath, manifest.toArray())
        }
    } else {
        writer.writeFile("codegen-manifest.json", manifest)
    }
}

func renderOptionsFromCliConfig(config: CliConfig): RenderOptions {
    let options = RenderOptions()
    options.sys = config.sys
    options.implement = config.implement
    options.noComment = config.noComment
    options.ergonomicWrappers = !config.sys
    for (entry in config.derives) {
        options.derives.add(entry)
    }
    for (arg in config.referenceArgs) {
        options.references.add(ReferenceStage.parse(arg))
    }
    return options
}

func filterReferencedSymbols(
    symbols: ArrayList<SymbolRecord>,
    references: ArrayList<ReferenceStage>
): ArrayList<SymbolRecord> {
    let result = ArrayList<SymbolRecord>()
    for (symbol in symbols) {
        match (referenceContainsRecord(references, symbol)) {
            case Some(_) => ()
            case None => result.add(symbol)
        }
    }
    return result
}

func addReferencePackagesToSupportDeps(
    supportDeps: ArrayList<String>,
    references: ArrayList<ReferenceStage>,
    packageName: String
): Unit {
    for (stage in references) {
        if (stage.name != packageName) {
            addUnique(supportDeps, stage.name)
        }
    }
}

func ensureCommonFeatureSelection(config: CliConfig): Unit {
    if (config.common && config.features.isEmpty() && config.filters.isEmpty()) {
        for (feature in collectCommonFeatureNames(config.supportPackageDirs)) {
            addUnique(config.features, feature)
        }
        if (config.features.isEmpty()) {
            throw Exception("--common did not find support package imports; pass --feature or --support-package-dir")
        }
    }
}

func featureLinkOptions(config: CliConfig, records: ArrayList<SymbolRecord>): ArrayList<String> {
    ensureCommonFeatureSelection(config)
    validateRequestedFeatures(config.features, records)
    validateRequestedFilters(config.filters, records)
    let selected = selectedSymbolsForConfig(config, records)
    let selectedByName = recordsByFullName(selected)
    let supportDeps = collectSupportDependencyNames(config.packageName, selected, selectedByName)
    return collectSupportLinkOptions(supportDeps)
}

func printFeatureLinkOptions(config: CliConfig, records: ArrayList<SymbolRecord>): Unit {
    println(joinStrings(featureLinkOptions(config, records), " "))
}

func validateRequestedFeatures(features: ArrayList<String>, records: ArrayList<SymbolRecord>): Unit {
    if (contains(features, "all")) {
        return
    }
    let available = featureNamesFromRecords(records)
    let recordsByName = recordsByFullName(records)
    for (feature in features) {
        var found = false
        for (candidate in available) {
            if (candidate == feature) {
                found = true
                break
            }
        }
        if (!found && recordsByName.contains(feature)) {
            found = true
        }
        if (!found) {
            throw Exception("unknown feature: ${feature}")
        }
    }
}

func validateRequestedFilters(filters: ArrayList<String>, records: ArrayList<SymbolRecord>): Unit {
    for (filter in filters) {
        let pattern = selectionRulePattern(filter)
        if (pattern.isEmpty()) {
            throw Exception("empty filter rule: ${filter}")
        }
        if (pattern == "all") {
            continue
        }
        var found = false
        for (record in records) {
            if (selectionPatternMatchesRecord(pattern, record)) {
                found = true
                break
            }
        }
        if (!found) {
            throw Exception("unknown filter: ${filter}")
        }
    }
}

func requestedSelectionRules(config: CliConfig): ArrayList<String> {
    let rules = ArrayList<String>()
    for (feature in config.features) {
        addUnique(rules, feature)
    }
    for (filter in config.filters) {
        addUnique(rules, filter)
    }
    return rules
}

func selectSymbols(features: ArrayList<String>, records: ArrayList<SymbolRecord>): ArrayList<SymbolRecord> {
    return selectSymbolsFromRecords(features, records)
}

func selectedSymbolsForConfig(config: CliConfig, records: ArrayList<SymbolRecord>): ArrayList<SymbolRecord> {
    let selected = selectSymbols(requestedSelectionRules(config), records)
    if (config.common) {
        return filterCommonSymbols(selected)
    }
    return selected
}

func filterCommonSymbols(symbols: ArrayList<SymbolRecord>): ArrayList<SymbolRecord> {
    let filtered = ArrayList<SymbolRecord>()
    for (symbol in symbols) {
        match (symbol.typeDef) {
            case Some(typeDef) =>
                if (!hasPInvokeMethods(typeDef)) {
                    filtered.add(symbol)
                }
            case None => filtered.add(symbol)
        }
    }
    return filtered
}

func recordsByFullName(records: ArrayList<SymbolRecord>): HashMap<String, SymbolRecord> {
    let recordsByName = HashMap<String, SymbolRecord>()
    for (record in records) {
        recordsByName.add(record.fullName, record)
    }
    return recordsByName
}

func selectSymbolsFromRecords(features: ArrayList<String>, records: ArrayList<SymbolRecord>): ArrayList<SymbolRecord> {
    let selectedNames = ArrayList<String>()
    let selectedNameSet = HashSet<String>()
    let recordsByName = HashMap<String, SymbolRecord>()
    for (record in records) {
        recordsByName.add(record.fullName, record)
    }

    for (record in records) {
        if (selectionRulesIncludeRecord(features, record)) {
            if (!selectedNameSet.contains(record.fullName)) {
                selectedNames.add(record.fullName)
                selectedNameSet.add(record.fullName)
            }
        }
    }

    var cursor: Int64 = 0
    while (cursor < Int64(selectedNames.size)) {
        let fullName = selectedNames[cursor]
        if (recordsByName.contains(fullName)) {
            let record = recordsByName.get(fullName).getOrThrow()
            for (dependency in record.dependencies) {
                if (!selectedNameSet.contains(dependency) && recordsByName.contains(dependency)) {
                    let dependencyRecord = recordsByName.get(dependency).getOrThrow()
                    if (!selectionRulesExcludeRecord(features, dependencyRecord)) {
                        selectedNames.add(dependency)
                        selectedNameSet.add(dependency)
                    }
                }
            }
        }
        cursor += 1
    }

    let selected = ArrayList<SymbolRecord>()
    for (record in records) {
        if (selectedNameSet.contains(record.fullName)) {
            selected.add(record)
        }
    }
    return selected
}

func selectionRulesIncludeRecord(rules: ArrayList<String>, record: SymbolRecord): Bool {
    var included = false
    var excluded = false
    for (rule in rules) {
        if (selectionRuleMatchesRecord(rule, record)) {
            if (selectionRuleIsExclude(rule)) {
                excluded = true
            } else {
                included = true
            }
        }
    }
    return included && !excluded
}

func selectionRulesExcludeRecord(rules: ArrayList<String>, record: SymbolRecord): Bool {
    for (rule in rules) {
        if (selectionRuleIsExclude(rule) && selectionRuleMatchesRecord(rule, record)) {
            return true
        }
    }
    return false
}

func selectionRuleIsExclude(rule: String): Bool {
    return startsWithString(rule, "!")
}

func selectionRulePattern(rule: String): String {
    if (!selectionRuleIsExclude(rule)) {
        return rule
    }
    let bytes = rule.toArray()
    if (bytes.size <= 1) {
        return ""
    }
    return String.fromUtf8(bytes[1..Int64(bytes.size)])
}

func selectionRuleMatchesRecord(rule: String, record: SymbolRecord): Bool {
    return selectionPatternMatchesRecord(selectionRulePattern(rule), record)
}

func selectionPatternMatchesRecord(pattern: String, record: SymbolRecord): Bool {
    if (pattern == "all") {
        return true
    }
    if (stringContainsByte(pattern, b'*')) {
        return wildcardMatchesString(pattern, record.fullName) ||
            wildcardMatchesString(pattern, record.namespace) ||
            wildcardMatchesString(pattern, record.name)
    }
    if (record.fullName == pattern || record.name == pattern) {
        return true
    }
    return namespaceMatchesPrefix(record.namespace, pattern)
}

func namespaceMatchesPrefix(namespace: String, prefix: String): Bool {
    if (namespace == prefix) {
        return true
    }
    return startsWithString(namespace, "${prefix}.")
}

func wildcardMatchesString(pattern: String, value: String): Bool {
    return wildcardMatchesBytes(pattern.toArray(), 0, value.toArray(), 0)
}

func wildcardMatchesBytes(pattern: Array<Byte>, patternIndex: Int64, value: Array<Byte>, valueIndex: Int64): Bool {
    if (patternIndex == Int64(pattern.size)) {
        return valueIndex == Int64(value.size)
    }
    if (pattern[patternIndex] == b'*') {
        var nextPatternIndex = patternIndex
        while (nextPatternIndex < Int64(pattern.size) && pattern[nextPatternIndex] == b'*') {
            nextPatternIndex += 1
        }
        if (nextPatternIndex == Int64(pattern.size)) {
            return true
        }
        var nextValueIndex = valueIndex
        while (nextValueIndex <= Int64(value.size)) {
            if (wildcardMatchesBytes(pattern, nextPatternIndex, value, nextValueIndex)) {
                return true
            }
            nextValueIndex += 1
        }
        return false
    }
    if (valueIndex >= Int64(value.size)) {
        return false
    }
    if (pattern[patternIndex] != value[valueIndex]) {
        return false
    }
    return wildcardMatchesBytes(pattern, patternIndex + 1, value, valueIndex + 1)
}

func stringContainsByte(value: String, needle: Byte): Bool {
    for (byte in value.toArray()) {
        if (byte == needle) {
            return true
        }
    }
    return false
}

func selectedNamespaces(symbols: ArrayList<SymbolRecord>): ArrayList<String> {
    let namespaces = ArrayList<String>()
    for (symbol in symbols) {
        addUnique(namespaces, symbol.namespace)
    }
    sortStrings(namespaces)
    return namespaces
}

func renderCjpmToml(packageName: String, supportDeps!: ArrayList<String> = ArrayList<String>()): String {
    var dependencyPrefix = "../.."
    if (packageName == "windows_common") {
        dependencyPrefix = ".."
    }
    let effectiveSupportDeps = ArrayList<String>()
    for (dependency in supportDeps) {
        addUnique(effectiveSupportDeps, dependency)
    }
    if (packageName == "windows_common") {
        addUnique(effectiveSupportDeps, "windows_libloading")
    }
    let linkOptions = collectSupportLinkOptions(effectiveSupportDeps)
    var content = "[package]\n" +
        "  name = \"${packageName}\"\n" +
        "  version = \"0.1.0\"\n" +
        "  description = \"Generated Windows API support symbols for Cangjie\"\n" +
        "  output-type = \"static\"\n" +
        "  cjc-version = \"1.1.0\"\n" +
        "  compile-option = \"-Woff unused\"\n"
    if (!linkOptions.isEmpty()) {
        content += "  link-option = \"${joinStrings(linkOptions, " ")}\"\n"
    }
    if (!effectiveSupportDeps.isEmpty()) {
        content += "\n[dependencies]\n"
        content += renderStableDependencyLines(dependencyPrefix, effectiveSupportDeps)
    }
    return content
}

func collectSupportLinkOptions(supportDeps: ArrayList<String>): ArrayList<String> {
    let options = ArrayList<String>()
    for (dependency in stableSupportDependencyNames()) {
        if (contains(supportDeps, dependency)) {
            for (option in stableSupportDependencyLinkOptions(dependency)) {
                addUnique(options, option)
            }
        }
    }
    return options
}

func stableSupportDependencyLinkOptions(_: String): Array<String> {
    []
}

func renderStableDependencyLines(prefix: String, supportDeps: ArrayList<String>): String {
    var content = ""
    for (dependency in stableSupportDependencyNames()) {
        if (contains(supportDeps, dependency)) {
            content += "  ${dependency} = { path = \"${prefix}/${stableSupportDependencyPath(dependency)}\" }\n"
        }
    }
    return content
}

func renderSupportDependencyImports(packageName: String, supportDeps!: ArrayList<String> = ArrayList<String>()): String {
    var content = "package ${packageName}\n\n"
    for (dependency in stableSupportDependencyNames()) {
        if (contains(supportDeps, dependency)) {
            content += "import ${dependency} as ${dependency}\n"
        }
    }
    return content
}

func writeCommonNativeHelperFiles(
    writer: GeneratedPackageWriter,
    files: ArrayList<GeneratedNativeHelperFile>
): Unit {
    for (file in files) {
        writer.writeFile(file.relativePath, file.content)
    }
}

func collectSupportDependencyNamesFromGeneratedNativeHelpers(
    packageName: String,
    dependencies: ArrayList<String>,
    files: ArrayList<GeneratedNativeHelperFile>
): Unit {
    for (file in files) {
        collectSupportDependencyNamesFromSource(packageName, dependencies, file.content)
    }
}

func collectSupportDependencyNames(
    packageName: String,
    symbols: ArrayList<SymbolRecord>,
    symbolsByName: HashMap<String, SymbolRecord>
): ArrayList<String> {
    return collectSupportDependencyNames(packageName, symbols, symbolsByName, RenderOptions.defaults())
}

func collectSupportDependencyNames(
    packageName: String,
    symbols: ArrayList<SymbolRecord>,
    symbolsByName: HashMap<String, SymbolRecord>,
    options: RenderOptions
): ArrayList<String> {
    let dependencies = ArrayList<String>()
    for (symbol in symbols) {
        let source = renderImplSource(symbol, symbolsByName, options)
        collectSupportDependencyNamesFromSource(packageName, dependencies, source)
    }
    return dependencies
}

func collectSupportDependencyNamesFromSource(
    packageName: String,
    dependencies: ArrayList<String>,
    source: String
): Unit {
    if (source.contains("@Interface[")) {
        if (packageName != "windows_core") {
            addUnique(dependencies, "windows_core")
        }
        if (packageName != "windows_interface") {
            addUnique(dependencies, "windows_interface")
        }
    }
    for (dependency in stableSupportDependencyNames()) {
        if (dependency != packageName && source.contains("${dependency}.")) {
            addUnique(dependencies, dependency)
        }
    }
}

func stableSupportDependencyNames(): Array<String> {
    return [
        "windows_common",
        "windows_core",
        "windows_implement",
        "windows_interface",
        "windows_libloading",
        "windows_polyfill",
        "windows_result",
        "windows_runtime",
        "windows_strings"
    ]
}

func stableSupportDependencyPath(dependency: String): String {
    match (dependency) {
        case "windows_common" => return "windows-common"
        case "windows_core" => return "windows-core"
        case "windows_implement" => return "windows-implement"
        case "windows_interface" => return "windows-interface"
        case "windows_libloading" => return "windows-libloading"
        case "windows_polyfill" => return "windows-polyfill"
        case "windows_result" => return "windows-result"
        case "windows_runtime" => return "windows-runtime"
        case "windows_strings" => return "windows-strings"
        case _ => return dependency
    }
}

func writeImplFiles(
    writer: GeneratedPackageWriter,
    symbols: ArrayList<SymbolRecord>,
    packageName: String,
    symbolsByName: HashMap<String, SymbolRecord>
): Unit {
    writeImplFiles(writer, symbols, packageName, symbolsByName, RenderOptions.defaults())
}

func writeImplFiles(
    writer: GeneratedPackageWriter,
    symbols: ArrayList<SymbolRecord>,
    packageName: String,
    symbolsByName: HashMap<String, SymbolRecord>,
    options: RenderOptions
): Unit {
    var chunkIndex: Int64 = 0
    var count: Int64 = 0
    var body = ""
    var importsPolyfill = false
    var importsCore = false
    var importsLibloading = false
    var importsInterfacePackage = false
    var importsInterfaceGuid = false
    var importsInterfaceMacros = false
    var importsStrings = false
    for (symbol in symbols) {
        let rendered = renderImplSource(symbol, symbolsByName, options)
        if (rendered.contains("windows_polyfill.")) {
            importsPolyfill = true
        }
        if (rendered.contains("windows_core.")) {
            importsCore = true
        }
        if (rendered.contains("windows_libloading.")) {
            importsLibloading = true
        }
        if (rendered.contains("windows_interface.")) {
            importsInterfacePackage = true
        }
        if (implChunkNeedsGuidImport(rendered)) {
            importsInterfaceGuid = true
        }
        if (rendered.contains("@Interface[")) {
            importsInterfaceMacros = true
        }
        if (rendered.contains("windows_strings.")) {
            importsStrings = true
        }
        body += rendered
        body += "\n\n"
        count += 1
        if (count >= 512) {
            writer.writeFile("src/impl/symbols_${chunkIndex}.cj", renderImplChunk(packageName, body, importsPolyfill, importsCore, importsLibloading, importsInterfacePackage, importsInterfaceGuid, importsInterfaceMacros, importsStrings))
            chunkIndex += 1
            count = 0
            body = ""
            importsPolyfill = false
            importsCore = false
            importsLibloading = false
            importsInterfacePackage = false
            importsInterfaceGuid = false
            importsInterfaceMacros = false
            importsStrings = false
        }
    }
    if (count > 0) {
        writer.writeFile("src/impl/symbols_${chunkIndex}.cj", renderImplChunk(packageName, body, importsPolyfill, importsCore, importsLibloading, importsInterfacePackage, importsInterfaceGuid, importsInterfaceMacros, importsStrings))
    }
}

func implChunkNeedsGuidImport(rendered: String): Bool {
    rendered.contains(": GUID") ||
    rendered.contains("-> GUID") ||
    rendered.contains("<GUID") ||
    rendered.contains("GUID>") ||
    rendered.contains("VArray<GUID")
}

func renderImplChunk(
    packageName: String,
    body: String,
    importsPolyfill: Bool,
    importsCore: Bool,
    importsLibloading: Bool,
    importsInterfacePackage: Bool,
    importsInterfaceGuid: Bool,
    importsInterfaceMacros: Bool,
    importsStrings: Bool
): String {
    var content = "package ${packageName}.impl\n\n"
    if (importsCore || importsInterfaceMacros) {
        content += "import windows_core as windows_core\n"
    }
    if (importsInterfaceGuid) {
        content += "import windows_interface.GUID\n"
    }
    if (importsInterfacePackage || importsInterfaceMacros) {
        content += "import windows_interface as windows_interface\n"
    }
    if (importsInterfaceMacros) {
        content += "import windows_interface.IInspectable\n"
        content += "import windows_interface.macros.Interface\n"
    }
    if (importsPolyfill) {
        content += "import windows_polyfill as windows_polyfill\n"
    }
    if (importsLibloading) {
        content += "import windows_libloading as windows_libloading\n"
    }
    if (importsStrings) {
        content += "import windows_strings as windows_strings\n"
    }
    if (importsCore || importsPolyfill || importsLibloading || importsInterfacePackage ||
        importsInterfaceGuid || importsInterfaceMacros || importsStrings) {
        content += "\n"
    }
    content += body
    return content
}

func renderImplSource(symbol: SymbolRecord, symbolsByName: HashMap<String, SymbolRecord>): String {
    return renderSymbolImpl(symbol, symbolsByName, RenderOptions.defaults())
}

func renderImplSource(
    symbol: SymbolRecord,
    symbolsByName: HashMap<String, SymbolRecord>,
    options: RenderOptions
): String {
    return renderSymbolImpl(symbol, symbolsByName, options)
}

func writeFacadeFiles(
    writer: GeneratedPackageWriter,
    namespace: String,
    symbols: ArrayList<SymbolRecord>,
    packageName: String
): Unit {
    let namespaceDir = namespaceToDirectory(namespace)
    var chunkIndex: Int64 = 0
    var count: Int64 = 0
    var importNames = ArrayList<String>()
    var aliases = ""
    for (symbol in symbols) {
        if (symbol.namespace == namespace) {
            addUnique(importNames, symbol.implName)
            aliases += "public type ${symbol.name} = ${symbol.implName}\n"
            match (symbol.typeDef) {
                case Some(typeDef) =>
                    if (isInterfaceType(typeDef)) {
                        match (guidAttributeLiteral(typeDef)) {
                            case Some(_) =>
                                addUnique(importNames, "${symbol.implName}Vtbl")
                                aliases += "public type ${symbol.name}Vtbl = ${symbol.implName}Vtbl\n"
                            case None => ()
                        }
                    }
                case None => ()
            }
            count += 1
            if (count >= 512) {
                writer.writeFile(
                    "${namespaceDir}/facade_${chunkIndex}.cj",
                    renderFacadeContent(namespace, packageName, importNames, aliases)
                )
                chunkIndex += 1
                count = 0
                importNames = ArrayList<String>()
                aliases = ""
            }
        }
    }
    if (count > 0) {
        writer.writeFile(
            "${namespaceDir}/facade_${chunkIndex}.cj",
            renderFacadeContent(namespace, packageName, importNames, aliases)
        )
    }
}

func renderFacadeContent(
    namespace: String,
    packageName: String,
    importNames: ArrayList<String>,
    aliases: String
): String {
    var content = "package ${namespaceToPackage(namespace, packageName)}\n\n"
    content += renderFacadeImplImports(packageName, importNames)
    content += "\n"
    content += aliases
    return content
}

func renderFacadeImplImports(packageName: String, importNames: ArrayList<String>): String {
    var content = ""
    var i: Int64 = 0
    while (i < Int64(importNames.size)) {
        let group = ArrayList<String>()
        var count: Int64 = 0
        while (count < 64 && i < Int64(importNames.size)) {
            group.add(importNames[i])
            i += 1
            count += 1
        }
        content += "import ${packageName}.impl.{${joinStrings(group, ", ")}}\n"
    }
    return content
}

func renderManifest(
    features: ArrayList<String>,
    symbols: ArrayList<SymbolRecord>,
    files: ArrayList<String>,
    fileHashes: HashMap<String, String>,
    packageName: String
): String {
    sortStrings(files)
    let names = ArrayList<String>()
    for (symbol in symbols) {
        names.add(symbol.fullName)
    }
    sortStrings(names)
    return "{\n" +
        "  \"generated_by\": \"${jsonEscape(GENERATED_FILE_MARKER)}\",\n" +
        "  \"package_name\": \"${jsonEscape(packageName)}\",\n" +
        "  \"requested_features\": ${jsonStringArray(features)},\n" +
        "  \"selected_symbols\": ${jsonStringArray(names)},\n" +
        "  \"files\": ${jsonStringArray(files)},\n" +
        "  \"file_hashes\": ${jsonStringMap(files, fileHashes)}\n" +
        "}\n"
}

func jsonStringMap(keys: ArrayList<String>, values: HashMap<String, String>): String {
    if (keys.isEmpty()) {
        return "{}"
    }
    var content = "{\n"
    var index: Int64 = 0
    while (index < Int64(keys.size)) {
        let key = keys[index]
        let value = match (values.get(key)) {
            case Some(found) => found
            case None => throw Exception("missing JSON string map value for ${key}")
        }
        content += "    \"${jsonEscape(key)}\": \"${jsonEscape(value)}\""
        if (index + 1 < Int64(keys.size)) {
            content += ","
        }
        content += "\n"
        index += 1
    }
    content + "  }"
}

func namespaceToPackage(namespace: String, packageName: String): String {
    let parts = namespacePartsWithoutRoot(namespace)
    if (parts.isEmpty()) {
        return packageName
    }
    return "${packageName}.${joinStrings(parts, ".")}"
}

func namespaceToRelativePath(namespace: String): String {
    return "${namespaceToDirectory(namespace)}/mod.cj"
}

func namespaceToDirectory(namespace: String): String {
    let parts = namespacePartsWithoutRoot(namespace)
    if (parts.isEmpty()) {
        return "src"
    }
    return "src/${joinStrings(parts, "/")}"
}

func writeIntermediateNamespaceModules(
    writer: GeneratedPackageWriter,
    namespaces: ArrayList<String>,
    packageName: String
): Unit {
    let written = ArrayList<String>()
    for (namespace in namespaces) {
        let parts = namespacePartsWithoutRoot(namespace)
        var count: Int64 = 1
        while (count < Int64(parts.size)) {
            let relativePath = "src/${joinFirstStrings(parts, count, "/")}/mod.cj"
            if (!contains(written, relativePath)) {
                writer.writeFile(relativePath, "package ${packageName}.${joinFirstStrings(parts, count, ".")}\n")
                written.add(relativePath)
            }
            count += 1
        }
    }
}

func namespacePartsWithoutRoot(namespace: String): ArrayList<String> {
    let parts = splitString(namespace, b'.')
    let result = ArrayList<String>()
    var i: Int64 = 0
    if (!parts.isEmpty() && parts[0] == "Windows") {
        i = 1
    }
    while (i < Int64(parts.size)) {
        result.add(parts[i])
        i += 1
    }
    return result
}

func printFeatures(records: ArrayList<SymbolRecord>): Unit {
    printUsage()
    println("")
    println("Available features:")
    println("  all")
    for (feature in featureNamesFromRecords(records)) {
        println("  ${feature}")
    }
}

func printUsage(): Unit {
    println("windows bindgen CLI")
    println("Usage: windows --input-json <winmd.json> [--input-json more.json] [--input-dir <dir>] [--common]")
    println("               [--support-package-dir <dir>] [--feature <namespace|all>] [--filter <rule>]")
    println("               [--out .generated/windows] [--clean] [--dry-run] [--print-link-options]")
    println("               [--sys] [--implement] [--no-comment] [--derive <list>] [--reference <spec>]")
    println("")
    println("Flag detail:")
    println("  --sys             Generate raw sys-style bindings only (no ergonomic throws wrappers).")
    println("  --implement       Emit interface_Impl trait for @Implement consumers (WinRT interfaces).")
    println("  --no-comment      Suppress 'Generated by windows-gen. DO NOT EDIT.' file headers.")
    println("  --derive <list>   Comma-separated helper traits to emit (forward-compatible; currently no-op).")
    println("  --reference <s>   <pkg>,<style>,<namespace> — types matching are imported, not regenerated.")
    println("                    style is one of flat|full|skip-root.")
    println("")
    println("Skipped vs windows-rs (no Cangjie equivalent or already implicit):")
    println("  --rustfmt / --no-allow         Cangjie has no rustfmt or #[allow] equivalent.")
    println("  --no-deps / --no-toml          manifest.json + auto deps closure replace these.")
    println("  --link                         Cangjie resolves dlls via LoadLibrary at runtime.")
    println("  --sys-fn-ptrs / --sys-fn-extern  cjc has no raw-dylib; all PInvoke is dynamic dispatch.")
    println("  --package / --specific-deps    --common + auto support-deps closure cover this.")
    println("  --index                        Dependency closure auto-computed; no separate index file.")
}

func addUnique(values: ArrayList<String>, value: String): Unit {
    if (!contains(values, value)) {
        values.add(value)
    }
}

func copyStrings(values: ArrayList<String>): Array<String> {
    Array<String>(values.size, { index => values[index] })
}

func contains(values: ArrayList<String>, value: String): Bool {
    for (item in values) {
        if (item == value) {
            return true
        }
    }
    return false
}

func startsWithString(value: String, prefix: String): Bool {
    let bytes = value.toArray()
    let prefixBytes = prefix.toArray()
    if (prefixBytes.size > bytes.size) {
        return false
    }
    var i: Int64 = 0
    while (i < Int64(prefixBytes.size)) {
        if (bytes[i] != prefixBytes[i]) {
            return false
        }
        i += 1
    }
    return true
}

func endsWithString(value: String, suffix: String): Bool {
    let bytes = value.toArray()
    let suffixBytes = suffix.toArray()
    if (suffixBytes.size > bytes.size) {
        return false
    }
    let start = Int64(bytes.size) - Int64(suffixBytes.size)
    var i: Int64 = 0
    while (i < Int64(suffixBytes.size)) {
        if (bytes[start + i] != suffixBytes[i]) {
            return false
        }
        i += 1
    }
    return true
}

func sortStrings(values: ArrayList<String>): Unit {
    var i: Int64 = 1
    while (i < Int64(values.size)) {
        let value = values[i]
        var j = i - 1
        while (j >= 0 && values[j] > value) {
            values[j + 1] = values[j]
            j -= 1
        }
        values[j + 1] = value
        i += 1
    }
}

func jsonStringArray(values: ArrayList<String>): String {
    var content = "["
    var first = true
    for (value in values) {
        if (!first) {
            content += ", "
        }
        content += "\"${jsonEscape(value)}\""
        first = false
    }
    content += "]"
    return content
}

func jsonEscape(value: String): String {
    let bytes = value.toArray()
    var result = ""
    for (byte in bytes) {
        if (byte == b'\\') {
            result += "\\\\"
        } else if (byte == b'"') {
            result += "\\\""
        } else if (byte == b'\n') {
            result += "\\n"
        } else if (byte == b'\r') {
            result += "\\r"
        } else {
            result += String.fromUtf8([byte])
        }
    }
    return result
}

func directoryOf(path: String): String {
    let bytes = path.toArray()
    var lastSep: Int64 = -1
    var i: Int64 = 0
    while (i < Int64(bytes.size)) {
        if (bytes[i] == b'/' || bytes[i] == b'\\') {
            lastSep = i
        }
        i += 1
    }
    if (lastSep >= 0) {
        return String.fromUtf8(bytes[0..lastSep])
    }
    return "."
}

func ensureDir(dirPath: String): Unit {
    if (dirPath == "." || dirPath.isEmpty()) {
        return
    }
    if (directoryExists(dirPath)) {
        return
    }
    Directory.create(dirPath, recursive: true)
}

func directoryExists(path: String): Bool {
    try {
        Directory.readFrom(path)
        return true
    } catch (_: Exception) {
        return false
    }
}

func splitString(value: String, sep: Byte): ArrayList<String> {
    let bytes = value.toArray()
    let result = ArrayList<String>()
    var start: Int64 = 0
    var i: Int64 = 0
    while (i < Int64(bytes.size)) {
        if (bytes[i] == sep) {
            if (i > start) {
                result.add(String.fromUtf8(bytes[start..i]))
            }
            start = i + 1
        }
        i += 1
    }
    if (start < Int64(bytes.size)) {
        result.add(String.fromUtf8(bytes[start..Int64(bytes.size)]))
    }
    return result
}

func joinStrings(values: ArrayList<String>, separator: String): String {
    var result = ""
    var first = true
    for (value in values) {
        if (!first) {
            result += separator
        }
        result += value
        first = false
    }
    return result
}

func joinFirstStrings(values: ArrayList<String>, count: Int64, separator: String): String {
    var result = ""
    var i: Int64 = 0
    while (i < count && i < Int64(values.size)) {
        if (i > 0) {
            result += separator
        }
        result += values[i]
        i += 1
    }
    return result
}
