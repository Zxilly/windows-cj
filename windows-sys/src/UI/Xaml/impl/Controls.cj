@When[Windows_UI_Xaml_Controls == "on"]
@C
public struct WebViewExecutionMode {
    public var value: Int32 = 0

    public init() {}

    public init(value: Int32) {
        this.value = value
    }

    public operator func ==(other: WebViewExecutionMode): Bool {
        return this.value == other.value
    }
    public operator func !=(other: WebViewExecutionMode): Bool {
        return this.value != other.value
    }
}

