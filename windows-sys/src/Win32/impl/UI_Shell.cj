public struct QITIPF_FLAGS {
    public var value: Int32 = 0

    public init() {}

    public init(value: Int32) {
        this.value = value
    }

    public operator func ==(other: QITIPF_FLAGS): Bool {
        return this.value == other.value
    }
    public operator func !=(other: QITIPF_FLAGS): Bool {
        return this.value != other.value
    }

    public func contains(other: QITIPF_FLAGS): Bool {
        return (this.value & other.value) == other.value
    }

    public operator func |(other: QITIPF_FLAGS): QITIPF_FLAGS {
        return QITIPF_FLAGS(this.value | other.value)
    }
    public operator func &(other: QITIPF_FLAGS): QITIPF_FLAGS {
        return QITIPF_FLAGS(this.value & other.value)
    }
    public operator func !(): QITIPF_FLAGS {
        return QITIPF_FLAGS(!this.value)
    }
}

