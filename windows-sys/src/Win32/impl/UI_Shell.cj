public struct STORAGE_PROVIDER_FILE_FLAGS {
    public var value: Int32 = 0

    public init() {}

    public init(value: Int32) {
        this.value = value
    }

    public operator func ==(other: STORAGE_PROVIDER_FILE_FLAGS): Bool {
        return this.value == other.value
    }
    public operator func !=(other: STORAGE_PROVIDER_FILE_FLAGS): Bool {
        return this.value != other.value
    }

    public func contains(other: STORAGE_PROVIDER_FILE_FLAGS): Bool {
        return (this.value & other.value) == other.value
    }

    public operator func |(other: STORAGE_PROVIDER_FILE_FLAGS): STORAGE_PROVIDER_FILE_FLAGS {
        return STORAGE_PROVIDER_FILE_FLAGS(this.value | other.value)
    }
    public operator func &(other: STORAGE_PROVIDER_FILE_FLAGS): STORAGE_PROVIDER_FILE_FLAGS {
        return STORAGE_PROVIDER_FILE_FLAGS(this.value & other.value)
    }
    public operator func !(): STORAGE_PROVIDER_FILE_FLAGS {
        return STORAGE_PROVIDER_FILE_FLAGS(!this.value)
    }
}

