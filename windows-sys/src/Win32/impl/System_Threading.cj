public struct PROCESS_ACCESS_RIGHTS {
    public var value: UInt32 = 0

    public init() {}

    public init(value: UInt32) {
        this.value = value
    }

    public operator func ==(other: PROCESS_ACCESS_RIGHTS): Bool {
        return this.value == other.value
    }
    public operator func !=(other: PROCESS_ACCESS_RIGHTS): Bool {
        return this.value != other.value
    }

    public func contains(other: PROCESS_ACCESS_RIGHTS): Bool {
        return (this.value & other.value) == other.value
    }

    public operator func |(other: PROCESS_ACCESS_RIGHTS): PROCESS_ACCESS_RIGHTS {
        return PROCESS_ACCESS_RIGHTS(this.value | other.value)
    }
    public operator func &(other: PROCESS_ACCESS_RIGHTS): PROCESS_ACCESS_RIGHTS {
        return PROCESS_ACCESS_RIGHTS(this.value & other.value)
    }
    public operator func !(): PROCESS_ACCESS_RIGHTS {
        return PROCESS_ACCESS_RIGHTS(!this.value)
    }
}

