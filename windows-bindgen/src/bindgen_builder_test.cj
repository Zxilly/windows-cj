package windows_bindgen

import std.collection.*
import std.fs.*
import std.unittest.*
import std.unittest.testmacro.*

@Test
func testBindgenBuilderBuildsConfigSnapshot() {
    let config = BindgenBuilder()
        .inputJson("metadata.json")
        .inputDir("winmd-json")
        .supportPackageDir("windows-runtime")
        .filter("Widget")
        .filter("!Hidden")
        .outputDir("out")
        .packageName("windows_generated")
        .manifest("out/manifest.json")
        .clean()
        .dryRun()
        .configSnapshot()

    @Expect(config.features.isEmpty(), true)
    @Expect(config.filters.size, 2)
    @Expect(config.filters[0], "Widget")
    @Expect(config.filters[1], "!Hidden")
    @Expect(config.inputJsonPaths[0], "metadata.json")
    @Expect(config.inputJsonDirs[0], "winmd-json")
    @Expect(config.supportPackageDirs[0], "windows-runtime")
    @Expect(config.outputDir, "out")
    @Expect(config.packageName, "windows_generated")
    @Expect(config.manifestPath, "out/manifest.json")
    @Expect(config.clean, true)
    @Expect(config.dryRun, true)
}

@Test
func testBindgenBuilderDefaultsToAllWithoutExplicitSelection() {
    let config = BindgenBuilder().inputJson("metadata.json").configSnapshot()

    @Expect(config.features.size, 1)
    @Expect(config.features[0], "all")
}

@Test
func testBindgenBuilderCanSelectFromLoadedRecords() {
    let records = ArrayList<SymbolRecord>()
    records.add(SymbolRecord("Example.Foundation.Widget", "Example.Foundation", "Widget", "Example_Foundation_Widget", ["Example.Shared.Size"]))
    records.add(SymbolRecord("Example.Shared.Size", "Example.Shared", "Size", "Example_Shared_Size", []))
    records.add(SymbolRecord("Example.Controls.Button", "Example.Controls", "Button", "Example_Controls_Button", []))

    let selected = BindgenBuilder().filter("Widget").selectedSymbols(records)

    @Expect(cliTestContainsSymbol(selected, "Example.Foundation.Widget"), true)
    @Expect(cliTestContainsSymbol(selected, "Example.Shared.Size"), true)
    @Expect(cliTestContainsSymbol(selected, "Example.Controls.Button"), false)
}

@Test
func testRenderCjpmAndManifestArePackageAwareAndEscaped() {
    let symbols = ArrayList<SymbolRecord>()
    symbols.add(SymbolRecord("Example.Foundation.Widget", "Example.Foundation", "Widget", "Example_Foundation_Widget", []))
    let files = ArrayList<String>()
    files.add("src/z.cj")
    files.add("src/a.cj")
    let features = ArrayList<String>()
    features.add("Example.Foundation")
    let fileHashes = HashMap<String, String>()
    fileHashes.add("src/a.cj", "a-hash")
    fileHashes.add("src/z.cj", "z-hash")
    let manifest = renderManifest(features, symbols, files, fileHashes, "windows_common")

    @Expect(renderCjpmToml("windows_common").contains("name = \"windows_common\""), true)
    @Expect(renderCjpmToml("windows_common").contains("[dependencies]"), true)
    @Expect(manifest.contains("\"generated_by\": \"Generated by windows-bindgen. DO NOT EDIT.\""), true)
    @Expect(manifest.contains("\"package_name\": \"windows_common\""), true)
    @Expect(manifest.contains("\"files\": [\"src/a.cj\", \"src/z.cj\"]"), true)
    @Expect(manifest.contains("\"file_hashes\": {"), true)
    @Expect(manifest.contains("\"src/a.cj\": \"a-hash\""), true)
    @Expect(manifest.contains("\"src/z.cj\": \"z-hash\""), true)
    @Expect(jsonEscape("a\\b\"c\n"), "a\\\\b\\\"c\\n")
}

@Test
func testGeneratedPackageCjpmIncludesOnlyUsedSupportPackages() {
    let deps = ArrayList<String>()
    deps.add("windows_polyfill")
    let cjpm = renderCjpmToml("windows", supportDeps: deps)

    @Expect(cjpm.contains("name = \"windows\""), true)
    @Expect(cjpm.contains("link-option ="), false)
    @Expect(cjpm.contains("windows_polyfill = { path = \"../../windows-polyfill\" }"), true)
    @Expect(cjpm.contains("windows_common ="), false)
    @Expect(cjpm.contains("windows_core ="), false)
    @Expect(cjpm.contains("windows_interface ="), false)
    @Expect(cjpm.contains("windows_runtime"), false)
}

@Test
func testRawSlicePackageCjpmUsesGeneratedPackageDependencies() {
    let deps = ArrayList<String>()
    deps.add("windows_interface")
    deps.add("windows_libloading")
    deps.add("windows_polyfill")
    let cjpm = renderCjpmToml("raw_slice", supportDeps: deps)

    @Expect(cjpm.contains("name = \"raw_slice\""), true)
    @Expect(cjpm.contains("windows_interface = { path = \"../../windows-interface\" }"), true)
    @Expect(cjpm.contains("windows_libloading = { path = \"../../windows-libloading\" }"), true)
    @Expect(cjpm.contains("windows_polyfill = { path = \"../../windows-polyfill\" }"), true)
    @Expect(cjpm.contains("windows_interface = { path = \"../windows-interface\" }"), false)
}

@Test
func testRuntimeSupportDependencyReplacesSplitProjectionPackages() {
    let names = stableSupportDependencyNames()
    let deps = ArrayList<String>()
    deps.add("windows_runtime")
    let cjpm = renderCjpmToml("windows", supportDeps: deps)

    @Expect(cliTestContainsString(names, "windows_runtime"), true)
    @Expect(cliTestContainsString(names, "windows_collections"), false)
    @Expect(cliTestContainsString(names, "windows_future"), false)
    @Expect(cliTestContainsString(names, "windows_numerics"), false)
    @Expect(stableSupportDependencyPath("windows_runtime"), "windows-runtime")
    @Expect(cjpm.contains("windows_runtime = { path = \"../../windows-runtime\" }"), true)
    @Expect(cjpm.contains("link-option ="), false)
}

@Test
func testGeneratedPackageCjpmOmitsSupportLinkOptionsForDynamicNativeDeps() {
    let deps = ArrayList<String>()
    deps.add("windows_interface")
    deps.add("windows_implement")
    let cjpm = renderCjpmToml("windows", supportDeps: deps)

    @Expect(cjpm.contains("name = \"windows\""), true)
    @Expect(cjpm.contains("windows_interface = { path = \"../../windows-interface\" }"), true)
    @Expect(cjpm.contains("windows_implement = { path = \"../../windows-implement\" }"), true)
    @Expect(cjpm.contains("link-option ="), false)
}

@Test
func testCoreAndResultSupportDepsDoNotEmitStaticLinkOptions() {
    let deps = ArrayList<String>()
    deps.add("windows_core")
    deps.add("windows_result")
    let cjpm = renderCjpmToml("windows", supportDeps: deps)

    @Expect(cjpm.contains("windows_core = { path = \"../../windows-core\" }"), true)
    @Expect(cjpm.contains("windows_result = { path = \"../../windows-result\" }"), true)
    @Expect(cjpm.contains("link-option ="), false)
}

@Test
func testFeatureLinkOptionsUseSelectedFeatureDependencies() {
    let records = ArrayList<SymbolRecord>()
    records.add(SymbolRecord(
        "Example.Foundation.Widget",
        "Example.Foundation",
        "Widget",
        "Example_Foundation_Widget",
        [],
        implSource: "public func touchCore(): Unit { windows_core.IInspectable.runtimeName() }"
    ))
    records.add(SymbolRecord(
        "Example.Other.Vector",
        "Example.Other",
        "Vector",
        "Example_Other_Vector",
        [],
        implSource: "public func touchRuntime(): Unit { windows_runtime.DateTime() }"
    ))
    let config = parseArgs([
        "--input-json", "metadata.json",
        "--feature", "Example.Foundation",
        "--print-link-options"
    ])
    let options = featureLinkOptions(config, records)

    @Expect(cliTestContainsString(options.toArray(), "-lole32"), false)
    @Expect(cliTestContainsString(options.toArray(), "-loleaut32"), false)
    @Expect(cliTestContainsString(options.toArray(), "-lwindowsapp"), false)
    @Expect(cliTestContainsString(options.toArray(), "-ld2d1"), false)
}

@Test
func testRenderImplSourceUsesEmbeddedSourceBeforeFallback() {
    let embedded = SymbolRecord(
        "Example.Foundation.Widget",
        "Example.Foundation",
        "Widget",
        "Example_Foundation_Widget",
        [],
        implSource: "public struct Example_Foundation_Widget {\n    public var x: Int32 = 0\n}"
    )
    let fallback = SymbolRecord("Example.Foundation.Empty", "Example.Foundation", "Empty", "Example_Foundation_Empty", [])
    let map = HashMap<String, SymbolRecord>()
    map.add(embedded.fullName, embedded)
    map.add(fallback.fullName, fallback)

    @Expect(renderImplSource(embedded, map).contains("public var x: Int32 = 0"), true)
    @Expect(renderImplSource(fallback, map).contains("public init() {}"), true)
}

@Test
func testDryRunWriterTracksFilesWithoutCreatingThem() {
    let writer = GeneratedPackageWriter("__windows_cj_missing_dir__", true)
    writer.writeFile("src/mod.cj", "package windows\n")

    @Expect(writer.files().size, 1)
    @Expect(writer.files()[0], "src/mod.cj")
}

@Test
func testGeneratedWriterTracksEachFileOnce() {
    let writer = GeneratedPackageWriter("__windows_cj_missing_dir__", true)
    writer.writeFile("src/mod.cj", "package windows\n")
    writer.writeFile("src/mod.cj", "package windows\n")
    writer.writeFile("src/impl/mod.cj", "package windows.impl\n")

    @Expect(writer.files().size, 2)
    @Expect(writer.files()[0], "src/mod.cj")
    @Expect(writer.files()[1], "src/impl/mod.cj")
    @Expect(writer.fileHashes().contains("src/mod.cj"), true)
    @Expect(writer.fileHashes().contains("src/impl/mod.cj"), true)
}

@Test
func testGeneratedWriterRejectsConflictingDuplicateFile() {
    let writer = GeneratedPackageWriter("__windows_cj_missing_dir__", true)
    writer.writeFile("src/mod.cj", "package windows\n")

    @Expect(cliTestThrows({ => writer.writeFile("src/mod.cj", "package windows.impl\n") }), true)
}

@Test
func testGeneratedWriterAddsDoNotEditHeaders() {
    let outDir = ".generated/header-test"
    removeIfExists(outDir, recursive: true)
    let writer = GeneratedPackageWriter(outDir, false)
    writer.writeFile("src/mod.cj", "package windows\n")
    writer.writeFile("cjpm.toml", "[package]\n")
    writer.writeFile("codegen-manifest.json", "{}\n")

    let cj = String.fromUtf8(File.readFrom("${outDir}/src/mod.cj"))
    let toml = String.fromUtf8(File.readFrom("${outDir}/cjpm.toml"))
    let json = String.fromUtf8(File.readFrom("${outDir}/codegen-manifest.json"))
    removeIfExists(outDir, recursive: true)

    @Expect(startsWithString(cj, "// Generated by windows-bindgen. DO NOT EDIT.\n\npackage windows\n"), true)
    @Expect(startsWithString(toml, "# Generated by windows-bindgen. DO NOT EDIT.\n\n[package]\n"), true)
    @Expect(startsWithString(json, "{}\n"), true)
    @Expect(endsWithString(cj, "\n"), true)
    @Expect(endsWithString(cj, "\n\n"), false)
    @Expect(endsWithString(toml, "\n"), true)
    @Expect(endsWithString(toml, "\n\n"), false)
    @Expect(endsWithString(json, "\n"), true)
    @Expect(endsWithString(json, "\n\n"), false)
}

@Test
func testJsonInputBuildsSymbolsAndRendersValueStruct() {
    let json = ##"{
      "winmd_file": "Tiny.winmd",
      "winmd_sha256": "abcd",
      "tool_version": "1",
      "schema_version": "1",
      "source_set": "winmd_main",
      "types": [
        {
          "Namespace": "",
          "Name": "<Module>",
          "BaseType": null,
          "IsNested": false,
          "Attributes": [],
          "CustomAttributes": [],
          "Fields": [],
          "InterfaceImplementations": [],
          "Methods": [],
          "NestedTypes": [],
          "GenericParameters": [],
          "Events": [],
          "Properties": []
        },
        {
          "Namespace": "Tiny.Foundation",
          "Name": "POINT",
          "MetadataToken": "0x02000002",
          "BaseType": "System.ValueType",
          "IsNested": false,
          "Attributes": ["Public", "SequentialLayout", "Sealed"],
          "CustomAttributes": [],
          "Fields": [
            {
              "Name": "x",
              "Signature": {"Kind": "Primitive", "Name": "Int32"},
              "Attributes": ["Public"],
              "CustomAttributes": [],
              "DefaultValue": null
            }
          ],
          "InterfaceImplementations": [],
          "Methods": [],
          "NestedTypes": [],
          "GenericParameters": [],
          "Events": [],
          "Properties": []
        }
      ]
    }"##
    let files = ArrayList<WinmdFileRecord>()
    files.add(parseWinmdJson(json, "tiny"))
    let records = buildSymbolRecords(files)
    let symbolsByName = cliTestRecordsByName(records)

    @Expect(records.size, 1)
    @Expect(records[0].fullName, "Tiny.Foundation.POINT")
    @Expect(records[0].implName, "Tiny_Foundation_POINT")
    @Expect(featureNamesFromRecords(records)[0], "Tiny.Foundation")
    @Expect(renderSymbolImpl(records[0], symbolsByName).contains("@C\npublic struct Tiny_Foundation_POINT"), true)
    @Expect(renderSymbolImpl(records[0], symbolsByName).contains("public var x: Int32 = 0"), true)
}

@Test
func testRenderOptionsFromCliConfigDefaultsToErgonomicWrappers() {
    let config = parseArgs(["--input-json", "metadata.json", "--feature", "Example.Foundation"])
    let options = renderOptionsFromCliConfig(config)

    @Expect(options.ergonomicWrappers, true)
    @Expect(options.sys, false)
    @Expect(options.implement, false)
    @Expect(options.noComment, false)
}

@Test
func testRenderOptionsFromCliConfigSysDisablesErgonomicWrappers() {
    let config = parseArgs([
        "--input-json", "metadata.json",
        "--feature", "Example.Foundation",
        "--sys"
    ])
    let options = renderOptionsFromCliConfig(config)

    @Expect(options.sys, true)
    @Expect(options.ergonomicWrappers, false)
}

@Test
func testRenderEnumWithFlagsOpsDeriveEmitsExtendedHelpers() {
    let json = ##"{
      "winmd_file": "Sample.winmd",
      "winmd_sha256": "abcd",
      "tool_version": "1",
      "schema_version": "1",
      "source_set": "winmd_main",
      "types": [
        {
          "Namespace": "",
          "Name": "<Module>",
          "BaseType": null,
          "IsNested": false,
          "Attributes": [],
          "CustomAttributes": [],
          "Fields": [],
          "InterfaceImplementations": [],
          "Methods": [],
          "NestedTypes": [],
          "GenericParameters": [],
          "Events": [],
          "Properties": []
        },
        {
          "Namespace": "Sample.Foundation",
          "Name": "MyFlags",
          "BaseType": "System.Enum",
          "IsNested": false,
          "Attributes": ["Public", "SequentialLayout", "Sealed"],
          "CustomAttributes": [
            {"Type": "System.FlagsAttribute", "FixedArguments": [], "NamedArguments": []}
          ],
          "Fields": [
            {"Name": "value__", "Signature": {"Kind": "Primitive", "Name": "UInt32"}, "Attributes": ["Public", "SpecialName", "RuntimeSpecialName"], "CustomAttributes": [], "DefaultValue": null},
            {"Name": "A", "Signature": {"Kind": "Type", "Namespace": "Sample.Foundation", "Name": "MyFlags", "Comment": "TypeReference"}, "Attributes": ["Public", "Static", "Literal", "HasDefault"], "CustomAttributes": [], "DefaultValue": {"TypeCode": "UInt32", "Value": 1}}
          ],
          "InterfaceImplementations": [],
          "Methods": [],
          "NestedTypes": [],
          "GenericParameters": [],
          "Events": [],
          "Properties": []
        }
      ]
    }"##
    let files = ArrayList<WinmdFileRecord>()
    files.add(parseWinmdJson(json, "sample"))
    let records = buildSymbolRecords(files)
    let symbolsByName = cliTestRecordsByName(records)

    let optionsNoDerive = RenderOptions.defaults()
    var sourceNoDerive = ""
    for (record in records) {
        if (record.fullName == "Sample.Foundation.MyFlags") {
            sourceNoDerive = renderSymbolImpl(record, symbolsByName, optionsNoDerive)
        }
    }
    @Expect(sourceNoDerive.contains("public operator func |"), true)
    @Expect(sourceNoDerive.contains("public func toggle"), false)
    @Expect(sourceNoDerive.contains("public func intersect"), false)

    let optionsDerive = RenderOptions.defaults()
    optionsDerive.derives.add("flags_ops")
    var sourceDerive = ""
    for (record in records) {
        if (record.fullName == "Sample.Foundation.MyFlags") {
            sourceDerive = renderSymbolImpl(record, symbolsByName, optionsDerive)
        }
    }
    @Expect(sourceDerive.contains("public func toggle(other: Sample_Foundation_MyFlags): Sample_Foundation_MyFlags"), true)
    @Expect(sourceDerive.contains("public func intersect(other: Sample_Foundation_MyFlags): Sample_Foundation_MyFlags"), true)
    @Expect(sourceDerive.contains("public func union(other: Sample_Foundation_MyFlags): Sample_Foundation_MyFlags"), true)
    @Expect(sourceDerive.contains("public func difference(other: Sample_Foundation_MyFlags): Sample_Foundation_MyFlags"), true)
    @Expect(sourceDerive.contains("public func symmetric_difference(other: Sample_Foundation_MyFlags): Sample_Foundation_MyFlags"), true)
}

@Test
func testRenderStructWithGuidAccessDeriveEmitsStaticGuid() {
    let json = ##"{
      "winmd_file": "Sample.winmd",
      "winmd_sha256": "abcd",
      "tool_version": "1",
      "schema_version": "1",
      "source_set": "winmd_main",
      "types": [
        {
          "Namespace": "",
          "Name": "<Module>",
          "BaseType": null,
          "IsNested": false,
          "Attributes": [],
          "CustomAttributes": [],
          "Fields": [],
          "InterfaceImplementations": [],
          "Methods": [],
          "NestedTypes": [],
          "GenericParameters": [],
          "Events": [],
          "Properties": []
        },
        {
          "Namespace": "Sample.Foundation",
          "Name": "Tagged",
          "BaseType": "System.ValueType",
          "IsNested": false,
          "Attributes": ["Public", "SequentialLayout", "Sealed"],
          "CustomAttributes": [
            {
              "Type": "Windows.Win32.Foundation.Metadata.GuidAttribute",
              "FixedArguments": [
                {"Type": {"Kind": "Primitive", "Name": "UInt32"}, "Value": 1},
                {"Type": {"Kind": "Primitive", "Name": "UInt16"}, "Value": 2},
                {"Type": {"Kind": "Primitive", "Name": "UInt16"}, "Value": 3},
                {"Type": {"Kind": "Primitive", "Name": "Byte"}, "Value": 4},
                {"Type": {"Kind": "Primitive", "Name": "Byte"}, "Value": 5},
                {"Type": {"Kind": "Primitive", "Name": "Byte"}, "Value": 6},
                {"Type": {"Kind": "Primitive", "Name": "Byte"}, "Value": 7},
                {"Type": {"Kind": "Primitive", "Name": "Byte"}, "Value": 8},
                {"Type": {"Kind": "Primitive", "Name": "Byte"}, "Value": 9},
                {"Type": {"Kind": "Primitive", "Name": "Byte"}, "Value": 10},
                {"Type": {"Kind": "Primitive", "Name": "Byte"}, "Value": 11}
              ],
              "NamedArguments": []
            }
          ],
          "Fields": [
            {"Name": "Value", "Signature": {"Kind": "Primitive", "Name": "UInt32"}, "Attributes": ["Public"], "CustomAttributes": [], "DefaultValue": null}
          ],
          "InterfaceImplementations": [],
          "Methods": [],
          "NestedTypes": [],
          "GenericParameters": [],
          "Events": [],
          "Properties": []
        }
      ]
    }"##
    let files = ArrayList<WinmdFileRecord>()
    files.add(parseWinmdJson(json, "sample"))
    let records = buildSymbolRecords(files)
    let symbolsByName = cliTestRecordsByName(records)

    let optionsNoDerive = RenderOptions.defaults()
    var sourceNoDerive = ""
    for (record in records) {
        if (record.fullName == "Sample.Foundation.Tagged") {
            sourceNoDerive = renderSymbolImpl(record, symbolsByName, optionsNoDerive)
        }
    }
    @Expect(sourceNoDerive.contains("public static func GUID()"), false)

    let optionsDerive = RenderOptions.defaults()
    optionsDerive.derives.add("guid_access")
    var sourceDerive = ""
    for (record in records) {
        if (record.fullName == "Sample.Foundation.Tagged") {
            sourceDerive = renderSymbolImpl(record, symbolsByName, optionsDerive)
        }
    }
    @Expect(sourceDerive.contains("public static func GUID(): GUID {"), true)
    @Expect(sourceDerive.contains(
        "return GUID.from_values(1u32, 2u16, 3u16, 4u8, 5u8, 6u8, 7u8, 8u8, 9u8, 10u8, 11u8)"
    ), true)
}

@Test
func testRenderOptionsDefaultsDoNotEmitErgonomicWrappers() {
    let json = ##"{
      "winmd_file": "Tiny.winmd",
      "winmd_sha256": "abcd",
      "tool_version": "1",
      "schema_version": "1",
      "source_set": "winmd_main",
      "types": [
        {
          "Namespace": "",
          "Name": "<Module>",
          "BaseType": null,
          "IsNested": false,
          "Attributes": [],
          "CustomAttributes": [],
          "Fields": [],
          "InterfaceImplementations": [],
          "Methods": [],
          "NestedTypes": [],
          "GenericParameters": [],
          "Events": [],
          "Properties": []
        },
        {
          "Namespace": "Example.Sys",
          "Name": "Apis",
          "BaseType": null,
          "IsNested": false,
          "Attributes": ["Public", "Class"],
          "CustomAttributes": [],
          "Fields": [],
          "InterfaceImplementations": [],
          "Methods": [
            {
              "Name": "CoInitializeEx",
              "Attributes": ["Public", "Static", "PinvokeImpl"],
              "CustomAttributes": [],
              "ImplAttributes": ["IL", "Managed"],
              "RelativeVirtualAddress": 0,
              "Import": {
                "Name": "CoInitializeEx",
                "Attributes": ["ExactSpelling", "CallingConventionWinApi"],
                "Module": {"Name": "ole32.dll", "CustomAttributes": []}
              },
              "Signature": {
                "ReturnType": {"Kind": "Type", "Namespace": "Windows.Win32.Foundation", "Name": "HRESULT", "Comment": "TypeReference"},
                "ParameterTypes": [
                  {"Kind": "Pointer", "Type": {"Kind": "Primitive", "Name": "Void"}}
                ],
                "RequiredParameterCount": 1
              },
              "Parameters": [
                {"Name": "reserved", "SequenceNumber": 1, "Attributes": ["In"], "CustomAttributes": []}
              ],
              "GenericParameters": []
            }
          ],
          "NestedTypes": [],
          "GenericParameters": [],
          "Events": [],
          "Properties": []
        }
      ]
    }"##
    let files = ArrayList<WinmdFileRecord>()
    files.add(parseWinmdJson(json, "tiny"))
    let records = buildSymbolRecords(files)
    let symbolsByName = cliTestRecordsByName(records)
    var source = ""
    for (record in records) {
        if (record.fullName == "Example.Sys.Apis") {
            source = renderSymbolImpl(record, symbolsByName)
        }
    }

    @Expect(source.contains("public static func CoInitializeEx("), true)
    @Expect(source.contains("CoInitializeExChecked"), false)
}

