    }"##
    let files = ArrayList<WinmdFileRecord>()
    files.add(parseWinmdJson(json, "tiny"))
    let records = buildSymbolRecords(files)
    let symbolsByName = cliTestRecordsByName(records)
    let defaultOptions = RenderOptions.defaults()
    let withImpl = RenderOptions()
    withImpl.implement = true

    let defaultSource = renderSymbolImpl(records[0], symbolsByName, defaultOptions)
    let implSource = renderSymbolImpl(records[0], symbolsByName, withImpl)

    @Expect(defaultSource.contains("public interface Example_Impl_IThing"), true)
    @Expect(defaultSource.contains("Example_Impl_IThing_Impl"), false)

    @Expect(implSource.contains("public interface Example_Impl_IThing"), true)
    @Expect(implSource.contains("public interface Example_Impl_IThing_Impl {"), true)
    @Expect(implSource.contains("    func Ping(): Int32"), true)
}

@Test
func testWriteImplFilesAddsReferenceImportWhenSymbolIsRemapped() {
    let json = ##"{
      "winmd_file": "Sample.winmd",
      "winmd_sha256": "abcd",
      "tool_version": "1",
      "schema_version": "1",
      "source_set": "winmd_main",
      "types": [
        {
          "Namespace": "",
          "Name": "<Module>",
          "BaseType": null,
          "IsNested": false,
          "Attributes": [],
          "CustomAttributes": [],
          "Fields": [],
          "InterfaceImplementations": [],
          "Methods": [],
          "NestedTypes": [],
          "GenericParameters": [],
          "Events": [],
          "Properties": []
        },
        {
          "Namespace": "Example.LocalNs",
          "Name": "Holder",
          "MetadataToken": "0x02000002",
          "BaseType": "System.ValueType",
          "IsNested": false,
          "Attributes": ["Public", "SequentialLayout", "Sealed"],
          "CustomAttributes": [],
          "Fields": [
            {
              "Name": "extern_handle",
              "Signature": {"Kind": "Type", "Namespace": "Example.RefNs", "Name": "RefHandle", "Comment": "TypeReference"},
              "Attributes": ["Public"],
              "CustomAttributes": [],
              "DefaultValue": null
            }
          ],
          "InterfaceImplementations": [],
          "Methods": [],
          "NestedTypes": [],
          "GenericParameters": [],
          "Events": [],
          "Properties": []
        }
      ]
    }"##
    let files = ArrayList<WinmdFileRecord>()
    files.add(parseWinmdJson(json, "sample"))
    let records = buildSymbolRecords(files)
    let symbolsByName = cliTestRecordsByName(records)

    let options = RenderOptions.defaults()
    options.references.add(ReferenceStage.parse("windows_refpkg,full,Example.RefNs"))

    let outDir = ".generated/ref-remap-test"
    removeIfExists(outDir, recursive: true)
    let writer = GeneratedPackageWriter(outDir, false)
    writeImplFiles(writer, records, "windows_local", symbolsByName, options)
    let content = String.fromUtf8(File.readFrom("${outDir}/src/impl/symbols_0.cj"))
    removeIfExists(outDir, recursive: true)

    @Expect(content.contains("import windows_refpkg as windows_refpkg"), true)
    @Expect(content.contains("public var extern_handle: windows_refpkg.Example_RefNs_RefHandle"), true)
}

@Test
func testImplementOptionDoesNotRouteWin32ComThroughWinrtInterfaceMacro() {
    let json = ##"{
      "winmd_file": "Tiny.winmd",
      "winmd_sha256": "abcd",
      "tool_version": "1",
      "schema_version": "1",
      "source_set": "winmd_main",
      "types": [
        {
          "Namespace": "",
          "Name": "<Module>",
          "BaseType": null,
          "IsNested": false,
          "Attributes": [],
          "CustomAttributes": [],
          "Fields": [],
          "InterfaceImplementations": [],
          "Methods": [],
          "NestedTypes": [],
          "GenericParameters": [],
          "Events": [],
          "Properties": []
        },
        {
          "Namespace": "Example.Win32.System.Com",
          "Name": "IClassFactory",
          "MetadataToken": "0x02000002",
          "BaseType": null,
          "IsNested": false,
          "Attributes": ["Public", "AutoLayout", "Interface", "Abstract", "AnsiClass"],
          "CustomAttributes": [
            {
              "Type": "Windows.Win32.Foundation.Metadata.GuidAttribute",
              "FixedArguments": [
                {"Type": {"Kind": "Primitive", "Name": "UInt32"}, "Value": 1},
                {"Type": {"Kind": "Primitive", "Name": "UInt16"}, "Value": 0},
                {"Type": {"Kind": "Primitive", "Name": "UInt16"}, "Value": 0},
                {"Type": {"Kind": "Primitive", "Name": "Byte"}, "Value": 192},
                {"Type": {"Kind": "Primitive", "Name": "Byte"}, "Value": 0},
                {"Type": {"Kind": "Primitive", "Name": "Byte"}, "Value": 0},
                {"Type": {"Kind": "Primitive", "Name": "Byte"}, "Value": 0},
                {"Type": {"Kind": "Primitive", "Name": "Byte"}, "Value": 0},
                {"Type": {"Kind": "Primitive", "Name": "Byte"}, "Value": 0},
                {"Type": {"Kind": "Primitive", "Name": "Byte"}, "Value": 0},
                {"Type": {"Kind": "Primitive", "Name": "Byte"}, "Value": 70}
              ],
              "NamedArguments": []
            }
          ],
          "Fields": [],
          "InterfaceImplementations": [],
          "Methods": [
            {
              "Name": "CreateInstance",
              "Attributes": ["Public", "Virtual", "NewSlot", "Abstract"],
              "CustomAttributes": [],
              "ImplAttributes": ["IL", "Managed"],
              "RelativeVirtualAddress": 0,
              "Import": null,
              "Signature": {
                "GenericParameterCount": 0,
                "Header": {"Attributes": ["Instance"], "CallingConvention": "Default", "HasExplicitThis": false, "IsGeneric": false, "IsInstance": true, "Kind": "Method"},
                "ParameterTypes": [],
                "RequiredParameterCount": 0,
                "ReturnType": {"Kind": "Primitive", "Name": "Int32"}
              },
              "Parameters": [],
              "GenericParameters": []
            }
          ],
          "NestedTypes": [],
          "GenericParameters": [],
          "Events": [],
          "Properties": []
        }
      ]
    }"##
    let files = ArrayList<WinmdFileRecord>()
    files.add(parseWinmdJson(json, "tiny"))
    let records = buildSymbolRecords(files)
    let symbolsByName = cliTestRecordsByName(records)
    let defaultOptions = RenderOptions.defaults()
    let withImpl = RenderOptions()
    withImpl.implement = true

    var defaultSource = ""
    var implSource = ""
    for (record in records) {
        if (record.fullName == "Example.Win32.System.Com.IClassFactory") {
            defaultSource = renderSymbolImpl(record, symbolsByName, defaultOptions)
            implSource = renderSymbolImpl(record, symbolsByName, withImpl)
        }
    }

    @Expect(defaultSource.contains("@Interface["), false)
    @Expect(defaultSource.contains("public class Example_Win32_System_Com_IClassFactory"), true)
    @Expect(defaultSource.contains("Example_Win32_System_Com_IClassFactory_Impl"), false)

    @Expect(implSource.contains("@Interface["), false)
    @Expect(implSource.contains("public class Example_Win32_System_Com_IClassFactory"), true)
    @Expect(implSource.contains("Example_Win32_System_Com_IClassFactory_Impl"), false)
}

@Test
func testNoCommentWriterSkipsGeneratedFileHeader() {
    let outDir = ".generated/no-comment-test"
    removeIfExists(outDir, recursive: true)
    let noCommentWriter = GeneratedPackageWriter(outDir, false, noComment: true)
    noCommentWriter.writeFile("src/sample.cj", "package sample\n")
    let written = String.fromUtf8(File.readFrom("${outDir}/src/sample.cj"))
    removeIfExists(outDir, recursive: true)

    @Expect(written.contains(GENERATED_FILE_MARKER), false)
    @Expect(written.contains("package sample"), true)

    let outDir2 = ".generated/with-comment-test"
    removeIfExists(outDir2, recursive: true)
    let normalWriter = GeneratedPackageWriter(outDir2, false)
    normalWriter.writeFile("src/sample.cj", "package sample\n")
    let withComment = String.fromUtf8(File.readFrom("${outDir2}/src/sample.cj"))
    removeIfExists(outDir2, recursive: true)

    @Expect(withComment.contains(GENERATED_FILE_MARKER), true)
}
