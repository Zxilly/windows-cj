@When[Microsoft_UI_Xaml_Media_Animation == "on" && Windows_Foundation_Collections == "on"]
extend TransitionCollection <: windows_core.HandleWinrtType<TransitionCollection> {
    public static func intoWinrtHandle(value: TransitionCollection): CPointer<Unit> {
        value.asRaw()
    }

    public static func fromAbiTakeWinrtHandle(raw: CPointer<Unit>): TransitionCollection {
        if (raw.isNull()) {
            throw windows_core.WindowsException(windows_core.E_POINTER)
