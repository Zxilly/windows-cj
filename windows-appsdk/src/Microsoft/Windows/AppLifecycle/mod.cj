    public unsafe func FindOrRegisterForKey(key: windows_core.HString): AppInstance {
        let v = vtbl()
        var result__ = CPointer<Unit>()
        let hr = v.FindOrRegisterForKey(asRaw(), key.asRaw(), CPointer<CPointer<Unit>>(inout result__))
        HRESULT(hr).ok()
        return AppInstance.fromAbiTake(result__)
    }
}

@When[Microsoft_Windows_AppLifecycle == "on"]
extend IAppInstanceStatics <: windows_core.Interface<IAppInstanceStatics> {}
