extend TextRecognizer <: windows_core.HandleWinrtType<TextRecognizer> {
    public static func intoWinrtHandle(value: TextRecognizer): CPointer<Unit> {
        value.asRaw()
    }

    public static func fromAbiTakeWinrtHandle(raw: CPointer<Unit>): TextRecognizer {
        if (raw.isNull()) {
            throw windows_core.WindowsException(windows_core.E_POINTER)
        }
        TextRecognizer.fromAbiTake(raw)
    }

    public static func viewWinrtHandle(raw: CPointer<Unit>): TextRecognizer {
        TextRecognizer.viewOf(raw)
    }
}
