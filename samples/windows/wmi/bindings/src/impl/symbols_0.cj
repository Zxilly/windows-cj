    public static func BstrFromVectorChecked(psa: CPointer<Unit>, pbstr: CPointer<CPointer<Unit>>): Unit {
        if (pbstr.isNull()) {
            throw windows_core.WindowsException(windows_core.E_POINTER)
        }
        unsafe { pbstr.write(CPointer<Unit>()) }
        let hr__ = Windows_Win32_System_Ole_Apis.BstrFromVector(psa, pbstr)
        let resultHr__ = windows_core.HRESULT(hr__)
        if (resultHr__.failed()) {
            if (pbstr.isNotNull()) {
                let failedString__ = unsafe { pbstr.read() }
                if (failedString__.isNotNull()) {
                    let failedBstr__ = windows_strings.BSTR.fromRawTake(CPointer<UInt16>(failedString__))
                    failedBstr__.close()
                    unsafe { pbstr.write(CPointer<Unit>()) }
                }
            }
        }
        resultHr__.check()
    }
