    public static func AssocCreateForClassesChecked<T>(rgClasses: CPointer<Unit>, cClasses: UInt32, descriptor: windows_interface.InterfaceDescriptor<T>): T where T <: windows_interface.ComInterface {
        var iid__ = descriptor.iid
        var raw__: CPointer<Unit> = CPointer<Unit>()
        let hr__ = Windows_Win32_UI_Shell_Apis.AssocCreateForClasses(rgClasses, cClasses, unsafe { CPointer<Unit>(CPointer<windows_interface.GUID>(inout iid__)) }, unsafe { CPointer<Unit>(CPointer<CPointer<Unit>>(inout raw__)) })
        let resultHr__ = windows_core.HRESULT(hr__)
        if (resultHr__.failed() && raw__.isNotNull()) {
            let _ = descriptor.releasePointer(raw__)
            raw__ = CPointer<Unit>()
        }
        resultHr__.check()
        if (raw__.isNull()) {
            throw windows_core.WindowsException(windows_core.E_POINTER)
        }
        return descriptor.takeFromAbi(raw__)
    }
