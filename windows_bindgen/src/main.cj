package windows_bindgen

import std.collection.*
import std.env.*
import std.fs.*
import std.time.*
import stdx.crypto.digest.*
import stdx.encoding.hex.*

let GENERATED_FILE_MARKER = "Generated by windows_bindgen. DO NOT EDIT."

// Env-gated phase timing. When WINDOWS_CJ_BENCH=1 is set the CLI prints
// monotonic-clock phase durations (load vs generate) to stderr so the bench
// harness can attribute end-to-end time without external instrumentation.
var benchEnabledCache: Option<Bool> = None

func benchEnabled(): Bool {
    match (benchEnabledCache) {
        case Some(v) => return v
        case None => ()
    }
    var enabled = false
    try {
        for ((key, value) in getVariables()) {
            if (key == "WINDOWS_CJ_BENCH" && (value == "1" || value == "true")) {
                enabled = true
                break
            }
        }
    } catch (_: Exception) {
        enabled = false
    }
    benchEnabledCache = Some(enabled)
    return enabled
}

func benchMark(label: String, start: MonoTime): Unit {
    if (!benchEnabled()) {
        return
    }
    let ns = (MonoTime.now() - start).toNanoseconds()
    let ms = ns / 1_000_000
    eprintln("[bench] ${label}: ${ms} ms")
}

class CliConfig {
    public let features: ArrayList<String> = ArrayList<String>()
    public let filters: ArrayList<String> = ArrayList<String>()
    public let inputJsonPaths: ArrayList<String> = ArrayList<String>()
    public let inputJsonDirs: ArrayList<String> = ArrayList<String>()
    public let inputWinmdPaths: ArrayList<String> = ArrayList<String>()
    public let inputWinmdDirs: ArrayList<String> = ArrayList<String>()
    public let supportPackageDirs: ArrayList<String> = ArrayList<String>()
    public var outputDir: String = ".generated/windows"
    public var packageName: String = "windows"
    public var manifestPath: String = ""
    public var clean: Bool = false
    public var dryRun: Bool = false
    public var listFeatures: Bool = false
    public var printLinkOptions: Bool = false
    public var help: Bool = false
    public var common: Bool = false
    public var sys: Bool = false
    public var implement: Bool = false
    public var noComment: Bool = false
    public var flat: Bool = false
    public var minimal: Bool = false
    public var defaultWinmdInput: Bool = false
    public let derives: ArrayList<String> = ArrayList<String>()
    public let referenceArgs: ArrayList<String> = ArrayList<String>()
}

public class BindgenConfig {
    public let features: Array<String>
    public let filters: Array<String>
    public let inputJsonPaths: Array<String>
    public let inputJsonDirs: Array<String>
    public let inputWinmdPaths: Array<String>
    public let inputWinmdDirs: Array<String>
    public let defaultWinmdInput: Bool
    public let supportPackageDirs: Array<String>
    public let outputDir: String
    public let packageName: String
    public let manifestPath: String
    public let clean: Bool
    public let dryRun: Bool
    public let common: Bool
    public let sys: Bool
    public let implement: Bool
    public let noComment: Bool
    public let flat: Bool
    public let minimal: Bool
    public let derives: Array<String>
    public let referenceArgs: Array<String>

    init(config: CliConfig) {
        this.features = copyStrings(config.features)
        this.filters = copyStrings(config.filters)
        this.inputJsonPaths = copyStrings(config.inputJsonPaths)
        this.inputJsonDirs = copyStrings(config.inputJsonDirs)
        this.inputWinmdPaths = copyStrings(config.inputWinmdPaths)
        this.inputWinmdDirs = copyStrings(config.inputWinmdDirs)
        this.defaultWinmdInput = config.defaultWinmdInput
        this.supportPackageDirs = copyStrings(config.supportPackageDirs)
        this.outputDir = config.outputDir
        this.packageName = config.packageName
        this.manifestPath = config.manifestPath
        this.clean = config.clean
        this.dryRun = config.dryRun
        this.common = config.common
        this.sys = config.sys
        this.implement = config.implement
        this.noComment = config.noComment
        this.flat = config.flat
        this.minimal = config.minimal
        this.derives = copyStrings(config.derives)
        this.referenceArgs = copyStrings(config.referenceArgs)
    }
}

public class BindgenBuilder {
    private let config = CliConfig()

    public init() {}

    public func feature(value: String): BindgenBuilder {
        addUnique(config.features, value)
        return this
    }

    public func filter(value: String): BindgenBuilder {
        addUnique(config.filters, value)
        return this
    }

    public func inputJson(path: String): BindgenBuilder {
        addUnique(config.inputJsonPaths, path)
        return this
    }

    public func input(value: String): BindgenBuilder {
        parseInputArgument(config, value)
        return this
    }

    public func inputs(values: Array<String>): BindgenBuilder {
        for (value in values) {
            parseInputArgument(config, value)
        }
        return this
    }

    public func inputs(values: ArrayList<String>): BindgenBuilder {
        for (value in values) {
            parseInputArgument(config, value)
        }
        return this
    }

    public func defaultInput(): BindgenBuilder {
        config.defaultWinmdInput = true
        return this
    }

    public func inputDir(path: String): BindgenBuilder {
        addUnique(config.inputJsonDirs, path)
        return this
    }

    public func supportPackageDir(path: String): BindgenBuilder {
        addUnique(config.supportPackageDirs, path)
        return this
    }

    public func outputDir(path: String): BindgenBuilder {
        config.outputDir = path
        return this
    }

    public func packageName(value: String): BindgenBuilder {
        config.packageName = value
        return this
    }

    public func manifest(path: String): BindgenBuilder {
        config.manifestPath = path
        return this
    }

    public func common(): BindgenBuilder {
        config.common = true
        config.packageName = "windows_sys"
        if (config.outputDir == ".generated/windows") {
            config.outputDir = "windows_sys"
        }
        return this
    }

    public func clean(): BindgenBuilder {
        config.clean = true
        return this
    }

    public func dryRun(): BindgenBuilder {
        config.dryRun = true
        return this
    }

    public func sys(): BindgenBuilder {
        config.sys = true
        return this
    }

    public func minimal(): BindgenBuilder {
        config.minimal = true
        return this
    }

    public func implement(): BindgenBuilder {
        config.implement = true
        return this
    }

    public func noComment(): BindgenBuilder {
        config.noComment = true
        return this
    }

    public func derive(value: String): BindgenBuilder {
        for (entry in splitString(value, b',')) {
            let trimmed = trimAscii(entry)
            if (!trimmed.isEmpty()) {
                addUnique(config.derives, trimmed)
            }
        }
        return this
    }

    public func reference(value: String): BindgenBuilder {
        addUnique(config.referenceArgs, value)
        return this
    }

    public func configSnapshot(): BindgenConfig {
        finalizeBuilderConfigDefaults(config)
        return BindgenConfig(config)
    }

    public func selectedSymbols(records: ArrayList<SymbolRecord>): ArrayList<SymbolRecord> {
        finalizeBuilderConfigDefaults(config)
        validateRequestedFeatures(config.features, records)
        validateRequestedFilters(config.filters, records)
        return selectedSymbolsForConfig(config, records)
    }

    public func linkOptions(records: ArrayList<SymbolRecord>): ArrayList<String> {
        finalizeBuilderConfigDefaults(config)
        return featureLinkOptions(config, records)
    }

    public func write(records: ArrayList<SymbolRecord>): Unit {
        finalizeBuilderConfigDefaults(config)
        generate(config, records)
    }

    public func loadAndWrite(): Unit {
        finalizeBuilderConfigDefaults(config)
        generate(config, loadSymbolRecords(config))
    }
}

class GeneratedPackageWriter {
    let outputDir: String
    let dryRun: Bool
    let noComment: Bool
    let writtenFiles: ArrayList<String> = ArrayList<String>()
    let writtenFileContent: HashMap<String, String> = HashMap<String, String>()

    public init(outputDir: String, dryRun: Bool) {
        this.outputDir = outputDir
        this.dryRun = dryRun
        this.noComment = false
    }

    public init(outputDir: String, dryRun: Bool, noComment!: Bool) {
        this.outputDir = outputDir
        this.dryRun = dryRun
        this.noComment = noComment
    }

    public func writeFile(relativePath: String, content: String): Unit {
        let rendered = if (noComment) {
            normalizeGeneratedFileContent(content)
        } else {
            normalizeGeneratedFileContent(addGeneratedFileHeader(relativePath, content))
        }
        match (writtenFileContent.get(relativePath)) {
            case Some(previous) =>
                if (previous != rendered) {
                    throw Exception("conflicting generated content for ${relativePath}")
                }
                return
            case None =>
                writtenFileContent.add(relativePath, rendered)
        }
        addUnique(writtenFiles, relativePath)
        if (dryRun) {
            return
        }
        let fullPath = "${outputDir}/${relativePath}"
        ensureDir(directoryOf(fullPath))
        File.writeTo(fullPath, rendered.toArray())
    }

    public func files(): ArrayList<String> {
        return writtenFiles
    }

    public func fileHashes(): HashMap<String, String> {
        let hashes = HashMap<String, String>()
        for (relativePath in writtenFiles) {
            match (writtenFileContent.get(relativePath)) {
                case Some(content) =>
                    hashes.add(relativePath, sha256Hex(content))
                case None =>
                    throw Exception("missing generated content for ${relativePath}")
            }
        }
        hashes
    }
}

func sha256Hex(content: String): String {
    let digest = SHA256()
    digest.write(content.toArray())
    toHexString(digest.finish())
}

func addGeneratedFileHeader(relativePath: String, content: String): String {
    let header = generatedFileHeader(relativePath)
    if (header.isEmpty() || startsWithString(content, header)) {
        return content
    }
    return header + content
}

func normalizeGeneratedFileContent(content: String): String {
    let bytes = content.toArray()
    var end = Int64(bytes.size)
    while (end > 0) {
        let byte = bytes[end - 1]
        if (byte != b'\n' && byte != b'\r' && byte != b' ' && byte != b'\t') {
            break
        }
        end -= 1
    }
    if (end == 0) {
        return "\n"
    }
    return String.fromUtf8(bytes[0..end]) + "\n"
}

func generatedFileHeader(relativePath: String): String {
    if (endsWithString(relativePath, ".cj")) {
        return "// ${GENERATED_FILE_MARKER}\n\n"
    }
    if (endsWithString(relativePath, ".toml")) {
        return "# ${GENERATED_FILE_MARKER}\n\n"
    }
    return ""
}

main(args: Array<String>): Int64 {
    try {
        // Fast path: native WinMD -> JSON emission (matches the reference C#
        // converter's schema). Usage:
        //   windows_bindgen --emit-winmd-json <input.winmd> [-o <out.json>] [-d <dir>] [<more.winmd> ...]
        match (tryRunEmitWinmdJson(args)) {
            case Some(code) => return code
            case None => ()
        }
        let config = parseArgs(args)
        if (config.help) {
            printUsage()
            return 0
        }
        let loadStart = MonoTime.now()
        let records = loadSymbolRecords(config)
        benchMark("load (winmd/json -> symbols)", loadStart)
        if (config.listFeatures) {
            printFeatures(records)
            return 0
        }
        if (config.printLinkOptions) {
            printFeatureLinkOptions(config, records)
            return 0
        }
        let genStart = MonoTime.now()
        generate(config, records)
        benchMark("generate (symbols -> .cj)", genStart)
        return 0
    } catch (err: Exception) {
        println("windows_bindgen error: ${err}")
        return 1
    }
}

func parseArgs(args: Array<String>): CliConfig {
    let config = CliConfig()
    var i: Int64 = 0
    while (i < Int64(args.size)) {
        let arg = args[i]
        match (arg) {
            case "--feature" =>
                i += 1
                if (i >= Int64(args.size)) {
                    throw Exception("--feature requires a value")
                }
                addUnique(config.features, args[i])
            case "--filter" =>
                i += 1
                if (i >= Int64(args.size)) {
                    throw Exception("--filter requires a value")
                }
                addUnique(config.filters, args[i])
            case "--filter-file" =>
                i += 1
                if (i >= Int64(args.size)) {
                    throw Exception("--filter-file requires a value")
                }
                loadFilterRulesFromFile(config, args[i])
            case "--input-json" =>
                i += 1
                if (i >= Int64(args.size)) {
                    throw Exception("--input-json requires a value")
                }
                addUnique(config.inputJsonPaths, args[i])
            case "--input-dir" =>
                i += 1
                if (i >= Int64(args.size)) {
                    throw Exception("--input-dir requires a value")
                }
                addUnique(config.inputJsonDirs, args[i])
            case "--support-package-dir" =>
                i += 1
                if (i >= Int64(args.size)) {
                    throw Exception("--support-package-dir requires a value")
                }
                addUnique(config.supportPackageDirs, args[i])
            case "--out" =>
                i += 1
                if (i >= Int64(args.size)) {
                    throw Exception("--out requires a value")
                }
                config.outputDir = args[i]
            case "--package-name" =>
                i += 1
                if (i >= Int64(args.size)) {
                    throw Exception("--package-name requires a value")
                }
                if (args[i].isEmpty()) {
                    throw Exception("--package-name requires a non-empty value")
                }
                config.packageName = args[i]
            case "--manifest" =>
                i += 1
                if (i >= Int64(args.size)) {
                    throw Exception("--manifest requires a value")
                }
                config.manifestPath = args[i]
            case "--common" =>
                config.common = true
                config.packageName = "windows_sys"
                if (config.outputDir == ".generated/windows") {
                    config.outputDir = "windows_sys"
                }
            case "--clean" => config.clean = true
            case "--dry-run" => config.dryRun = true
            case "--list-features" => config.listFeatures = true
            case "--print-link-options" => config.printLinkOptions = true
            case "--print-link-option" => config.printLinkOptions = true
            case "--sys" => config.sys = true
            case "--flat" => config.flat = true
            case "--minimal" => config.minimal = true
            case "--implement" => config.implement = true
            case "--no-comment" => config.noComment = true
            case "--derive" =>
                i += 1
                if (i >= Int64(args.size)) {
                    throw Exception("--derive requires a value")
                }
                for (entry in splitString(args[i], b',')) {
                    let trimmed = trimAscii(entry)
                    if (!trimmed.isEmpty()) {
                        addUnique(config.derives, trimmed)
                    }
                }
            case "--reference" =>
                i += 1
                if (i >= Int64(args.size)) {
                    throw Exception("--reference requires a value")
                }
                addUnique(config.referenceArgs, args[i])
            case "--help" =>
                config.help = true
            case _ =>
                if (startsWithString(arg, "--")) {
                    throw Exception("unknown argument: ${arg}")
                }
                parseInputArgument(config, arg)
        }
        i += 1
    }
    finalizeConfigDefaults(config)
    return config
}

// Load filter rules from a newline-delimited file (one `--filter` rule per line).
// Blank lines and lines whose first non-whitespace byte is `#` are skipped. This
// avoids the Windows command-line length limit when a method-level filter set has
// hundreds of rules (each `--filter <rule>` pair would otherwise overflow the
// 32 KB argv cap).
func loadFilterRulesFromFile(config: CliConfig, path: String): Unit {
    let bytes = try {
        File.readFrom(path)
    } catch (err: Exception) {
        throw Exception("--filter-file: cannot read ${path}: ${err}")
    }
    let content = String.fromUtf8(bytes)
    for (line in splitString(content, b'\n')) {
        let rule = trimAscii(line)
        if (rule.isEmpty() || startsWithString(rule, "#")) {
            continue
        }
        addUnique(config.filters, rule)
    }
}

func parseInputArgument(config: CliConfig, arg: String): Unit {
    if (arg == "default") {
        config.defaultWinmdInput = true
        return
    }
    if (endsWithAsciiIgnoreCase(arg, ".json")) {
        addUnique(config.inputJsonPaths, arg)
        return
    }
    if (endsWithAsciiIgnoreCase(arg, ".winmd")) {
        addUnique(config.inputWinmdPaths, arg)
        return
    }
    if (directoryExists(arg)) {
        if (directoryContainsWinmdFiles(arg)) {
            addUnique(config.inputWinmdDirs, arg)
        } else if (directoryContainsJsonFiles(arg)) {
            addUnique(config.inputJsonDirs, arg)
        } else {
            addUnique(config.inputJsonDirs, arg)
        }
        return
    }
    throw Exception("unsupported input argument: ${arg}; pass a .winmd file/directory or 'default' (parsed natively), --input-json <winmd.json>, or --input-dir <json-dir>")
}

func finalizeConfigDefaults(config: CliConfig): Unit {
    if (config.common && config.supportPackageDirs.isEmpty()) {
        addUnique(config.supportPackageDirs, "windows_version")
        addUnique(config.supportPackageDirs, "windows_registry")
        addUnique(config.supportPackageDirs, "windows_threading")
        addUnique(config.supportPackageDirs, "windows_services")
        addUnique(config.supportPackageDirs, "windows_foundation")
        addUnique(config.supportPackageDirs, "windows_collections")
        addUnique(config.supportPackageDirs, "windows_future")
    }
    if (config.features.isEmpty() && config.filters.isEmpty() && !config.common && !config.listFeatures && !config.help) {
        addUnique(config.features, "all")
    }
}

func finalizeBuilderConfigDefaults(config: CliConfig): Unit {
    if (!hasMetadataInput(config)) {
        config.defaultWinmdInput = true
    }
    finalizeConfigDefaults(config)
}

func hasMetadataInput(config: CliConfig): Bool {
    return config.defaultWinmdInput ||
        !config.inputJsonPaths.isEmpty() ||
        !config.inputJsonDirs.isEmpty() ||
        !config.inputWinmdPaths.isEmpty() ||
        !config.inputWinmdDirs.isEmpty()
}

func loadSymbolRecords(config: CliConfig): ArrayList<SymbolRecord> {
    if (config.help) {
        return ArrayList<SymbolRecord>()
    }
    // Install the minimal closure-truncation mode before symbols are indexed:
    // buildSymbolRecords -> typeDependencies reads this flag to truncate interface
    // member-signature dependencies. Set unconditionally from config so a non-
    // minimal run clears any flag a prior in-process run may have left set.
    setMinimalInterfaceTruncation(config.minimal)
    // .winmd inputs are always parsed natively (loadWinmdFilesNative). The only
    // invalid combination is handing a raw .winmd to --input-json, which expects
    // already-converted JSON.
    validateMetadataInputs(config)
    // .winmd directories are valid metadata sources parsed natively, so a
    // winmd-only directory never errors when collecting JSON paths.
    let inputJsonPaths = expandedInputJsonPaths(config)
    // Records built directly from natively-parsed .winmd inputs. Combined with
    // any JSON-derived records below before symbol resolution.
    let winmdFileRecords = ArrayList<WinmdFileRecord>()
    if (config.defaultWinmdInput) {
        let defaultNativeStart = MonoTime.now()
        for (record in loadDefaultWinmdFileRecordsNative()) {
            winmdFileRecords.add(record)
        }
        benchMark("  default native winmd parse+adapt", defaultNativeStart)
    }
    let winmdPaths = expandedInputWinmdPaths(config)
    if (!winmdPaths.isEmpty()) {
        let nativeStart = MonoTime.now()
        for (record in loadWinmdFilesNative(winmdPaths)) {
            winmdFileRecords.add(record)
        }
        benchMark("  native winmd parse+adapt", nativeStart)
    }
    if (inputJsonPaths.isEmpty() && winmdFileRecords.isEmpty()) {
        throw Exception(noMetadataInputError())
    }
    if (!inputJsonPaths.isEmpty()) {
        let jsonStart = MonoTime.now()
        for (record in loadWinmdJsonFiles(inputJsonPaths)) {
            winmdFileRecords.add(record)
        }
        benchMark("  json parse", jsonStart)
    }
    let symStart = MonoTime.now()
    let result = buildSymbolRecords(winmdFileRecords)
    benchMark("  buildSymbolRecords", symStart)
    return result
}

// Collect JSON metadata paths from --input-json files and --input-dir
// directories. Directories that contain only .winmd files are parsed natively
// elsewhere, so they contribute no JSON paths here.
func expandedInputJsonPaths(config: CliConfig): ArrayList<String> {
    let paths = ArrayList<String>()
    for (path in config.inputJsonPaths) {
        addUnique(paths, path)
    }
    for (dir in config.inputJsonDirs) {
        let entries = Directory.readFrom(dir)
        let names = ArrayList<String>()
        for (entry in entries) {
            if (endsWithAsciiIgnoreCase(entry.name, ".json")) {
                names.add(entry.name)
            }
        }
        sortStrings(names)
        for (name in names) {
            addUnique(paths, "${dir}/${name}")
        }
    }
    return paths
}

// Reject only the genuinely invalid combination: a .winmd path handed to
// --input-json (which expects already-converted JSON). Positional .winmd
// files/directories and `default` are valid metadata sources parsed natively.
func validateMetadataInputs(config: CliConfig): Unit {
    match (firstWinmdPath(config.inputJsonPaths)) {
        case Some(path) => throw Exception(winmdJsonFlagInputError(path))
        case None => ()
    }
}

func expandedInputWinmdPaths(config: CliConfig): ArrayList<String> {
    let paths = ArrayList<String>()
    for (path in config.inputWinmdPaths) {
        addUnique(paths, path)
    }
    for (dir in config.inputWinmdDirs) {
        addWinmdFilesFromDirectory(paths, dir)
    }
    for (dir in config.inputJsonDirs) {
        if (!directoryContainsJsonFiles(dir) && directoryContainsWinmdFiles(dir)) {
            addWinmdFilesFromDirectory(paths, dir)
        }
    }
    sortStrings(paths)
    return paths
}

func loadDefaultWinmdFileRecordsNative(): ArrayList<WinmdFileRecord> {
    match (loadEmbeddedWinmdFilesNative()) {
        case Some(records) => return records
        case None => ()
    }
    let paths = ArrayList<String>()
    addDefaultWinmdInput(paths)
    return loadWinmdFilesNative(paths)
}

func addDefaultWinmdInput(paths: ArrayList<String>): Unit {
    let candidates = defaultWinmdDirectoryCandidates()
    match (findDefaultWinmdDirectory(candidates)) {
        case Some(dir) => addWinmdFilesFromDirectory(paths, dir)
        case None => throw Exception(defaultWinmdInputError(candidates))
    }
}

func defaultWinmdDirectoryCandidates(): ArrayList<String> {
    let candidates = ArrayList<String>()
    candidates.add("winmd")
    candidates.add("../winmd")
    candidates.add("../../winmd")
    return candidates
}

func findDefaultWinmdDirectory(candidates: ArrayList<String>): Option<String> {
    for (dir in candidates) {
        if (directoryExists(dir) && directoryContainsWinmdFiles(dir)) {
            return Some(dir)
        }
    }
    return None
}

func addWinmdFilesFromDirectory(paths: ArrayList<String>, dir: String): Unit {
    let entries = Directory.readFrom(dir)
    let names = ArrayList<String>()
    for (entry in entries) {
        if (endsWithAsciiIgnoreCase(entry.name, ".winmd")) {
            names.add(entry.name)
        }
    }
    if (names.isEmpty()) {
        throw Exception("WinMD directory '${dir}' contains no .winmd files")
    }
    sortStrings(names)
    for (name in names) {
        addUnique(paths, "${dir}/${name}")
    }
}

func firstWinmdPath(paths: ArrayList<String>): Option<String> {
    for (path in paths) {
        if (endsWithAsciiIgnoreCase(path, ".winmd")) {
            return Some(path)
        }
    }
    return None
}

func noMetadataInputError(): String {
    return "no metadata input provided. Pass a .winmd file/directory (parsed natively), " +
        "or --input-json <winmd.json> / --input-dir <json-dir> for pre-converted JSON. " +
        "For bundled/default WinMD metadata, run: windows_bindgen default --feature <namespace> --out .generated/windows."
}

func defaultWinmdInputError(candidates: ArrayList<String>): String {
    return "embedded WinMD resources were not linked and bundled/default WinMD metadata directory was not found. Tried: ${joinStrings(candidates, ", ")}. " +
        "Run from the windows-cj repository root or windows_bindgen package directory, " +
        "or pass a .winmd directory explicitly."
}

func winmdJsonFlagInputError(path: String): String {
    return "--input-json expects converted JSON, not WinMD input '${path}'. " +
        "Pass '${path}' positionally to parse it natively, or pre-convert it and pass the generated JSON file."
}

func generate(config: CliConfig, records: ArrayList<SymbolRecord>): Unit {
    // Keep the minimal closure-truncation mode in force through selection:
    // filterRecordMembers recomputes typeDependencies for filter-selected records,
    // and that recomputation must also truncate interface member dependencies. The
    // records passed in were already indexed under this flag (loadSymbolRecords),
    // so setting it here only matters for callers that build records separately.
    setMinimalInterfaceTruncation(config.minimal)
    ensureCommonFeatureSelection(config)
    validateRequestedFeatures(config.features, records)
    validateRequestedFilters(config.filters, records)
    if (config.clean && !config.dryRun) {
        removeIfExists(config.outputDir, recursive: true)
    }

    let renderOptions = renderOptionsFromCliConfig(config)
    let selectionRules = requestedSelectionRules(config)
    let nativeSelected = selectSymbolsFromFeatureAndFilterRules(config.features, config.filters, records)
    var selected = nativeSelected
    if (config.common) {
        selected = filterCommonSymbols(nativeSelected)
    }
    if (!renderOptions.references.isEmpty()) {
        selected = filterReferencedSymbols(selected, renderOptions.references)
    }
    let selectedByName = recordsByFullName(selected)
    let nativeSelectedByName = recordsByFullName(nativeSelected)
    let supportDeps = collectSupportDependencyNames(config.packageName, selected, selectedByName, renderOptions)
    addReferencePackagesToSupportDeps(supportDeps, renderOptions.references, config.packageName)
    let commonHelperFiles = ArrayList<GeneratedNativeHelperFile>()
    if (config.common) {
        for (file in commonNativeHelperFiles(nativeSelected, config.packageName, nativeSelectedByName)) {
            commonHelperFiles.add(file)
        }
        collectSupportDependencyNamesFromGeneratedNativeHelpers(config.packageName, supportDeps, commonHelperFiles)
    }
    let writer = GeneratedPackageWriter(config.outputDir, config.dryRun, noComment: renderOptions.noComment)

    if (config.flat) {
        // Flat single-package layout: every selected type in one package, no
        // namespace subpackages, no cross-package import cycles, no `@When`
        // gating. The single source package is an ordinary incremental node, so a
        // downstream edit recompiles only the changed file and skips the
        // unchanged bindings. See flat_rendering.cj for the disambiguation rule.
        writer.writeFile("cjpm.toml", renderCjpmToml(config.packageName, supportDeps: supportDeps))
        let flatNames = writeFlatPackage(
            writer,
            selected,
            nativeSelected,
            config.packageName,
            selectedByName,
            nativeSelectedByName,
            renderOptions,
            config.common
        )
        // Emit the full-name -> flat-name disambiguation map so downstream tools
        // (e.g. the import rewriter) resolve a consumer's `<Ns>.<Type>` import to
        // the exact flat name the package declares.
        writer.writeFile("flat-name-map.json", renderFlatNameMapJson(selected, flatNames))
        let manifest = renderManifest(selectionRules, selected, writer.files(), writer.fileHashes(), config.packageName)
        if (!config.manifestPath.isEmpty()) {
            if (!config.dryRun) {
                ensureDir(directoryOf(config.manifestPath))
                File.writeTo(config.manifestPath, manifest.toArray())
            }
        } else {
            writer.writeFile("codegen-manifest.json", manifest)
        }
        return
    }

    // The support-dependency set is recorded as cjpm.toml [dependencies] (the
    // real link edges); the generated subpackages import what they use directly,
    // so no redundant root-level import anchor file is emitted.
    writer.writeFile("cjpm.toml", renderCjpmToml(config.packageName, supportDeps: supportDeps))
    writer.writeFile("src/mod.cj", "package ${config.packageName}\n")
    if (config.common) {
        writeCommonNativeHelperFiles(writer, commonHelperFiles)
    }
    // Namespace -> namespace dependency map (base types, fields, projected method
    // types, attribute types). The feature-selection tool reads this to compute
    // the transitive closure of cfg variables a consumer must enable. Mirrors the
    // reference projection's per-namespace feature dependency graph. Computed over
    // the full native symbol set (not just the impl subset) so the P/Invoke native
    // helper functions' cross-namespace type references are included in the graph;
    // otherwise enabling a namespace whose native helpers reference another would
    // miss that edge in the closure and fail to compile.
    //
    // The graph is computed BEFORE the impl files are written because the impl
    // monolith is now split into per-namespace subpackages: a symbol in
    // `impl.<ns_var(N)>` that references a symbol in namespace M must import M's
    // impl subpackage, and these cross-impl import edges are derived from exactly
    // this dependency graph (see renderCrossImplImports / writeImplFiles).
    let namespaceDeps = computeNamespaceDependencies(nativeSelected, nativeSelectedByName)
    // Augment the metadata-derived graph by scanning the actually-emitted source
    // (impl declarations + native helper functions) for references to other
    // namespaces' types, so the closure the selection tool computes is complete.
    let implNameToNamespace = buildImplNameToNamespace(nativeSelected)
    for (symbol in selected) {
        augmentNamespaceDependenciesFromSource(
            namespaceDeps,
            symbol.namespace,
            renderImplSource(symbol, selectedByName, renderOptions),
            implNameToNamespace
        )
    }
    for (helperNamespace in commonNativeHelperNamespaces(nativeSelected)) {
        let helperPath = "${namespaceToDirectory(helperNamespace)}/native_helpers.cj"
        for (file in commonHelperFiles) {
            if (file.relativePath == helperPath) {
                augmentNamespaceDependenciesFromSource(
                    namespaceDeps,
                    helperNamespace,
                    file.content,
                    implNameToNamespace
                )
            }
        }
    }
    sortNamespaceDependencyBuckets(namespaceDeps)

    // Write every namespace's declarations directly into its nested namespace
    // package `windows_sys.<NsPath>` (short-named, gated, with package-alias
    // imports for the namespaces it references). There is no separate impl/ split
    // and no facade re-export layer; the namespace package IS the public surface.
    writeImplFiles(writer, selected, config.packageName, selectedByName, namespaceDeps, renderOptions)
    let namespaces = selectedNamespaces(selected)
    // Anchor every intermediate namespace node (e.g. `windows_sys.Microsoft.UI`
    // when only `...Microsoft.UI.Xaml` has symbols) and each selected namespace's
    // own package, so the nested package tree is complete.
    writeIntermediateNamespaceModules(writer, namespaces, config.packageName)
    for (namespace in namespaces) {
        writer.writeFile(namespaceToRelativePath(namespace), "package ${namespaceToPackage(namespace, config.packageName)}\n")
    }

    writer.writeFile("namespace-deps.json", renderNamespaceDepsJson(namespaceDeps))

    // Subpackage -> cfg-variable map (the build tool reads this to skip parsing
    // gated-off subpackages). One namespace package per namespace; the root
    // package itself carries no gated declarations and is excluded.
    let subpackageToCfgVar = HashMap<String, String>()
    for (namespace in namespaces) {
        let nsPackage = namespaceToPackage(namespace, config.packageName)
        if (nsPackage != config.packageName) {
            subpackageToCfgVar.add(nsPackage, namespaceToCfgVar(namespace))
        }
    }
    writer.writeFile("subpackage-namespaces.json", renderSubpackageNamespacesJson(config.packageName, subpackageToCfgVar))

    // Emit a cfg.toml into every package directory that carries gated source. The
    // complete cfg-variable set (every namespace plus the synthetic native-helper
    // namespaces) is written uniformly so any `@When` referencing a variable
    // resolves, and the feature-selection tool can rewrite all files in lockstep.
    // All default to "off" for the opt-in baseline.
    let allCfgVars = collectAllCfgVars(nativeSelected, commonNativeHelperNamespaces(nativeSelected))
    let cfgTomlBody = renderCfgToml(allCfgVars)
    for (directory in gatedSourceDirectories(writer.files())) {
        let cfgPath = if (directory.isEmpty()) {
            "cfg.toml"
        } else {
            "${directory}/cfg.toml"
        }
        writer.writeFile(cfgPath, cfgTomlBody)
    }

    let manifest = renderManifest(selectionRules, selected, writer.files(), writer.fileHashes(), config.packageName)
    if (!config.manifestPath.isEmpty()) {
        if (!config.dryRun) {
            ensureDir(directoryOf(config.manifestPath))
            File.writeTo(config.manifestPath, manifest.toArray())
        }
    } else {
        writer.writeFile("codegen-manifest.json", manifest)
    }
}

func renderOptionsFromCliConfig(config: CliConfig): RenderOptions {
    let options = RenderOptions()
    options.sys = config.sys
    options.implement = config.implement
    options.noComment = config.noComment
    options.ergonomicWrappers = !config.sys
    for (entry in config.derives) {
        options.derives.add(entry)
    }
    for (arg in config.referenceArgs) {
        options.references.add(ReferenceStage.parse(arg))
    }
    return options
}

func filterReferencedSymbols(
    symbols: ArrayList<SymbolRecord>,
    references: ArrayList<ReferenceStage>
): ArrayList<SymbolRecord> {
    let result = ArrayList<SymbolRecord>()
    for (symbol in symbols) {
        match (referenceContainsRecord(references, symbol)) {
            case Some(_) => ()
            case None => result.add(symbol)
        }
    }
    return result
}

func addReferencePackagesToSupportDeps(
    supportDeps: ArrayList<String>,
    references: ArrayList<ReferenceStage>,
    packageName: String
): Unit {
    for (stage in references) {
        if (stage.name != packageName) {
            addUnique(supportDeps, stage.name)
        }
    }
}

func ensureCommonFeatureSelection(config: CliConfig): Unit {
    if (config.common && config.features.isEmpty() && config.filters.isEmpty()) {
        for (feature in collectCommonFeatureNames(config.supportPackageDirs)) {
            addUnique(config.features, feature)
        }
        // The composed WinUI host now lives in the reactor framework rather than a
        // dedicated runtime support package, so the WinUI common feature
        // namespaces are supplied from a static table here instead of being
        // scanned out of a support package's source imports.
        for (feature in winuiCommonFeatureNames()) {
            addUnique(config.features, feature)
        }
        if (config.features.isEmpty()) {
            throw Exception("--common did not find support package imports; pass --feature or --support-package-dir")
        }
    }
}

// Static set of WinUI common feature namespaces contributed to `--common`
// selection. These are the Microsoft.UI.* (plus the two cross-namespace helper
// types) feature names the composed WinUI host depends on. Keeping them as an
// explicit table decouples `--common` from any single support package's source
// imports while preserving the exact selection the WinUI host requires.
func winuiCommonFeatureNames(): Array<String> {
    return [
        "Microsoft.UI.Windowing.AppWindow",
        "Microsoft.UI.Xaml.Application",
        "Microsoft.UI.Xaml.Controls.ContentControl",
        "Microsoft.UI.Xaml.Controls.ItemsControl",
        "Microsoft.UI.Xaml.IApplicationFactory",
        "Microsoft.UI.Xaml.IApplicationOverrides",
        "Microsoft.UI.Xaml.IApplicationStatics",
        "Microsoft.UI.Xaml.IFrameworkElement",
        "Microsoft.UI.Xaml.IUIElement",
        "Microsoft.UI.Xaml.IWindowFactory",
        "Microsoft.UI.Xaml.Markup.IXamlReaderStatics",
        "Microsoft.UI.Xaml.Markup.XamlReader",
        "Microsoft.UI.Xaml.ResourceDictionary",
        "Microsoft.UI.Xaml.UIElement",
        "Microsoft.UI.Xaml.Window",
        "Windows.Foundation.EventRegistrationToken",
        "Windows.Win32.System.Com"
    ]
}

func featureLinkOptions(config: CliConfig, records: ArrayList<SymbolRecord>): ArrayList<String> {
    ensureCommonFeatureSelection(config)
    validateRequestedFeatures(config.features, records)
    validateRequestedFilters(config.filters, records)
    let selected = selectedSymbolsForConfig(config, records)
    let selectedByName = recordsByFullName(selected)
    let supportDeps = collectSupportDependencyNames(config.packageName, selected, selectedByName)
    return collectSupportLinkOptions(supportDeps)
}

func printFeatureLinkOptions(config: CliConfig, records: ArrayList<SymbolRecord>): Unit {
    println(joinStrings(featureLinkOptions(config, records), " "))
}

func validateRequestedFeatures(features: ArrayList<String>, records: ArrayList<SymbolRecord>): Unit {
    if (contains(features, "all")) {
        return
    }
    let available = featureNamesFromRecords(records)
    let recordsByName = recordsByFullName(records)
    for (feature in features) {
        var found = false
        for (candidate in available) {
            if (candidate == feature) {
                found = true
                break
            }
        }
        if (!found && recordsByName.contains(feature)) {
            found = true
        }
        if (!found) {
            throw Exception("unknown feature: ${feature}")
        }
    }
}

func validateRequestedFilters(filters: ArrayList<String>, records: ArrayList<SymbolRecord>): Unit {
    let unknown = ArrayList<String>()
    for (filter in filters) {
        let pattern = selectionRulePattern(filter)
        if (pattern.isEmpty()) {
            throw Exception("empty filter rule: ${filter}")
        }
        if (pattern == "all") {
            continue
        }
        var found = false
        for (record in records) {
            if (selectionPatternMatchesRecord(pattern, record)) {
                found = true
                break
            }
        }
        if (!found) {
            unknown.add(filter)
        }
    }
    // Report ALL unmatched filter rules at once (one per line) rather than
    // aborting on the first. A method-level filter set has hundreds of rules; a
    // single message per run keeps the iterate-and-fix loop fast.
    if (!unknown.isEmpty()) {
        let lines = ArrayList<String>()
        for (rule in unknown) {
            lines.add("  ${rule}")
        }
        throw Exception("unknown filter rules (${unknown.size}):\n${joinStrings(lines, "\n")}")
    }
}

func requestedSelectionRules(config: CliConfig): ArrayList<String> {
    let rules = ArrayList<String>()
    for (feature in config.features) {
        addUnique(rules, feature)
    }
    for (filter in config.filters) {
        addUnique(rules, filter)
    }
    return rules
}

func selectSymbols(features: ArrayList<String>, records: ArrayList<SymbolRecord>): ArrayList<SymbolRecord> {
    return selectSymbolsFromRecords(features, records)
}

func selectedSymbolsForConfig(config: CliConfig, records: ArrayList<SymbolRecord>): ArrayList<SymbolRecord> {
    let selected = selectSymbolsFromFeatureAndFilterRules(config.features, config.filters, records)
    if (config.common) {
        return filterCommonSymbols(selected)
    }
    return selected
}

func filterCommonSymbols(symbols: ArrayList<SymbolRecord>): ArrayList<SymbolRecord> {
    let filtered = ArrayList<SymbolRecord>()
    for (symbol in symbols) {
        match (symbol.typeDef) {
            case Some(typeDef) =>
                if (!hasPInvokeMethods(typeDef)) {
                    filtered.add(symbol)
                }
            case None => filtered.add(symbol)
        }
    }
    return filtered
}

func recordsByFullName(records: ArrayList<SymbolRecord>): HashMap<String, SymbolRecord> {
    let recordsByName = HashMap<String, SymbolRecord>()
    for (record in records) {
        recordsByName.add(record.fullName, record)
    }
    return recordsByName
}

func selectSymbolsFromRecords(features: ArrayList<String>, records: ArrayList<SymbolRecord>): ArrayList<SymbolRecord> {
    let selectedNames = ArrayList<String>()
    let selectedNameSet = HashSet<String>()
    let recordsByName = HashMap<String, SymbolRecord>()
    for (record in records) {
        recordsByName.add(record.fullName, record)
    }

    for (record in records) {
        if (selectionRulesIncludeRecord(features, record)) {
            addSelectedSymbolName(selectedNames, selectedNameSet, record.fullName)
        }
    }

    expandSelectedSymbolDependencies(selectedNames, selectedNameSet, recordsByName, features)
    return selectedRecordsInOriginalOrder(records, selectedNameSet)
}

func selectSymbolsFromFeatureAndFilterRules(
    features: ArrayList<String>,
    filters: ArrayList<String>,
    records: ArrayList<SymbolRecord>
): ArrayList<SymbolRecord> {
    let selectedNames = ArrayList<String>()
    let selectedNameSet = HashSet<String>()
    let recordsByName = HashMap<String, SymbolRecord>()
    let selectedRecordOverrides = HashMap<String, SymbolRecord>()
    for (record in records) {
        recordsByName.add(record.fullName, record)
    }

    for (record in records) {
        let includedByFeature = featureRulesIncludeRecord(features, record)
        let includedByFilter = selectionRulesIncludeRecord(filters, record)
        let included = includedByFeature || includedByFilter
        if (included && !selectionRulesExcludeRecord(filters, record)) {
            addSelectedSymbolName(selectedNames, selectedNameSet, record.fullName)
            if (!includedByFeature && includedByFilter) {
                selectedRecordOverrides.add(record.fullName, filterRecordMembers(record, filters))
            }
        }
    }

    expandSelectedSymbolDependencies(selectedNames, selectedNameSet, recordsByName, filters, selectedRecordOverrides: selectedRecordOverrides)
    return selectedRecordsInOriginalOrder(records, selectedNameSet, selectedRecordOverrides: selectedRecordOverrides)
}

func addSelectedSymbolName(
    selectedNames: ArrayList<String>,
    selectedNameSet: HashSet<String>,
    fullName: String
): Unit {
    if (!selectedNameSet.contains(fullName)) {
        selectedNames.add(fullName)
        selectedNameSet.add(fullName)
    }
}

func expandSelectedSymbolDependencies(
    selectedNames: ArrayList<String>,
    selectedNameSet: HashSet<String>,
    recordsByName: HashMap<String, SymbolRecord>,
    excludeRules: ArrayList<String>,
    selectedRecordOverrides!: HashMap<String, SymbolRecord> = HashMap<String, SymbolRecord>()
): Unit {
    var cursor: Int64 = 0
    while (cursor < Int64(selectedNames.size)) {
        let fullName = selectedNames[cursor]
        match (selectedRecordForName(fullName, recordsByName, selectedRecordOverrides)) {
            case Some(record) =>
                for (dependency in record.dependencies) {
                    if (!selectedNameSet.contains(dependency) && recordsByName.contains(dependency)) {
                        let dependencyRecord = recordsByName.get(dependency).getOrThrow()
                        if (!selectionRulesExcludeRecord(excludeRules, dependencyRecord)) {
                            addSelectedSymbolName(selectedNames, selectedNameSet, dependency)
                        }
                    }
                }
            case None => ()
        }
        cursor += 1
    }
}

func selectedRecordsInOriginalOrder(
    records: ArrayList<SymbolRecord>,
    selectedNameSet: HashSet<String>,
    selectedRecordOverrides!: HashMap<String, SymbolRecord> = HashMap<String, SymbolRecord>()
): ArrayList<SymbolRecord> {
    let selected = ArrayList<SymbolRecord>()
    for (record in records) {
        if (selectedNameSet.contains(record.fullName)) {
            match (selectedRecordOverrides.get(record.fullName)) {
                case Some(overrideRecord) => selected.add(overrideRecord)
                case None => selected.add(record)
            }
        }
    }
    return selected
}

func selectedRecordForName(
    fullName: String,
    recordsByName: HashMap<String, SymbolRecord>,
    selectedRecordOverrides: HashMap<String, SymbolRecord>
): Option<SymbolRecord> {
    match (selectedRecordOverrides.get(fullName)) {
        case Some(record) => return Some(record)
        case None => return recordsByName.get(fullName)
    }
}

// Accessor method names a kept property/event needs rendered alongside it. A WinRT
// property renders as a Cangjie `prop` only when its getter (and, for read-write,
// setter) METHOD survives in the pruned method list — `renderRuntimeClassProperty`
// looks the accessor methods up by name. If a member rule keeps a property by its
// setter name (`put_X`) but the getter method gets pruned, the property degrades to
// a standalone write-only `func SetX`, which then collides with any same-named
// static attached-property setter. Keeping a kept property's/event's accessor
// methods preserves the `prop`/event projection (and the renderer skips them as
// standalone methods, so no double render). The accessors take/return the member's
// own type, so this adds no new dependency-closure types.
func requiredAccessorMethodNames(
    properties: ArrayList<PropertyRecord>,
    events: ArrayList<EventRecord>
): HashSet<String> {
    let names = HashSet<String>()
    for (property in properties) {
        names.add(runtimeAccessorMethodName(property.accessors, "Getter") ?? "get_${property.name}")
        names.add(runtimeAccessorMethodName(property.accessors, "Setter") ?? "put_${property.name}")
    }
    for (event in events) {
        names.add(runtimeAccessorMethodName(event.accessors, "Adder") ?? "add_${event.name}")
        names.add(runtimeAccessorMethodName(event.accessors, "Remover") ?? "remove_${event.name}")
    }
    return names
}

func filterMethodsKeepingAccessors(
    methods: ArrayList<MethodRecord>,
    containerFullName: String,
    filters: ArrayList<String>,
    requiredAccessors: HashSet<String>
): ArrayList<MethodRecord> {
    let selected = ArrayList<MethodRecord>()
    for (method in methods) {
        if (requiredAccessors.contains(method.name) ||
            selectionRulesIncludeMethod(filters, containerFullName, method)) {
            selected.add(method)
        }
    }
    return selected
}

func filterRecordMembers(record: SymbolRecord, filters: ArrayList<String>): SymbolRecord {
    match (record.typeDef) {
        case Some(typeDef) =>
            // ABI-critical (--minimal): an interface's vtable struct is laid out in
            // declaration order with no slot padding, so pruning its methods would
            // compress the vtable and break the COM ABI. In minimal mode a selected
            // interface therefore keeps ALL its methods (full vtable / correct slot
            // order) and is rendered unchanged; only its CLOSURE dependencies are
            // narrowed to the signature types of the member-rule-matched methods.
            // That honors a member rule like `ICompositor.CreateScalarKeyFrameAnimation`
            // (seeding the projected type it names) without dragging in the whole
            // interface's high-level signature graph. A whole-type-selected interface
            // (no member rules target it) matches nothing here and contributes no
            // member dependencies.
            if (minimalInterfaceTruncation && isWinrtInterfaceType(typeDef) && !isValueType(typeDef)) {
                return minimalInterfaceRecordWithSeededDependencies(record, typeDef, filters)
            }
            let fields = filterFieldsBySelectionRules(typeDef.fields, record.fullName, filters)
            let properties = filterPropertiesBySelectionRules(typeDef.properties, record.fullName, filters)
            let events = filterEventsBySelectionRules(typeDef.events, record.fullName, filters)
            let methods = filterMethodsKeepingAccessors(
                typeDef.methods, record.fullName, filters,
                requiredAccessorMethodNames(properties, events))
            let matchedMembers = fields.size + methods.size + properties.size + events.size
            if (matchedMembers == 0) {
                return record
            }
            let prunedTypeDef = TypeDefinitionRecord(
                typeDef.namespace,
                typeDef.name,
                metadataToken: typeDef.metadataToken,
                baseType: typeDef.baseType,
                hasBaseType: typeDef.hasBaseType,
                isNested: typeDef.isNested,
                attributes: typeDef.attributes,
                customAttributes: typeDef.customAttributes,
                fields: fields,
                interfaceImplementations: typeDef.interfaceImplementations,
                layout: typeDef.layout,
                methods: methods,
                nestedTypes: typeDef.nestedTypes,
                genericParameters: typeDef.genericParameters,
                events: events,
                properties: properties,
                supportedArchitectures: typeDef.supportedArchitectures,
                supportedOsPlatform: typeDef.supportedOsPlatform,
                isExperimental: typeDef.isExperimental,
                sourceSet: typeDef.sourceSet
            )
            return SymbolRecord(
                record.fullName,
                record.namespace,
                record.name,
                record.implName,
                typeDependencies(prunedTypeDef, record.fullName),
                implSource: record.implSource,
                metadataToken: record.metadataToken,
                typeDef: Some(prunedTypeDef)
            )
        case None => return record
    }
}

// Minimal-mode interface record: keep the FULL interface (every method, full
// vtable, unchanged rendering) but recompute its closure dependencies as the union
// of (a) the interface's structural dependencies under truncation (base interface,
// IID/attribute types, implemented interfaces) and (b) the signature types of only
// the methods/properties/events selected by member rules. The full typeDef is
// preserved so the renderer emits every vtable slot; the narrowed dependency list
// is what keeps the selection closure from cascading through unseeded members.
func minimalInterfaceRecordWithSeededDependencies(
    record: SymbolRecord,
    typeDef: TypeDefinitionRecord,
    filters: ArrayList<String>
): SymbolRecord {
    // (a) Structural dependencies: typeDependencies already truncates an
    // interface's member-signature dependencies in minimal mode, so this yields
    // exactly {base interface, IID/custom-attribute types, implemented interfaces}.
    let dependencies = ArrayList<String>()
    for (dependency in typeDependencies(typeDef, record.fullName)) {
        addUnique(dependencies, dependency)
    }
    // (b) Seeded-member signature dependencies: build a typeDef holding only the
    // member-rule-matched methods/properties/events, then compute its dependencies
    // with interface truncation temporarily OFF so the seeded members' signature
    // types are collected. The full interface's methods are NOT touched.
    let seededProperties = filterPropertiesBySelectionRules(typeDef.properties, record.fullName, filters)
    let seededEvents = filterEventsBySelectionRules(typeDef.events, record.fullName, filters)
    let seededMethods = filterMethodsKeepingAccessors(
        typeDef.methods, record.fullName, filters,
        requiredAccessorMethodNames(seededProperties, seededEvents))
    if (!seededMethods.isEmpty() || !seededProperties.isEmpty() || !seededEvents.isEmpty()) {
        let seededTypeDef = TypeDefinitionRecord(
            typeDef.namespace,
            typeDef.name,
            metadataToken: typeDef.metadataToken,
            baseType: typeDef.baseType,
            hasBaseType: typeDef.hasBaseType,
            isNested: typeDef.isNested,
            attributes: typeDef.attributes,
            customAttributes: typeDef.customAttributes,
            fields: ArrayList<FieldRecord>(),
            interfaceImplementations: typeDef.interfaceImplementations,
            layout: typeDef.layout,
            methods: seededMethods,
            nestedTypes: ArrayList<TypeDefinitionRecord>(),
            genericParameters: typeDef.genericParameters,
            events: seededEvents,
            properties: seededProperties,
            supportedArchitectures: typeDef.supportedArchitectures,
            supportedOsPlatform: typeDef.supportedOsPlatform,
            isExperimental: typeDef.isExperimental,
            sourceSet: typeDef.sourceSet
        )
        let saved = minimalInterfaceTruncation
        minimalInterfaceTruncation = false
        let seededDeps = typeDependencies(seededTypeDef, record.fullName)
        minimalInterfaceTruncation = saved
        for (dependency in seededDeps) {
            addUnique(dependencies, dependency)
        }
    }
    sortStrings(dependencies)
    // The interface itself is unchanged (full vtable); only its dependency list is
    // narrowed, so re-attach the original typeDef.
    return SymbolRecord(
        record.fullName,
        record.namespace,
        record.name,
        record.implName,
        dependencies,
        implSource: record.implSource,
        metadataToken: record.metadataToken,
        typeDef: Some(typeDef)
    )
}

func filterFieldsBySelectionRules(
    fields: ArrayList<FieldRecord>,
    containerFullName: String,
    filters: ArrayList<String>
): ArrayList<FieldRecord> {
    let selected = ArrayList<FieldRecord>()
    for (field in fields) {
        if (selectionRulesIncludeMember(filters, containerFullName, field.name)) {
            selected.add(field)
        }
    }
    return selected
}

// Names a method can be referenced by in a `Type.member` filter rule: its raw
// metadata name (an accessor like `get_Flyout` / `put_Padding` / `add_Click`, or
// a plain method like `SetPresenter`) plus, for an overloaded WinRT method, its
// OverloadAttribute projection name (the friendly name the renderer surfaces,
// e.g. raw `SetPresenter` -> `SetPresenterByKind`). The reference projection's
// member rules use whichever name the renderer emits, so a filter must accept
// both. Accessors and non-overloaded methods carry no honored overload name, so
// only the raw name is added for them — the accessor prefix is preserved (this is
// NOT the prefix-stripped projected base name used for the rendered identifier).
func methodFilterNames(method: MethodRecord): ArrayList<String> {
    let names = ArrayList<String>()
    names.add(method.name)
    match (methodOverloadProjectionName(method)) {
        case Some(name) =>
            if (name != method.name) {
                names.add(name)
            }
        case None => ()
    }
    return names
}

func selectionRulesIncludeMethod(
    rules: ArrayList<String>,
    containerFullName: String,
    method: MethodRecord
): Bool {
    for (name in methodFilterNames(method)) {
        if (selectionRulesIncludeMember(rules, containerFullName, name)) {
            return true
        }
    }
    return false
}

func filterPropertiesBySelectionRules(
    properties: ArrayList<PropertyRecord>,
    containerFullName: String,
    filters: ArrayList<String>
): ArrayList<PropertyRecord> {
    let selected = ArrayList<PropertyRecord>()
    for (property in properties) {
        if (selectionRulesIncludeProperty(filters, containerFullName, property)) {
            selected.add(property)
        }
    }
    return selected
}

// Names a property can be referenced by in a `Type.member` filter rule: its
// projected property name (e.g. `Flyout`) plus its raw accessor method names
// (`get_Flyout` / `put_Flyout`). A WinRT property is rendered as a Cangjie `prop`
// from the property RECORD, not from the standalone accessor methods (those are
// SpecialName methods the renderer skips), so a member rule written against the
// accessor name — which is how the reference projection lists property members —
// must keep the property record itself, or the rendered `prop` is lost entirely.
func propertyFilterNames(property: PropertyRecord): ArrayList<String> {
    let names = ArrayList<String>()
    names.add(property.name)
    names.add(runtimeAccessorMethodName(property.accessors, "Getter") ?? "get_${property.name}")
    names.add(runtimeAccessorMethodName(property.accessors, "Setter") ?? "put_${property.name}")
    return names
}

func selectionRulesIncludeProperty(
    rules: ArrayList<String>,
    containerFullName: String,
    property: PropertyRecord
): Bool {
    for (name in propertyFilterNames(property)) {
        if (selectionRulesIncludeMember(rules, containerFullName, name)) {
            return true
        }
    }
    return false
}

func filterEventsBySelectionRules(
    events: ArrayList<EventRecord>,
    containerFullName: String,
    filters: ArrayList<String>
): ArrayList<EventRecord> {
    let selected = ArrayList<EventRecord>()
    for (event in events) {
        if (selectionRulesIncludeEvent(filters, containerFullName, event)) {
            selected.add(event)
        }
    }
    return selected
}

// Names an event can be referenced by: its projected name (e.g. `Click`) plus its
// raw accessor method names (`add_Click` / `remove_Click`). Same rationale as
// propertyFilterNames — events render from the event RECORD, and the reference
// projection lists event members by their `add_`/`remove_` accessor names.
func eventFilterNames(event: EventRecord): ArrayList<String> {
    let names = ArrayList<String>()
    names.add(event.name)
    names.add(runtimeAccessorMethodName(event.accessors, "Adder") ?? "add_${event.name}")
    names.add(runtimeAccessorMethodName(event.accessors, "Remover") ?? "remove_${event.name}")
    return names
}

func selectionRulesIncludeEvent(
    rules: ArrayList<String>,
    containerFullName: String,
    event: EventRecord
): Bool {
    for (name in eventFilterNames(event)) {
        if (selectionRulesIncludeMember(rules, containerFullName, name)) {
            return true
        }
    }
    return false
}

func featureRulesIncludeRecord(features: ArrayList<String>, record: SymbolRecord): Bool {
    for (feature in features) {
        if (featureRuleMatchesRecord(feature, record)) {
            return true
        }
    }
    return false
}

func featureRuleMatchesRecord(feature: String, record: SymbolRecord): Bool {
    if (feature == "all") {
        return true
    }
    return record.fullName == feature || record.namespace == feature
}

func selectionRulesIncludeRecord(rules: ArrayList<String>, record: SymbolRecord): Bool {
    var included = false
    var excluded = false
    for (rule in rules) {
        if (selectionRuleMatchesRecord(rule, record)) {
            if (selectionRuleIsExclude(rule)) {
                excluded = true
            } else {
                included = true
            }
        }
    }
    return included && !excluded
}

func selectionRulesExcludeRecord(rules: ArrayList<String>, record: SymbolRecord): Bool {
    for (rule in rules) {
        if (selectionRuleIsExclude(rule) && selectionRuleMatchesRecord(rule, record)) {
            return true
        }
    }
    return false
}

func selectionRulesIncludeMember(rules: ArrayList<String>, containerFullName: String, memberName: String): Bool {
    var included = false
    var excluded = false
    for (rule in rules) {
        if (selectionRuleMatchesMember(rule, containerFullName, memberName)) {
            if (selectionRuleIsExclude(rule)) {
                excluded = true
            } else {
                included = true
            }
        }
    }
    return included && !excluded
}

func selectionRuleMatchesMember(rule: String, containerFullName: String, memberName: String): Bool {
    return selectionPatternMatchesMember(selectionRulePattern(rule), containerFullName, memberName)
}

func selectionRuleIsExclude(rule: String): Bool {
    return startsWithString(rule, "!")
}

func selectionRulePattern(rule: String): String {
    if (!selectionRuleIsExclude(rule)) {
        return rule
    }
    let bytes = rule.toArray()
    if (bytes.size <= 1) {
        return ""
    }
    return String.fromUtf8(bytes[1..Int64(bytes.size)])
}

func selectionRuleMatchesRecord(rule: String, record: SymbolRecord): Bool {
    return selectionPatternMatchesRecord(selectionRulePattern(rule), record)
}

func selectionPatternMatchesRecord(pattern: String, record: SymbolRecord): Bool {
    if (pattern == "all") {
        return true
    }
    if (stringContainsByte(pattern, b'*')) {
        return wildcardMatchesString(pattern, record.fullName) ||
            wildcardMatchesString(pattern, record.namespace) ||
            wildcardMatchesString(pattern, record.name) ||
            selectionPatternMatchesRecordMember(pattern, record)
    }
    if (record.fullName == pattern || record.name == pattern || selectionPatternMatchesRecordMember(pattern, record)) {
        return true
    }
    return namespaceMatchesPrefix(record.namespace, pattern)
}

func selectionPatternMatchesRecordMember(pattern: String, record: SymbolRecord): Bool {
    // Fast reject: a dotted, non-wildcard member pattern `Container.member` can
    // only match a member whose full name `record.fullName + "." + memberName`
    // equals the pattern. A member name is a bare identifier and never contains a
    // dot, so for a dotted pattern the `memberName == pattern` branch is always
    // false — the pattern can match a member of THIS record only if record.fullName
    // is the pattern's container prefix. A whole-type pattern that equals
    // record.fullName is already resolved by the caller before this point, so
    // skipping the per-member scan for every unrelated record is semantics-
    // preserving and turns an O(records × rules × members) sweep into
    // O(records × rules) for the non-matching majority.
    if (!stringContainsByte(pattern, b'*') && stringContainsByte(pattern, b'.')) {
        if (!startsWithString(pattern, "${record.fullName}.")) {
            return false
        }
    }
    match (record.typeDef) {
        case Some(typeDef) =>
            for (field in typeDef.fields) {
                if (selectionPatternMatchesMember(pattern, record.fullName, field.name)) {
                    return true
                }
            }
            for (method in typeDef.methods) {
                for (name in methodFilterNames(method)) {
                    if (selectionPatternMatchesMember(pattern, record.fullName, name)) {
                        return true
                    }
                }
            }
            for (property in typeDef.properties) {
                for (name in propertyFilterNames(property)) {
                    if (selectionPatternMatchesMember(pattern, record.fullName, name)) {
                        return true
                    }
                }
            }
            for (event in typeDef.events) {
                for (name in eventFilterNames(event)) {
                    if (selectionPatternMatchesMember(pattern, record.fullName, name)) {
                        return true
                    }
                }
            }
        case None => ()
    }
    return false
}

func selectionPatternMatchesMember(pattern: String, containerFullName: String, memberName: String): Bool {
    let memberFullName = "${containerFullName}.${memberName}"
    if (stringContainsByte(pattern, b'*')) {
        return wildcardMatchesString(pattern, memberName) || wildcardMatchesString(pattern, memberFullName)
    }
    return memberName == pattern || memberFullName == pattern
}

func namespaceMatchesPrefix(namespace: String, prefix: String): Bool {
    if (namespace == prefix) {
        return true
    }
    return startsWithString(namespace, "${prefix}.")
}

func wildcardMatchesString(pattern: String, value: String): Bool {
    return wildcardMatchesBytes(pattern.toArray(), 0, value.toArray(), 0)
}

func wildcardMatchesBytes(pattern: Array<Byte>, patternIndex: Int64, value: Array<Byte>, valueIndex: Int64): Bool {
    if (patternIndex == Int64(pattern.size)) {
        return valueIndex == Int64(value.size)
    }
    if (pattern[patternIndex] == b'*') {
        var nextPatternIndex = patternIndex
        while (nextPatternIndex < Int64(pattern.size) && pattern[nextPatternIndex] == b'*') {
            nextPatternIndex += 1
        }
        if (nextPatternIndex == Int64(pattern.size)) {
            return true
        }
        var nextValueIndex = valueIndex
        while (nextValueIndex <= Int64(value.size)) {
            if (wildcardMatchesBytes(pattern, nextPatternIndex, value, nextValueIndex)) {
                return true
            }
            nextValueIndex += 1
        }
        return false
    }
    if (valueIndex >= Int64(value.size)) {
        return false
    }
    if (pattern[patternIndex] != value[valueIndex]) {
        return false
    }
    return wildcardMatchesBytes(pattern, patternIndex + 1, value, valueIndex + 1)
}

func stringContainsByte(value: String, needle: Byte): Bool {
    let bytes = value.toArray()
    var i: Int64 = 0
    while (i < Int64(bytes.size)) {
        if (bytes[i] == needle) {
            return true
        }
        i += 1
    }
    return false
}

func selectedNamespaces(symbols: ArrayList<SymbolRecord>): ArrayList<String> {
    let namespaces = ArrayList<String>()
    for (symbol in symbols) {
        addUnique(namespaces, symbol.namespace)
    }
    sortStrings(namespaces)
    return namespaces
}

func renderCjpmToml(packageName: String, supportDeps!: ArrayList<String> = ArrayList<String>()): String {
    let dependencyPrefix = generatedPackageDependencyPrefix(packageName)
    let effectiveSupportDeps = ArrayList<String>()
    for (dependency in supportDeps) {
        addUnique(effectiveSupportDeps, dependency)
    }
    if (packageName == "windows_sys") {
        addUnique(effectiveSupportDeps, "windows_libloading")
    }
    let linkOptions = collectSupportLinkOptions(effectiveSupportDeps)
    var content = "[package]\n" +
        "  name = \"${packageName}\"\n" +
        "  version = \"0.1.0\"\n" +
        "  description = \"Generated Windows API support symbols for Cangjie\"\n" +
        "  output-type = \"static\"\n" +
        "  cjc-version = \"1.1.0\"\n" +
        "  compile-option = \"-Woff unused\"\n"
    if (!linkOptions.isEmpty()) {
        content += "  link-option = \"${joinStrings(linkOptions, " ")}\"\n"
    }
    if (!effectiveSupportDeps.isEmpty()) {
        content += "\n[dependencies]\n"
        content += renderStableDependencyLines(dependencyPrefix, effectiveSupportDeps)
    }
    return content
}

func generatedPackageDependencyPrefix(packageName: String): String {
    if (packageName == "windows_sys") {
        return ".."
    }
    return "../.."
}

func writeCommonNativeHelperFiles(
    writer: GeneratedPackageWriter,
    files: ArrayList<GeneratedNativeHelperFile>
): Unit {
    for (file in files) {
        writer.writeFile(file.relativePath, file.content)
    }
}

func collectSupportDependencyNames(
    packageName: String,
    symbols: ArrayList<SymbolRecord>,
    symbolsByName: HashMap<String, SymbolRecord>
): ArrayList<String> {
    return collectSupportDependencyNames(packageName, symbols, symbolsByName, RenderOptions.defaults())
}

func collectSupportDependencyNames(
    packageName: String,
    symbols: ArrayList<SymbolRecord>,
    symbolsByName: HashMap<String, SymbolRecord>,
    options: RenderOptions
): ArrayList<String> {
    let dependencies = ArrayList<String>()
    for (symbol in symbols) {
        let source = renderImplSource(symbol, symbolsByName, options)
        collectSupportDependencyNamesFromSource(packageName, dependencies, source)
    }
    return dependencies
}

func writeImplFiles(
    writer: GeneratedPackageWriter,
    symbols: ArrayList<SymbolRecord>,
    packageName: String,
    symbolsByName: HashMap<String, SymbolRecord>
): Unit {
    writeImplFiles(writer, symbols, packageName, symbolsByName, RenderOptions.defaults())
}

func writeImplFiles(
    writer: GeneratedPackageWriter,
    symbols: ArrayList<SymbolRecord>,
    packageName: String,
    symbolsByName: HashMap<String, SymbolRecord>,
    options: RenderOptions
): Unit {
    // Derive a self-contained dependency graph from the symbol set so the
    // (test/standalone) callers that omit one still get correct cross-impl
    // imports between the per-namespace subpackages.
    let deps = computeNamespaceDependencies(symbols, symbolsByName)
    let implNameToNamespace = buildImplNameToNamespace(symbols)
    for (symbol in symbols) {
        augmentNamespaceDependenciesFromSource(
            deps,
            symbol.namespace,
            renderImplSource(symbol, symbolsByName, options),
            implNameToNamespace
        )
    }
    sortNamespaceDependencyBuckets(deps)
    writeImplFiles(writer, symbols, packageName, symbolsByName, deps, options)
}

// Write the impl package as one subpackage per namespace.
//
// The impl monolith is split so a consumer enabling only a few namespaces
// compiles (and, once the build tool skips disabled subpackages, parses) only the
// impl subpackages it needs. Symbols are grouped by namespace (order within a
// group preserved; namespaces emitted in sorted order for stable output) and each
// group is chunked at 512 symbols into `src/impl/<ns_var>/symbols_<i>.cj` with
// package `<packageName>.impl.<ns_var>`. The helper-import flags are detected per
// subpackage (scoped to that namespace's body). Because the split puts a
// referencing symbol and its referent in different packages, each subpackage also
// emits gated wildcard imports of every impl subpackage it depends on
// (`namespaceDeps`); these are cyclic across siblings and rely on circular
// subpackage compilation support.
func writeImplFiles(
    writer: GeneratedPackageWriter,
    symbols: ArrayList<SymbolRecord>,
    packageName: String,
    symbolsByName: HashMap<String, SymbolRecord>,
    namespaceDeps: HashMap<String, ArrayList<String>>,
    options: RenderOptions
): Unit {
    setActiveReferences(options.references)
    let extraImports = ArrayList<String>()
    for (stage in options.references) {
        if (stage.name != packageName) {
            addUnique(extraImports, stage.name)
        }
    }

    // Group symbols by namespace, preserving first-seen symbol order within each
    // group. The namespace key order is tracked separately because HashMap does
    // not preserve insertion order; the group list is sorted before emission so
    // file output is deterministic.
    let groups = HashMap<String, ArrayList<SymbolRecord>>()
    let orderedNamespaces = ArrayList<String>()
    for (symbol in symbols) {
        let bucket = match (groups.get(symbol.namespace)) {
            case Some(existing) => existing
            case None =>
                let fresh = ArrayList<SymbolRecord>()
                groups.add(symbol.namespace, fresh)
                orderedNamespaces.add(symbol.namespace)
                fresh
        }
        bucket.add(symbol)
    }
    sortStrings(orderedNamespaces)

    for (namespace in orderedNamespaces) {
        let groupSymbols = match (groups.get(namespace)) {
            case Some(found) => found
            case None => ArrayList<SymbolRecord>()
        }
        let nv = namespaceToCfgVar(namespace)
        let implSubpackage = implSubpackageName(packageName, namespace)
        let directory = implSubpackageDirectory(namespace)
        let crossImplImports = renderCrossImplImports(
            packageName,
            namespace,
            match (namespaceDeps.get(namespace)) {
                case Some(found) => found
                case None => ArrayList<String>()
            }
        )
        writeImplSubpackage(writer, groupSymbols, packageName, implSubpackage, directory, crossImplImports, extraImports, symbolsByName, options)
    }
    clearActiveReferences()
}

// Emit one namespace's impl subpackage: chunk its symbols at 512 into
// `<directory>/symbols_<i>.cj`, each file declaring `package <implSubpackage>` and
// the helper/cross-impl imports its body needs.
func writeImplSubpackage(
    writer: GeneratedPackageWriter,
    symbols: ArrayList<SymbolRecord>,
    packageName: String,
    implSubpackage: String,
    directory: String,
    crossImplImports: String,
    extraImports: ArrayList<String>,
    symbolsByName: HashMap<String, SymbolRecord>,
    options: RenderOptions
): Unit {
    var chunkIndex: Int64 = 0
    var count: Int64 = 0
    var body = ""
    var importsPolyfill = false
    var importsCore = false
    var importsLibloading = false
    var importsInterfacePackage = false
    var importsInterfaceGuid = false
    var importsInterfaceMacros = false
    var importsStrings = false
    for (symbol in symbols) {
        let rendered = renderGatedImplSource(symbol, symbolsByName, options)
        if (rendered.contains("windows_polyfill.")) {
            importsPolyfill = true
        }
        if (rendered.contains("windows_core.")) {
            importsCore = true
        }
        if (rendered.contains("windows_libloading.")) {
            importsLibloading = true
        }
        if (rendered.contains("windows_interface.")) {
            importsInterfacePackage = true
        }
        if (implChunkNeedsGuidImport(rendered)) {
            importsInterfaceGuid = true
        }
        if (rendered.contains("@Interface[")) {
            importsInterfaceMacros = true
        }
        if (rendered.contains("windows_strings.")) {
            importsStrings = true
        }
        body += rendered
        body += "\n\n"
        count += 1
        if (count >= 512) {
            writer.writeFile("${directory}/symbols_${chunkIndex}.cj", renderImplChunk(implSubpackage, body, crossImplImports, importsPolyfill, importsCore, importsLibloading, importsInterfacePackage, importsInterfaceGuid, importsInterfaceMacros, importsStrings, extraImports))
            chunkIndex += 1
            count = 0
            body = ""
            importsPolyfill = false
            importsCore = false
            importsLibloading = false
            importsInterfacePackage = false
            importsInterfaceGuid = false
            importsInterfaceMacros = false
            importsStrings = false
        }
    }
    if (count > 0) {
        writer.writeFile("${directory}/symbols_${chunkIndex}.cj", renderImplChunk(implSubpackage, body, crossImplImports, importsPolyfill, importsCore, importsLibloading, importsInterfacePackage, importsInterfaceGuid, importsInterfaceMacros, importsStrings, extraImports))
    }
}

func implChunkNeedsGuidImport(rendered: String): Bool {
    rendered.contains(": GUID") ||
    rendered.contains("-> GUID") ||
    rendered.contains("<GUID") ||
    rendered.contains("GUID>") ||
    rendered.contains("VArray<GUID") ||
    // A bare `GUID` as a function-pointer parameter (e.g. a vtable method
    // `CFunc<(CPointer<Unit>, GUID, CPointer<Unit>) -> Int32>`) is delimited by
    // `, ` or `(`, not by the patterns above. These cannot match the qualified
    // `windows_interface.GUID` (a `.` precedes GUID there), so no false positives.
    rendered.contains(", GUID") ||
    rendered.contains("(GUID")
}

// Render one impl subpackage source file. `implSubpackage` is the full package
// name (`<packageName>.impl.<ns_var>`). `crossImplImports` is the pre-rendered,
// gated wildcard-import block bringing sibling impl subpackages this namespace
// depends on into scope; it is emitted after the helper imports and before the
// body so cross-namespace references resolve.
func renderImplChunk(
    implSubpackage: String,
    body: String,
    crossImplImports: String,
    importsPolyfill: Bool,
    importsCore: Bool,
    importsLibloading: Bool,
    importsInterfacePackage: Bool,
    importsInterfaceGuid: Bool,
    importsInterfaceMacros: Bool,
    importsStrings: Bool,
    extraImports: ArrayList<String>
): String {
    var content = "package ${implSubpackage}\n\n"
    if (importsCore || importsInterfaceMacros) {
        content += "import windows_core as windows_core\n"
    }
    if (importsInterfaceGuid) {
        content += "import windows_interface.GUID\n"
    }
    if (importsInterfacePackage || importsInterfaceMacros) {
        content += "import windows_interface as windows_interface\n"
    }
    if (importsInterfaceMacros) {
        content += "import windows_interface.IInspectable\n"
        content += "import windows_interface.macros.Interface\n"
    }
    if (importsPolyfill) {
        content += "import windows_polyfill as windows_polyfill\n"
    }
    if (importsLibloading) {
        content += "import windows_libloading as windows_libloading\n"
    }
    if (importsStrings) {
        content += "import windows_strings as windows_strings\n"
    }
    var addedExtra = false
    for (extra in extraImports) {
        if (body.contains("${extra}.")) {
            content += "import ${extra} as ${extra}\n"
            addedExtra = true
        }
    }
    if (importsCore || importsPolyfill || importsLibloading || importsInterfacePackage ||
        importsInterfaceGuid || importsInterfaceMacros || importsStrings || addedExtra) {
        content += "\n"
    }
    content += crossImplImports
    if (!crossImplImports.isEmpty()) {
        content += "\n"
    }
    content += body
    return content
}

func renderImplSource(symbol: SymbolRecord, symbolsByName: HashMap<String, SymbolRecord>): String {
    return renderSymbolImpl(symbol, symbolsByName, RenderOptions.defaults())
}

func renderImplSource(
    symbol: SymbolRecord,
    symbolsByName: HashMap<String, SymbolRecord>,
    options: RenderOptions
): String {
    return renderSymbolImpl(symbol, symbolsByName, options)
}

// Render a symbol's impl source with the per-namespace `@When` gate structurally
// prefixed before every top-level declaration. The gate is computed once from the
// symbol's namespace (the same derivation used by the facade re-exports and the
// per-package cfg.toml, keeping them consistent) and threaded into the renderers,
// which emit it at each declaration boundary. This is the gated counterpart of
// renderImplSource used when writing the impl package files.
func renderGatedImplSource(
    symbol: SymbolRecord,
    symbolsByName: HashMap<String, SymbolRecord>,
    options: RenderOptions
): String {
    // Render the declaration with its short, package-scoped name (the nested
    // namespace package supplies the qualification the flat name used to carry),
    // and resolve every type reference through the namespace-aware path so a
    // same-namespace reference is short and a cross-namespace reference is
    // `<ns_var>.<short>`, matching the alias imports the writer emits.
    setNamespaceAwareRendering(symbol.namespace, symbolsByName)
    var rendered = renderSymbolImplWithGate(
        shortNameSymbol(symbol),
        symbolsByName,
        options,
        TargetAbiOptions.defaults(),
        gatePrefix(symbol.namespace)
    )
    clearNamespaceAwareRendering()
    return rendered
}

// A view of the symbol whose impl name is its short, package-scoped name. In the
// nested-package layout the declaration lives directly in `windows_sys.<NsPath>`,
// so it is emitted under its short name (e.g. `BasicProperties`) rather than the
// globally-flat `Windows_Storage_FileProperties_BasicProperties`.
func shortNameSymbol(symbol: SymbolRecord): SymbolRecord {
    return SymbolRecord(
        symbol.fullName,
        symbol.namespace,
        symbol.name,
        symbol.name,
        symbol.dependencies,
        implSource: symbol.implSource,
        metadataToken: symbol.metadataToken,
        typeDef: symbol.typeDef
    )
}

func writeFacadeFiles(
    writer: GeneratedPackageWriter,
    namespace: String,
    symbols: ArrayList<SymbolRecord>,
    packageName: String
): Unit {
    let namespaceDir = namespaceToDirectory(namespace)
    var chunkIndex: Int64 = 0
    var count: Int64 = 0
    var importNames = ArrayList<String>()
    var aliases = ""
    // Every symbol in a facade chunk shares the facade's namespace, so the whole
    // chunk (imports + aliases) is gated by that one namespace cfg variable. When
    // it is "off", the re-exports and their impl imports are both removed, so no
    // dangling import of a gated-off impl declaration remains.
    let gate = cfgGateAnnotation(namespace)
    for (symbol in symbols) {
        if (symbol.namespace == namespace) {
            addUnique(importNames, symbol.implName)
            aliases += renderFacadeAlias(symbol, gate)
            match (symbol.typeDef) {
                case Some(typeDef) =>
                    if (isInterfaceType(typeDef)) {
                        match (guidAttributeLiteral(typeDef)) {
                            case Some(_) =>
                                addUnique(importNames, "${symbol.implName}Vtbl")
                                aliases += "${gate}\npublic type ${symbol.name}Vtbl = ${symbol.implName}Vtbl\n"
                            case None => ()
                        }
                    }
                case None => ()
            }
            count += 1
            if (count >= 512) {
                writer.writeFile(
                    "${namespaceDir}/facade_${chunkIndex}.cj",
                    renderFacadeContent(namespace, packageName, importNames, aliases, gate)
                )
                chunkIndex += 1
                count = 0
                importNames = ArrayList<String>()
                aliases = ""
            }
        }
    }
    if (count > 0) {
        writer.writeFile(
            "${namespaceDir}/facade_${chunkIndex}.cj",
            renderFacadeContent(namespace, packageName, importNames, aliases, gate)
        )
    }
}

func renderFacadeAlias(symbol: SymbolRecord, gate: String): String {
    match (symbol.typeDef) {
        case Some(typeDef) =>
            let genericNames = genericParameterNames(typeDef)
            if (!genericNames.isEmpty()) {
                let genericParams = genericParameterList(genericNames)
                return "${gate}\npublic type ${symbol.name}${genericParams} = ${symbol.implName}${genericParams}\n"
            }
        case None => ()
    }
    return "${gate}\npublic type ${symbol.name} = ${symbol.implName}\n"
}

func renderFacadeContent(
    namespace: String,
    packageName: String,
    importNames: ArrayList<String>,
    aliases: String,
    gate: String
): String {
    var content = "package ${namespaceToPackage(namespace, packageName)}\n\n"
    // Every symbol re-exported by this facade belongs to `namespace`, so it lives
    // in that namespace's impl subpackage (`<packageName>.impl.<ns_var>`); import
    // the type aliases from there rather than the (now-split) monolithic impl.
    content += renderFacadeImplImports(implSubpackageName(packageName, namespace), importNames, gate)
    content += "\n"
    content += aliases
    return content
}

func renderFacadeImplImports(implSubpackage: String, importNames: ArrayList<String>, gate: String): String {
    // Import the whole impl subpackage with a single gated wildcard. The explicit
    // `import subpkg.{Sym1, Sym2, ...}` form concatenates the (now namespace-
    // qualified, hence long) impl subpackage name with each mangled symbol name,
    // and cjc's import parser computes a combined-length bound that the longest
    // Win32 anonymous-aggregate mangled names overflow. A wildcard avoids the
    // concatenation entirely; the facade's `public type` aliases resolve the
    // mangled names brought into scope, and impl names are globally unique so the
    // wildcard introduces no clashes. The gate keeps the import removed when the
    // namespace is off (no dangling import of gated-off declarations).
    var content = ""
    if (!importNames.isEmpty()) {
        content += "${gate}\nimport ${implSubpackage}.*\n"
    }
    return content
}

func renderManifest(
    features: ArrayList<String>,
    symbols: ArrayList<SymbolRecord>,
    files: ArrayList<String>,
    fileHashes: HashMap<String, String>,
    packageName: String
): String {
    sortStrings(files)
    let names = ArrayList<String>()
    for (symbol in symbols) {
        names.add(symbol.fullName)
    }
    sortStrings(names)
    return "{\n" +
        "  \"generated_by\": \"${jsonEscape(GENERATED_FILE_MARKER)}\",\n" +
        "  \"package_name\": \"${jsonEscape(packageName)}\",\n" +
        "  \"requested_features\": ${jsonStringArray(features)},\n" +
        "  \"selected_symbols\": ${jsonStringArray(names)},\n" +
        "  \"files\": ${jsonStringArray(files)},\n" +
        "  \"file_hashes\": ${jsonStringMap(files, fileHashes)}\n" +
        "}\n"
}

func jsonStringMap(keys: ArrayList<String>, values: HashMap<String, String>): String {
    if (keys.isEmpty()) {
        return "{}"
    }
    var content = "{\n"
    var index: Int64 = 0
    while (index < Int64(keys.size)) {
        let key = keys[index]
        let value = match (values.get(key)) {
            case Some(found) => found
            case None => throw Exception("missing JSON string map value for ${key}")
        }
        content += "    \"${jsonEscape(key)}\": \"${jsonEscape(value)}\""
        if (index + 1 < Int64(keys.size)) {
            content += ","
        }
        content += "\n"
        index += 1
    }
    content + "  }"
}

func namespaceToPackage(namespace: String, packageName: String): String {
    let parts = namespacePartsWithoutRoot(namespace)
    if (parts.isEmpty()) {
        return packageName
    }
    return "${packageName}.${joinStrings(parts, ".")}"
}

func namespaceToRelativePath(namespace: String): String {
    return "${namespaceToDirectory(namespace)}/mod.cj"
}

func namespaceToDirectory(namespace: String): String {
    let parts = namespacePartsWithoutRoot(namespace)
    if (parts.isEmpty()) {
        return "src"
    }
    return "src/${joinStrings(parts, "/")}"
}

func writeIntermediateNamespaceModules(
    writer: GeneratedPackageWriter,
    namespaces: ArrayList<String>,
    packageName: String
): Unit {
    let written = ArrayList<String>()
    for (namespace in namespaces) {
        let parts = namespacePartsWithoutRoot(namespace)
        var count: Int64 = 1
        while (count < Int64(parts.size)) {
            let relativePath = "src/${joinFirstStrings(parts, count, "/")}/mod.cj"
            if (!contains(written, relativePath)) {
                writer.writeFile(relativePath, "package ${packageName}.${joinFirstStrings(parts, count, ".")}\n")
                written.add(relativePath)
            }
            count += 1
        }
    }
}

func namespacePartsWithoutRoot(namespace: String): ArrayList<String> {
    let parts = splitString(namespace, b'.')
    let result = ArrayList<String>()
    var i: Int64 = 0
    if (!parts.isEmpty() && parts[0] == "Windows") {
        i = 1
    }
    while (i < Int64(parts.size)) {
        result.add(parts[i])
        i += 1
    }
    return result
}

func printFeatures(records: ArrayList<SymbolRecord>): Unit {
    printUsage()
    println("")
    println("Available features:")
    println("  all")
    for (feature in featureNamesFromRecords(records)) {
        println("  ${feature}")
    }
}

func printUsage(): Unit {
    println(usageText())
}

func usageText(): String {
    return "windows_bindgen CLI\n" +
        "Usage: windows_bindgen [--input-json <winmd.json>] [--input-json more.json] [--input-dir <json-dir>] [--common]\n" +
        "               [metadata.json | json-dir | default | metadata.winmd | winmd-dir]\n" +
        "               [--support-package-dir <dir>] [--feature <namespace|all>] [--filter <rule>]\n" +
        "               [--out .generated/windows] [--package-name <name>] [--clean] [--dry-run] [--print-link-options]\n" +
        "               [--sys] [--implement] [--no-comment] [--derive <list>] [--reference <spec>]\n" +
        "\n" +
        "Input detail:\n" +
        "  --input-json <file>  Load an already converted WinMD JSON file.\n" +
        "  --input-dir <dir>    Load all .json files from a directory, sorted by file name.\n" +
        "  metadata.json        Positional shorthand for --input-json metadata.json.\n" +
        "  json-dir             Positional shorthand for --input-dir json-dir when the directory contains .json files.\n" +
        "  metadata.winmd/dir   Parsed natively by the built-in Cangjie .winmd reader; a .winmd directory loads every .winmd it contains.\n" +
        "  default              Native parsing of embedded WinMD resources, falling back to bundled metadata under winmd or ../winmd.\n" +
        "\n" +
        "Flag detail:\n" +
        "  --sys             Generate raw sys-style bindings only (no ergonomic throws wrappers).\n" +
        "  --package-name    Override the generated package name, e.g. raw_slice for raw sys-style bindings.\n" +
        "  --implement       Emit interface_Impl trait for @Implement consumers (WinRT interfaces).\n" +
        "  --no-comment      Suppress 'Generated by windows_bindgen. DO NOT EDIT.' file headers.\n" +
        "  --derive <list>   Comma-separated helper traits: guid_access (struct GUID() helper), flags_ops (toggle/intersect/union/difference/symmetric_difference on Flags enums). Unknown names accepted for forward compatibility.\n" +
        "  --reference <s>   <pkg>,<style>,<namespace> - types matching are imported, not regenerated.\n" +
        "                    style is one of flat|full|skip-root.\n" +
        "\n" +
        "Skipped compatibility flags (no Cangjie equivalent or already implicit):\n" +
        "  --rustfmt / --no-allow         Cangjie has no rustfmt or #[allow] equivalent.\n" +
        "  --no-deps / --no-toml          manifest.json + auto deps closure replace these.\n" +
        "  --link                         Cangjie resolves dlls via LoadLibrary at runtime.\n" +
        "  --sys-fn-ptrs / --sys-fn-extern  cjc has no raw-dylib; all PInvoke is dynamic dispatch.\n" +
        "  --package / --specific-deps    --common + auto support-deps closure cover this.\n" +
        "  --index                        Dependency closure auto-computed; no separate index file."
}

func addUnique(values: ArrayList<String>, value: String): Unit {
    if (!contains(values, value)) {
        values.add(value)
    }
}

func copyStrings(values: ArrayList<String>): Array<String> {
    Array<String>(values.size, { index => values[index] })
}

func contains(values: ArrayList<String>, value: String): Bool {
    for (item in values) {
        if (item == value) {
            return true
        }
    }
    return false
}

func startsWithString(value: String, prefix: String): Bool {
    let bytes = value.toArray()
    let prefixBytes = prefix.toArray()
    if (prefixBytes.size > bytes.size) {
        return false
    }
    var i: Int64 = 0
    while (i < Int64(prefixBytes.size)) {
        if (bytes[i] != prefixBytes[i]) {
            return false
        }
        i += 1
    }
    return true
}

func endsWithString(value: String, suffix: String): Bool {
    let bytes = value.toArray()
    let suffixBytes = suffix.toArray()
    if (suffixBytes.size > bytes.size) {
        return false
    }
    let start = Int64(bytes.size) - Int64(suffixBytes.size)
    var i: Int64 = 0
    while (i < Int64(suffixBytes.size)) {
        if (bytes[start + i] != suffixBytes[i]) {
            return false
        }
        i += 1
    }
    return true
}

func endsWithAsciiIgnoreCase(value: String, suffix: String): Bool {
    let bytes = value.toArray()
    let suffixBytes = suffix.toArray()
    if (suffixBytes.size > bytes.size) {
        return false
    }
    let start = Int64(bytes.size) - Int64(suffixBytes.size)
    var i: Int64 = 0
    while (i < Int64(suffixBytes.size)) {
        if (asciiLowerByte(bytes[start + i]) != asciiLowerByte(suffixBytes[i])) {
            return false
        }
        i += 1
    }
    return true
}

func equalsAsciiIgnoreCase(left: String, right: String): Bool {
    let leftBytes = left.toArray()
    let rightBytes = right.toArray()
    if (leftBytes.size != rightBytes.size) {
        return false
    }
    var i: Int64 = 0
    while (i < Int64(leftBytes.size)) {
        if (asciiLowerByte(leftBytes[i]) != asciiLowerByte(rightBytes[i])) {
            return false
        }
        i += 1
    }
    return true
}

func asciiLowerByte(value: Byte): Byte {
    if (value >= b'A' && value <= b'Z') {
        return value + 32
    }
    return value
}

func sortStrings(values: ArrayList<String>): Unit {
    var i: Int64 = 1
    while (i < Int64(values.size)) {
        let value = values[i]
        var j = i - 1
        while (j >= 0 && values[j] > value) {
            values[j + 1] = values[j]
            j -= 1
        }
        values[j + 1] = value
        i += 1
    }
}

func jsonStringArray(values: ArrayList<String>): String {
    var content = "["
    var first = true
    for (value in values) {
        if (!first) {
            content += ", "
        }
        content += "\"${jsonEscape(value)}\""
        first = false
    }
    content += "]"
    return content
}

func jsonEscape(value: String): String {
    let bytes = value.toArray()
    var result = ""
    for (byte in bytes) {
        if (byte == b'\\') {
            result += "\\\\"
        } else if (byte == b'"') {
            result += "\\\""
        } else if (byte == b'\n') {
            result += "\\n"
        } else if (byte == b'\r') {
            result += "\\r"
        } else {
            result += String.fromUtf8([byte])
        }
    }
    return result
}

func directoryOf(path: String): String {
    let bytes = path.toArray()
    var lastSep: Int64 = -1
    var i: Int64 = 0
    while (i < Int64(bytes.size)) {
        if (bytes[i] == b'/' || bytes[i] == b'\\') {
            lastSep = i
        }
        i += 1
    }
    if (lastSep >= 0) {
        return String.fromUtf8(bytes[0..lastSep])
    }
    return "."
}

func ensureDir(dirPath: String): Unit {
    if (dirPath == "." || dirPath.isEmpty()) {
        return
    }
    if (directoryExists(dirPath)) {
        return
    }
    Directory.create(dirPath, recursive: true)
}

func directoryExists(path: String): Bool {
    try {
        Directory.readFrom(path)
        return true
    } catch (_: Exception) {
        return false
    }
}

func directoryContainsJsonFiles(path: String): Bool {
    let entries = Directory.readFrom(path)
    for (entry in entries) {
        if (endsWithAsciiIgnoreCase(entry.name, ".json")) {
            return true
        }
    }
    return false
}

func directoryContainsWinmdFiles(path: String): Bool {
    let entries = Directory.readFrom(path)
    for (entry in entries) {
        if (endsWithAsciiIgnoreCase(entry.name, ".winmd")) {
            return true
        }
    }
    return false
}

func splitString(value: String, sep: Byte): ArrayList<String> {
    let bytes = value.toArray()
    let result = ArrayList<String>()
    var start: Int64 = 0
    var i: Int64 = 0
    while (i < Int64(bytes.size)) {
        if (bytes[i] == sep) {
            if (i > start) {
                result.add(String.fromUtf8(bytes[start..i]))
            }
            start = i + 1
        }
        i += 1
    }
    if (start < Int64(bytes.size)) {
        result.add(String.fromUtf8(bytes[start..Int64(bytes.size)]))
    }
    return result
}

func joinStrings(values: ArrayList<String>, separator: String): String {
    var result = ""
    var first = true
    for (value in values) {
        if (!first) {
            result += separator
        }
        result += value
        first = false
    }
    return result
}

func joinFirstStrings(values: ArrayList<String>, count: Int64, separator: String): String {
    var result = ""
    var i: Int64 = 0
    while (i < count && i < Int64(values.size)) {
        if (i > 0) {
            result += separator
        }
        result += values[i]
        i += 1
    }
    return result
}
