public func IoGetOplockKeyContextEx(FileObject: CPointer<FILE_OBJECT>): CPointer<OPLOCK_KEY_CONTEXT> {
    let proc__ = CFunc<(CPointer<FILE_OBJECT>) -> CPointer<OPLOCK_KEY_CONTEXT>>(windows_libloading.resolveProc("ntoskrnl.exe", "IoGetOplockKeyContextEx"))
    return unsafe { proc__(FileObject) }
}
