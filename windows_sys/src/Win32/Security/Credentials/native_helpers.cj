    let proc__ = CFunc<(UIntNative, CPointer<UInt8>, CPointer<UInt8>, CPointer<UInt32>) -> Int32>(windows_libloading.resolveProc("WinSCard.dll", "SCardGetReaderIconA"))
    return unsafe { proc__(hContext, szReaderName.asPtr(), pbIcon, pcbIcon) }
}

