    let proc__ = CFunc<(CPointer<UInt16>, CPointer<UInt16>, CPointer<UInt16>) -> Int32>(windows_libloading.resolveProc("mqrt.dll", "MQMgmtAction"))
    return unsafe { proc__(pComputerName.asPtr(), pObjectName.asPtr(), pAction.asPtr()) }
}

@When[Windows_Win32_System_MessageQueuing == "on"]
public func MQMgmtActionChecked(pComputerName: windows_strings.PWSTR, pObjectName: windows_strings.PWSTR, pAction: windows_strings.PWSTR): windows_core.Result<Unit> {
    windows_core.HRESULT(MQMgmtAction(pComputerName, pObjectName, pAction)).ok()
}

@When[Windows_Win32_System_MessageQueuing == "on"]
public func MQMarkMessageRejected(hQueue: HANDLE, ullLookupId: UInt64): Int32 {
    let proc__ = CFunc<(CPointer<Unit>, UInt64) -> Int32>(windows_libloading.resolveProc("mqrt.dll", "MQMarkMessageRejected"))
    return unsafe { proc__(hQueue.Value, ullLookupId) }
}

@When[Windows_Win32_System_MessageQueuing == "on"]
public func MQMarkMessageRejectedChecked(hQueue: HANDLE, ullLookupId: UInt64): windows_core.Result<Unit> {
    windows_core.HRESULT(MQMarkMessageRejected(hQueue, ullLookupId)).ok()
}

@When[Windows_Win32_System_MessageQueuing == "on"]
public func MQMoveMessage(hSourceQueue: IntNative, hDestinationQueue: IntNative, ullLookupId: UInt64, pTransaction: CPointer<Unit>): Int32 {
    let proc__ = CFunc<(IntNative, IntNative, UInt64, CPointer<Unit>) -> Int32>(windows_libloading.resolveProc("mqrt.dll", "MQMoveMessage"))
    return unsafe { proc__(hSourceQueue, hDestinationQueue, ullLookupId, pTransaction) }
}

@When[Windows_Win32_System_MessageQueuing == "on"]
public func MQMoveMessageChecked(hSourceQueue: IntNative, hDestinationQueue: IntNative, ullLookupId: UInt64, pTransaction: CPointer<Unit>): windows_core.Result<Unit> {
    windows_core.HRESULT(MQMoveMessage(hSourceQueue, hDestinationQueue, ullLookupId, pTransaction)).ok()
