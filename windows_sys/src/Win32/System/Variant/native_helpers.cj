    let proc__ = CFunc<(CPointer<VARIANT>, UInt32, CPointer<Int64>) -> Int32>(windows_libloading.resolveProc("PROPSYS.dll", "VariantGetInt64Elem"))
    return unsafe { proc__(var_, iElem, pnVal) }
}

@When[Windows_Win32_System_Variant == "on"]
public func VariantGetInt64ElemChecked(var_: CPointer<VARIANT>, iElem: UInt32, pnVal: CPointer<Int64>): windows_core.Result<Unit> {
    windows_core.HRESULT(VariantGetInt64Elem(var_, iElem, pnVal)).ok()
}

