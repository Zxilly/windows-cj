    let proc__ = CFunc<() -> Int32>(windows_libloading.resolveProc("USER32.dll", "EmptyClipboard"))
    return unsafe { proc__() } != 0
}

@When[Windows_Win32_System_DataExchange == "on"]
public func EmptyClipboardChecked(): windows_core.Result<Unit> {
    if (EmptyClipboard()) {
        return windows_core.Result<Unit>.Ok(())
    }
    windows_core.Result<Unit>.Err(windows_core.errorFromThread())
}

