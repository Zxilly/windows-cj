    return unsafe { proc__(hConsoleHandle.Value, wCodePoint, cFontSize, lpSB.asPtr()) } != 0
}

@When[Windows_Win32_System_Console == "on"]
public func SetConsoleCursorMode(hConsoleHandle: HANDLE, Blink: Bool, DBEnable: Bool): Bool {
    let proc__ = CFunc<(CPointer<Unit>, Int32, Int32) -> Int32>(windows_libloading.resolveProc("KERNEL32.dll", "SetConsoleCursorMode"))
    return unsafe { proc__(hConsoleHandle.Value, if (Blink) { 1 } else { 0 }, if (DBEnable) { 1 } else { 0 }) } != 0
}

@When[Windows_Win32_System_Console == "on"]
