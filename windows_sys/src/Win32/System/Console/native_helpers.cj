    let proc__ = CFunc<(CPointer<Unit>, UInt32) -> Int32>(windows_libloading.resolveProc("KERNEL32.dll", "SetConsoleNlsMode"))
    return unsafe { proc__(hConsole.Value, fdwNlsMode) } != 0
}

