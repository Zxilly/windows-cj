@When[Windows_Win32_System_Console == "on"]
public func OpenConsoleW(lpConsoleDevice: windows_strings.PWSTR, dwDesiredAccess: UInt32, bInheritHandle: Bool, dwShareMode: UInt32): HANDLE {
    let proc__ = CFunc<(CPointer<UInt16>, UInt32, Int32, UInt32) -> CPointer<Unit>>(windows_libloading.resolveProc("KERNEL32.dll", "OpenConsoleW"))
    var result = HANDLE()
    result.Value = unsafe { proc__(lpConsoleDevice.asPtr(), dwDesiredAccess, if (bInheritHandle) { 1 } else { 0 }, dwShareMode) }
    result
}

