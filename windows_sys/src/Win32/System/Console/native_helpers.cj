@When[Windows_Win32_System_Console == "on"]
public func GetStdHandle(nStdHandle: UInt32): HANDLE {
    let proc__ = CFunc<(UInt32) -> CPointer<Unit>>(windows_libloading.resolveProc("KERNEL32.dll", "GetStdHandle"))
    var result = HANDLE()
    result.Value = unsafe { proc__(nStdHandle) }
    result
}

@When[Windows_Win32_System_Console == "on"]
public func GetStdHandleChecked(nStdHandle: UInt32): windows_core.Result<HANDLE> {
    let result__ = GetStdHandle(nStdHandle)
    if (result__.Value.isNull()) {
        return windows_core.Result<HANDLE>.Err(windows_core.errorFromThread())
    }
    windows_core.Result<HANDLE>.Ok(result__)
}

@When[Windows_Win32_System_Console == "on"]
public func SetStdHandle(nStdHandle: UInt32, hHandle: HANDLE): Bool {
    let proc__ = CFunc<(UInt32, CPointer<Unit>) -> Int32>(windows_libloading.resolveProc("KERNEL32.dll", "SetStdHandle"))
    return unsafe { proc__(nStdHandle, hHandle.Value) } != 0
}

@When[Windows_Win32_System_Console == "on"]
public func SetStdHandleChecked(nStdHandle: UInt32, hHandle: HANDLE): windows_core.Result<Unit> {
    if (SetStdHandle(nStdHandle, hHandle)) {
        return windows_core.Result<Unit>.Ok(())
    }
    windows_core.Result<Unit>.Err(windows_core.errorFromThread())
}

@When[Windows_Win32_System_Console == "on"]
public func SetStdHandleEx(nStdHandle: UInt32, hHandle: HANDLE, phPrevValue: CPointer<HANDLE>): Bool {
    let proc__ = CFunc<(UInt32, CPointer<Unit>, CPointer<CPointer<Unit>>) -> Int32>(windows_libloading.resolveProc("KERNEL32.dll", "SetStdHandleEx"))
    return unsafe { proc__(nStdHandle, hHandle.Value, CPointer<CPointer<Unit>>(phPrevValue)) } != 0
}
