        windows_core.releaseFailedComOutSlot(ppManager)
        return windows_core.Result<Unit>.Err(windows_core.errorFromHRESULT(windows_core.E_POINTER))
    }
    windows_core.Result<Unit>.Ok(())
}

@When[Windows_Win32_System_ClrHosting == "on"]
public func CLRCreateInstance(clsid: CPointer<GUID>, riid: CPointer<GUID>, ppInterface: CPointer<CPointer<Unit>>): Int32 {
    let proc__ = CFunc<(CPointer<GUID>, CPointer<GUID>, CPointer<CPointer<Unit>>) -> Int32>(windows_libloading.resolveProc("MSCorEE.dll", "CLRCreateInstance"))
