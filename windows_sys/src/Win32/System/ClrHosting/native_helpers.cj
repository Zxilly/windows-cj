}

@When[Windows_Win32_System_ClrHosting == "on"]
public func CLRCreateInstanceChecked(clsid: CPointer<GUID>, riid: CPointer<GUID>, ppInterface: CPointer<CPointer<Unit>>): windows_core.Result<Unit> {
    if (ppInterface.isNull()) {
        return windows_core.Result<Unit>.Err(windows_core.errorFromHRESULT(windows_core.E_POINTER))
    }
    unsafe { ppInterface.write(CPointer<Unit>()) }
    let resultHr__ = windows_core.HRESULT(CLRCreateInstance(clsid, riid, ppInterface))
    if (resultHr__.failed()) {
        windows_core.releaseFailedComOutSlot(ppInterface)
        return resultHr__.ok()
    }
    if (unsafe { ppInterface.read() }.isNull()) {
        windows_core.releaseFailedComOutSlot(ppInterface)
        return windows_core.Result<Unit>.Err(windows_core.errorFromHRESULT(windows_core.E_POINTER))
    }
    windows_core.Result<Unit>.Ok(())
}
