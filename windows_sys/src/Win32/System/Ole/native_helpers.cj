@When[Windows_Win32_System_Ole == "on"]
public func OleLoadPictureFile(varFileName: VARIANT, lplpdispPicture: CPointer<CPointer<Unit>>): Int32 {
    let proc__ = CFunc<(VARIANT, CPointer<CPointer<Unit>>) -> Int32>(windows_libloading.resolveProc("OLEAUT32.dll", "OleLoadPictureFile"))
    return unsafe { proc__(varFileName, lplpdispPicture) }
}

@When[Windows_Win32_System_Ole == "on"]
public func OleLoadPictureFileChecked(varFileName: VARIANT, lplpdispPicture: CPointer<CPointer<Unit>>): windows_core.Result<Unit> {
    if (lplpdispPicture.isNull()) {
        return windows_core.Result<Unit>.Err(windows_core.errorFromHRESULT(windows_core.E_POINTER))
    }
    unsafe { lplpdispPicture.write(CPointer<Unit>()) }
    let resultHr__ = windows_core.HRESULT(OleLoadPictureFile(varFileName, lplpdispPicture))
    if (resultHr__.failed()) {
        windows_core.releaseFailedComOutSlot(lplpdispPicture)
        return resultHr__.ok()
    }
    if (unsafe { lplpdispPicture.read() }.isNull()) {
        windows_core.releaseFailedComOutSlot(lplpdispPicture)
        return windows_core.Result<Unit>.Err(windows_core.errorFromHRESULT(windows_core.E_POINTER))
    }
    windows_core.Result<Unit>.Ok(())
}

@When[Windows_Win32_System_Ole == "on"]
public func OleLoadPictureFileEx(varFileName: VARIANT, xSizeDesired: UInt32, ySizeDesired: UInt32, dwFlags: UInt32, lplpdispPicture: CPointer<CPointer<Unit>>): Int32 {
    let proc__ = CFunc<(VARIANT, UInt32, UInt32, UInt32, CPointer<CPointer<Unit>>) -> Int32>(windows_libloading.resolveProc("OLEAUT32.dll", "OleLoadPictureFileEx"))
