@When[Windows_Win32_System_Ole == "on"]
public func LoadTypeLib(szFile: windows_strings.PWSTR, pptlib: CPointer<CPointer<Unit>>): Int32 {
    let proc__ = CFunc<(CPointer<UInt16>, CPointer<CPointer<Unit>>) -> Int32>(windows_libloading.resolveProc("OLEAUT32.dll", "LoadTypeLib"))
    return unsafe { proc__(szFile.asPtr(), pptlib) }
}

@When[Windows_Win32_System_Ole == "on"]
public func LoadTypeLibChecked(szFile: windows_strings.PWSTR, pptlib: CPointer<CPointer<Unit>>): windows_core.Result<Unit> {
    if (pptlib.isNull()) {
        return windows_core.Result<Unit>.Err(windows_core.errorFromHRESULT(windows_core.E_POINTER))
    }
    unsafe { pptlib.write(CPointer<Unit>()) }
    let resultHr__ = windows_core.HRESULT(LoadTypeLib(szFile, pptlib))
    if (resultHr__.failed()) {
        windows_core.releaseFailedComOutSlot(pptlib)
        return resultHr__.ok()
    }
    if (unsafe { pptlib.read() }.isNull()) {
        windows_core.releaseFailedComOutSlot(pptlib)
        return windows_core.Result<Unit>.Err(windows_core.errorFromHRESULT(windows_core.E_POINTER))
    }
    windows_core.Result<Unit>.Ok(())
}

