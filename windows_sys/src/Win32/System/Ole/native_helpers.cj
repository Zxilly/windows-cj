@When[Windows_Win32_System_Ole == "on"]
public func OleGetClipboardChecked(ppDataObj: CPointer<CPointer<Unit>>): windows_core.Result<Unit> {
    if (ppDataObj.isNull()) {
        return windows_core.Result<Unit>.Err(windows_core.errorFromHRESULT(windows_core.E_POINTER))
    }
    unsafe { ppDataObj.write(CPointer<Unit>()) }
    let resultHr__ = windows_core.HRESULT(OleGetClipboard(ppDataObj))
    if (resultHr__.failed()) {
        windows_core.releaseFailedComOutSlot(ppDataObj)
        return resultHr__.ok()
    }
    if (unsafe { ppDataObj.read() }.isNull()) {
        windows_core.releaseFailedComOutSlot(ppDataObj)
        return windows_core.Result<Unit>.Err(windows_core.errorFromHRESULT(windows_core.E_POINTER))
    }
    windows_core.Result<Unit>.Ok(())
}

