public func PowerCreateRequest(Context: CPointer<REASON_CONTEXT>): HANDLE {
    let proc__ = CFunc<(CPointer<REASON_CONTEXT>) -> CPointer<Unit>>(windows_libloading.resolveProc("KERNEL32.dll", "PowerCreateRequest"))
    var result = HANDLE()
    result.Value = unsafe { proc__(Context) }
    result
}

@When[Windows_Win32_System_Power == "on"]
public func PowerCreateRequestChecked(Context: CPointer<REASON_CONTEXT>): windows_core.Result<HANDLE> {
    let result__ = PowerCreateRequest(Context)
    if (result__.Value.isNull()) {
        return windows_core.Result<HANDLE>.Err(windows_core.errorFromThread())
    }
    windows_core.Result<HANDLE>.Ok(result__)
}

