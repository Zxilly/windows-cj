public func QueryActCtxSettingsWChecked(dwFlags: UInt32, hActCtx: HANDLE, settingsNameSpace: windows_strings.PWSTR, settingName: windows_strings.PWSTR, pvBuffer: windows_strings.PWSTR, dwBuffer: UIntNative, pdwWrittenOrRequired: CPointer<UIntNative>): windows_core.Result<Unit> {
    if (QueryActCtxSettingsW(dwFlags, hActCtx, settingsNameSpace, settingName, pvBuffer, dwBuffer, pdwWrittenOrRequired)) {
        return windows_core.Result<Unit>.Ok(())
    }
    windows_core.Result<Unit>.Err(windows_core.errorFromThread())
}
