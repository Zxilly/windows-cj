// Windows.Win32.System.Diagnostics.Debug.Extensions.IDebugControl6 (synthetic:Windows_Win32_System_Diagnostics_Debug_Extensions_IDebugControl6)
@When[Windows_Win32_System_Diagnostics_Debug_Extensions == "on"]
public class IDebugControl6 <: Resource & windows_core.HandleWinrtType<IDebugControl6> {
    private let raw: CPointer<Unit>
    private var ownsHandle: Bool = false
    private var closed: Bool = false

    public init(raw: CPointer<Unit>) {
        this.raw = raw
    }

    public init(raw: CPointer<Unit>, takeOwnership!: Bool) {
        if (takeOwnership && raw.isNull()) {
            throw windows_core.WindowsException(windows_core.E_POINTER)
        }
