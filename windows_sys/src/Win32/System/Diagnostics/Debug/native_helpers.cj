    let proc__ = CFunc<(CPointer<Unit>, UIntNative, UInt32, UInt32, CPointer<UInt32>, CPointer<WAITCHAIN_NODE_INFO>, CPointer<Int32>) -> Int32>(windows_libloading.resolveProc("ADVAPI32.dll", "GetThreadWaitChain"))
