@When[Windows_Win32_System_Diagnostics_Debug == "on"]
public func GetThreadWaitChainChecked(WctHandle: CPointer<Unit>, Context: UIntNative, Flags: UInt32, ThreadId: UInt32, NodeCount: CPointer<UInt32>, NodeInfoArray: CPointer<WAITCHAIN_NODE_INFO>, IsCycle: CPointer<Int32>): windows_core.Result<Bool> {
    let result__ = GetThreadWaitChain(WctHandle, Context, Flags, ThreadId, NodeCount, NodeInfoArray, IsCycle)
    if (result__) {
        return windows_core.Result<Bool>.Ok(true)
    }
    let getLastErrorProc__ = CFunc<() -> UInt32>(windows_libloading.resolveProc("KERNEL32.dll", "GetLastError"))
    let lastError__ = unsafe { getLastErrorProc__() }
    if (lastError__ == 997u32) {
        return windows_core.Result<Bool>.Ok(false)
    }
    windows_core.Result<Bool>.Err(windows_core.errorFromWin32(lastError__))
}

