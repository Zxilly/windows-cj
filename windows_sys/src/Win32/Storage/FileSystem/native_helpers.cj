@When[Windows_Win32_Storage_FileSystem == "on"]
public func HandleLogFull(hLog: HANDLE): Bool {
    let proc__ = CFunc<(CPointer<Unit>) -> Int32>(windows_libloading.resolveProc("clfsw32.dll", "HandleLogFull"))
    return unsafe { proc__(hLog.Value) } != 0
}

@When[Windows_Win32_Storage_FileSystem == "on"]
public func HandleLogFullChecked(hLog: HANDLE): windows_core.Result<Bool> {
    let result__ = HandleLogFull(hLog)
    if (result__) {
        return windows_core.Result<Bool>.Ok(true)
    }
    let getLastErrorProc__ = CFunc<() -> UInt32>(windows_libloading.resolveProc("KERNEL32.dll", "GetLastError"))
    let lastError__ = unsafe { getLastErrorProc__() }
    if (lastError__ == 997u32) {
        return windows_core.Result<Bool>.Ok(false)
    }
