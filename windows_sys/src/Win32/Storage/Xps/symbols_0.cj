@When[Windows_Win32_Storage_Xps == "on"]
public struct XPS_SIGN_FLAGS {
    public let value: Int32
    public const init() {
        this.value = 0
    }
    public const init(value: Int32) {
        this.value = value
    }
    public func contains(other: XPS_SIGN_FLAGS): Bool {
        return (value & other.value) == other.value
    }
    public operator func |(other: XPS_SIGN_FLAGS): XPS_SIGN_FLAGS {
        return XPS_SIGN_FLAGS(value | other.value)
    }
    public operator func &(other: XPS_SIGN_FLAGS): XPS_SIGN_FLAGS {
        return XPS_SIGN_FLAGS(value & other.value)
    }
    public operator func ^(other: XPS_SIGN_FLAGS): XPS_SIGN_FLAGS {
        return XPS_SIGN_FLAGS(value ^ other.value)
    }
    public operator func !(): XPS_SIGN_FLAGS {
        return XPS_SIGN_FLAGS(!value)
    }
}
