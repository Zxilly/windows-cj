@When[Windows_Win32_Devices_Fax == "on"]
public func StiCreateInstanceW(hinst: HINSTANCE, dwVer: UInt32, ppSti: CPointer<CPointer<Unit>>, punkOuter: windows_interface.IUnknown): Int32 {
    let proc__ = CFunc<(CPointer<Unit>, UInt32, CPointer<CPointer<Unit>>, CPointer<Unit>) -> Int32>(windows_libloading.resolveProc("STI.dll", "StiCreateInstanceW"))
