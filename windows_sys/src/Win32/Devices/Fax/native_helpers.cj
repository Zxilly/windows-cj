@When[Windows_Win32_Devices_Fax == "on"]
public func StiCreateInstanceWChecked(hinst: HINSTANCE, dwVer: UInt32, ppSti: CPointer<CPointer<Unit>>, punkOuter: windows_interface.IUnknown): windows_core.Result<Unit> {
    if (ppSti.isNull()) {
        return windows_core.Result<Unit>.Err(windows_core.errorFromHRESULT(windows_core.E_POINTER))
    }
    unsafe { ppSti.write(CPointer<Unit>()) }
    let resultHr__ = windows_core.HRESULT(StiCreateInstanceW(hinst, dwVer, ppSti, punkOuter))
    if (resultHr__.failed()) {
        windows_core.releaseFailedComOutSlot(ppSti)
        return resultHr__.ok()
    }
    if (unsafe { ppSti.read() }.isNull()) {
        windows_core.releaseFailedComOutSlot(ppSti)
        return windows_core.Result<Unit>.Err(windows_core.errorFromHRESULT(windows_core.E_POINTER))
    }
    windows_core.Result<Unit>.Ok(())
}
