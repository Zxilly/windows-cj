@When[Windows_Win32_Devices_Tapi == "on"]
public func OpenTnefStreamChecked(lpvSupport: CPointer<Unit>, lpStream: CPointer<Unit>, lpszStreamName: CPointer<Int8>, ulFlags: UInt32, lpMessage: CPointer<Unit>, wKeyVal: UInt16, lppTNEF: CPointer<CPointer<Unit>>): windows_core.Result<Unit> {
    if (lppTNEF.isNull()) {
        return windows_core.Result<Unit>.Err(windows_core.errorFromHRESULT(windows_core.E_POINTER))
    }
    unsafe { lppTNEF.write(CPointer<Unit>()) }
    let resultHr__ = windows_core.HRESULT(OpenTnefStream(lpvSupport, lpStream, lpszStreamName, ulFlags, lpMessage, wKeyVal, lppTNEF))
    if (resultHr__.failed()) {
        windows_core.releaseFailedComOutSlot(lppTNEF)
        return resultHr__.ok()
    }
    if (unsafe { lppTNEF.read() }.isNull()) {
        windows_core.releaseFailedComOutSlot(lppTNEF)
        return windows_core.Result<Unit>.Err(windows_core.errorFromHRESULT(windows_core.E_POINTER))
    }
    windows_core.Result<Unit>.Ok(())
}

