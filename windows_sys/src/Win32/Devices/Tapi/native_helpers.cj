public func OpenTnefStream(lpvSupport: CPointer<Unit>, lpStream: CPointer<Unit>, lpszStreamName: CPointer<Int8>, ulFlags: UInt32, lpMessage: CPointer<Unit>, wKeyVal: UInt16, lppTNEF: CPointer<CPointer<Unit>>): Int32 {
    let proc__ = CFunc<(CPointer<Unit>, CPointer<Unit>, CPointer<Int8>, UInt32, CPointer<Unit>, UInt16, CPointer<CPointer<Unit>>) -> Int32>(windows_libloading.resolveProc("MAPI32.dll", "OpenTnefStream"))
