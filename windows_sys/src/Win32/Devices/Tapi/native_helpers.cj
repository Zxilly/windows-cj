    return unsafe { proc__(lpStream, lpulCodepage, lpulSubCodepage) }
}

@When[Windows_Win32_Devices_Tapi == "on"]
public func GetTnefStreamCodepageChecked(lpStream: CPointer<Unit>, lpulCodepage: CPointer<UInt32>, lpulSubCodepage: CPointer<UInt32>): windows_core.Result<Unit> {
    windows_core.HRESULT(GetTnefStreamCodepage(lpStream, lpulCodepage, lpulSubCodepage)).ok()
}
