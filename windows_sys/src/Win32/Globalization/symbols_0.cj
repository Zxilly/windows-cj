    }
    public const init(value: UInt32) {
        this.value = value
    }
    public func contains(other: TIME_FORMAT_FLAGS): Bool {
        return (value & other.value) == other.value
    }
    public operator func |(other: TIME_FORMAT_FLAGS): TIME_FORMAT_FLAGS {
        return TIME_FORMAT_FLAGS(value | other.value)
    }
    public operator func &(other: TIME_FORMAT_FLAGS): TIME_FORMAT_FLAGS {
        return TIME_FORMAT_FLAGS(value & other.value)
    }
    public operator func ^(other: TIME_FORMAT_FLAGS): TIME_FORMAT_FLAGS {
        return TIME_FORMAT_FLAGS(value ^ other.value)
    }
    public operator func !(): TIME_FORMAT_FLAGS {
