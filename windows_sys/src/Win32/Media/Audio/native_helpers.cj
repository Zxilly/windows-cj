public func acmStreamUnprepareHeader(has: HACMSTREAM, pash: CPointer<ACMSTREAMHEADER>, fdwUnprepare: UInt32): UInt32 {
    let proc__ = CFunc<(CPointer<Unit>, CPointer<ACMSTREAMHEADER>, UInt32) -> UInt32>(windows_libloading.resolveProc("MSACM32.dll", "acmStreamUnprepareHeader"))
    return unsafe { proc__(has.Value, pash, fdwUnprepare) }
}
