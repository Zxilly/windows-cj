@When[Windows_Win32_Media_Multimedia == "on"]
public func AVIMakeFileFromStreams(ppfile: CPointer<CPointer<Unit>>, nStreams: Int32, papStreams: CPointer<CPointer<Unit>>): Int32 {
    let proc__ = CFunc<(CPointer<CPointer<Unit>>, Int32, CPointer<CPointer<Unit>>) -> Int32>(windows_libloading.resolveProc("AVIFIL32.dll", "AVIMakeFileFromStreams"))
    return unsafe { proc__(ppfile, nStreams, papStreams) }
}

@When[Windows_Win32_Media_Multimedia == "on"]
public func AVIMakeFileFromStreamsChecked(ppfile: CPointer<CPointer<Unit>>, nStreams: Int32, papStreams: CPointer<CPointer<Unit>>): windows_core.Result<Unit> {
    if (ppfile.isNull()) {
        return windows_core.Result<Unit>.Err(windows_core.errorFromHRESULT(windows_core.E_POINTER))
    }
    unsafe { ppfile.write(CPointer<Unit>()) }
    let resultHr__ = windows_core.HRESULT(AVIMakeFileFromStreams(ppfile, nStreams, papStreams))
    if (resultHr__.failed()) {
        windows_core.releaseFailedComOutSlot(ppfile)
        return resultHr__.ok()
    }
    if (unsafe { ppfile.read() }.isNull()) {
        windows_core.releaseFailedComOutSlot(ppfile)
        return windows_core.Result<Unit>.Err(windows_core.errorFromHRESULT(windows_core.E_POINTER))
    }
    windows_core.Result<Unit>.Ok(())
}

