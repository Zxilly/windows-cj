@When[Windows_Win32_Media_Multimedia == "on"]
public func AVIFileOpenAChecked(ppfile: CPointer<CPointer<Unit>>, szFile: windows_strings.PSTR, uMode: UInt32, lpHandler: CPointer<GUID>): windows_core.Result<Unit> {
    if (ppfile.isNull()) {
        return windows_core.Result<Unit>.Err(windows_core.errorFromHRESULT(windows_core.E_POINTER))
    }
    unsafe { ppfile.write(CPointer<Unit>()) }
    let resultHr__ = windows_core.HRESULT(AVIFileOpenA(ppfile, szFile, uMode, lpHandler))
    if (resultHr__.failed()) {
        windows_core.releaseFailedComOutSlot(ppfile)
        return resultHr__.ok()
    }
    if (unsafe { ppfile.read() }.isNull()) {
        windows_core.releaseFailedComOutSlot(ppfile)
        return windows_core.Result<Unit>.Err(windows_core.errorFromHRESULT(windows_core.E_POINTER))
    }
    windows_core.Result<Unit>.Ok(())
}

