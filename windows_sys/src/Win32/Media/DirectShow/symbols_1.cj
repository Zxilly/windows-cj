// Windows.Win32.Media.DirectShow.OUTPUT_STATE (synthetic:Windows_Win32_Media_DirectShow_OUTPUT_STATE)
@When[Windows_Win32_Media_DirectShow == "on"]
public struct OUTPUT_STATE {
    public let value: Int32
    public const init() {
        this.value = 0
    }
    public const init(value: Int32) {
        this.value = value
    }
    public func contains(other: OUTPUT_STATE): Bool {
        return (value & other.value) == other.value
    }
    public operator func |(other: OUTPUT_STATE): OUTPUT_STATE {
        return OUTPUT_STATE(value | other.value)
    }
    public operator func &(other: OUTPUT_STATE): OUTPUT_STATE {
        return OUTPUT_STATE(value & other.value)
    }
    public operator func ^(other: OUTPUT_STATE): OUTPUT_STATE {
        return OUTPUT_STATE(value ^ other.value)
    }
    public operator func !(): OUTPUT_STATE {
        return OUTPUT_STATE(!value)
    }
}
