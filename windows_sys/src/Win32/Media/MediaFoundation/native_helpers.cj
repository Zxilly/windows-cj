public func MFCreateAsyncResult(punkObject: windows_interface.IUnknown, pCallback: CPointer<Unit>, punkState: windows_interface.IUnknown, ppAsyncResult: CPointer<CPointer<Unit>>): Int32 {
    let proc__ = CFunc<(CPointer<Unit>, CPointer<Unit>, CPointer<Unit>, CPointer<CPointer<Unit>>) -> Int32>(windows_libloading.resolveProc("MFPlat.dll", "MFCreateAsyncResult"))
    return unsafe { proc__(punkObject.asRaw(), pCallback, punkState.asRaw(), ppAsyncResult) }
