@When[Windows_Win32_Media_MediaFoundation == "on"]
public func MFCreateAsyncResultChecked(punkObject: windows_interface.IUnknown, pCallback: CPointer<Unit>, punkState: windows_interface.IUnknown, ppAsyncResult: CPointer<CPointer<Unit>>): windows_core.Result<Unit> {
    if (ppAsyncResult.isNull()) {
        return windows_core.Result<Unit>.Err(windows_core.errorFromHRESULT(windows_core.E_POINTER))
    }
    unsafe { ppAsyncResult.write(CPointer<Unit>()) }
    let resultHr__ = windows_core.HRESULT(MFCreateAsyncResult(punkObject, pCallback, punkState, ppAsyncResult))
    if (resultHr__.failed()) {
        windows_core.releaseFailedComOutSlot(ppAsyncResult)
        return resultHr__.ok()
    }
    if (unsafe { ppAsyncResult.read() }.isNull()) {
        windows_core.releaseFailedComOutSlot(ppAsyncResult)
        return windows_core.Result<Unit>.Err(windows_core.errorFromHRESULT(windows_core.E_POINTER))
    }
    windows_core.Result<Unit>.Ok(())
}

