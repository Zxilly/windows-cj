@When[Windows_Win32_Graphics_Gdi == "on"]
public func GetMonitorInfoW(hMonitor: HMONITOR, lpmi: CPointer<MONITORINFO>): Bool {
    let proc__ = CFunc<(CPointer<Unit>, CPointer<MONITORINFO>) -> Int32>(windows_libloading.resolveProc("USER32.dll", "GetMonitorInfoW"))
    return unsafe { proc__(hMonitor.Value, lpmi) } != 0
}

@When[Windows_Win32_Graphics_Gdi == "on"]
public func EnumDisplayMonitors(hdc: HDC, lprcClip: CPointer<RECT>, lpfnEnum: CFunc<(CPointer<Unit>, CPointer<Unit>, CPointer<RECT>, IntNative) -> Int32>, dwData: IntNative): Bool {
    let proc__ = CFunc<(CPointer<Unit>, CPointer<RECT>, CFunc<(CPointer<Unit>, CPointer<Unit>, CPointer<RECT>, IntNative) -> Int32>, IntNative) -> Int32>(windows_libloading.resolveProc("USER32.dll", "EnumDisplayMonitors"))
    return unsafe { proc__(hdc.Value, lprcClip, lpfnEnum, dwData) } != 0
}
