public func CreatePrintAsyncNotifyChannel(pszName: windows_strings.PWSTR, pNotificationType: CPointer<GUID>, eUserFilter: Int32, eConversationStyle: Int32, pCallback: CPointer<Unit>, ppIAsynchNotification: CPointer<CPointer<Unit>>): Int32 {
    let proc__ = CFunc<(CPointer<UInt16>, CPointer<GUID>, Int32, Int32, CPointer<Unit>, CPointer<CPointer<Unit>>) -> Int32>(windows_libloading.resolveProc("winspool.drv", "CreatePrintAsyncNotifyChannel"))
    return unsafe { proc__(pszName.asPtr(), pNotificationType, eUserFilter, eConversationStyle, pCallback, ppIAsynchNotification) }
}

@When[Windows_Win32_Graphics_Printing == "on"]
public func CreatePrintAsyncNotifyChannelChecked(pszName: windows_strings.PWSTR, pNotificationType: CPointer<GUID>, eUserFilter: Int32, eConversationStyle: Int32, pCallback: CPointer<Unit>, ppIAsynchNotification: CPointer<CPointer<Unit>>): windows_core.Result<Unit> {
    if (ppIAsynchNotification.isNull()) {
        return windows_core.Result<Unit>.Err(windows_core.errorFromHRESULT(windows_core.E_POINTER))
    }
    unsafe { ppIAsynchNotification.write(CPointer<Unit>()) }
    let resultHr__ = windows_core.HRESULT(CreatePrintAsyncNotifyChannel(pszName, pNotificationType, eUserFilter, eConversationStyle, pCallback, ppIAsynchNotification))
    if (resultHr__.failed()) {
        windows_core.releaseFailedComOutSlot(ppIAsynchNotification)
        return resultHr__.ok()
    }
    if (unsafe { ppIAsynchNotification.read() }.isNull()) {
        windows_core.releaseFailedComOutSlot(ppIAsynchNotification)
        return windows_core.Result<Unit>.Err(windows_core.errorFromHRESULT(windows_core.E_POINTER))
    }
    windows_core.Result<Unit>.Ok(())
}

