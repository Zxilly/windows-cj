// Windows.Win32.Web.MsHtml.IHTMLRuleStyle2 (synthetic:Windows_Win32_Web_MsHtml_IHTMLRuleStyle2)
@When[Windows_Win32_Web_MsHtml == "on"]
public class IHTMLRuleStyle2 <: Resource & windows_core.HandleWinrtType<IHTMLRuleStyle2> {
    private let raw: CPointer<Unit>
    private var ownsHandle: Bool = false
    private var closed: Bool = false

    public init(raw: CPointer<Unit>) {
        this.raw = raw
    }

    public init(raw: CPointer<Unit>, takeOwnership!: Bool) {
        if (takeOwnership && raw.isNull()) {
            throw windows_core.WindowsException(windows_core.E_POINTER)
        }
        this.raw = raw
        this.ownsHandle = takeOwnership
    }

    public func asRaw(): CPointer<Unit> {
        if (closed) {
            return CPointer<Unit>()
        }
        raw
    }

    public func isClosed(): Bool {
        closed
    }

    public func close(): Unit {
        if (closed) {
            return
        }
        let shouldRelease = ownsHandle
        ownsHandle = false
        closed = true
        if (shouldRelease) {
            IHTMLRuleStyle2.releaseRaw(raw)
        }
