@When[Windows_Win32_Web_InternetExplorer == "on"]
public func CreateMIMEMap(ppMap: CPointer<CPointer<Unit>>): Int32 {
    let proc__ = CFunc<(CPointer<CPointer<Unit>>) -> Int32>(windows_libloading.resolveProc("ImgUtil.dll", "CreateMIMEMap"))
    return unsafe { proc__(ppMap) }
}

@When[Windows_Win32_Web_InternetExplorer == "on"]
public func CreateMIMEMapChecked(ppMap: CPointer<CPointer<Unit>>): windows_core.Result<Unit> {
    if (ppMap.isNull()) {
        return windows_core.Result<Unit>.Err(windows_core.errorFromHRESULT(windows_core.E_POINTER))
    }
    unsafe { ppMap.write(CPointer<Unit>()) }
    let resultHr__ = windows_core.HRESULT(CreateMIMEMap(ppMap))
    if (resultHr__.failed()) {
        windows_core.releaseFailedComOutSlot(ppMap)
        return resultHr__.ok()
    }
    if (unsafe { ppMap.read() }.isNull()) {
        windows_core.releaseFailedComOutSlot(ppMap)
        return windows_core.Result<Unit>.Err(windows_core.errorFromHRESULT(windows_core.E_POINTER))
    }
    windows_core.Result<Unit>.Ok(())
}

