@When[Windows_Win32_UI_Shell == "on"]
public func AssocCreateForClassesChecked(rgClasses: CPointer<ASSOCIATIONELEMENT>, cClasses: UInt32, riid: CPointer<GUID>, ppv: CPointer<CPointer<Unit>>): windows_core.Result<Unit> {
    if (ppv.isNull()) {
        return windows_core.Result<Unit>.Err(windows_core.errorFromHRESULT(windows_core.E_POINTER))
    }
    unsafe { ppv.write(CPointer<Unit>()) }
    let resultHr__ = windows_core.HRESULT(AssocCreateForClasses(rgClasses, cClasses, riid, ppv))
    if (resultHr__.failed()) {
        windows_core.releaseFailedComOutSlot(ppv)
        return resultHr__.ok()
    }
    if (unsafe { ppv.read() }.isNull()) {
        windows_core.releaseFailedComOutSlot(ppv)
        return windows_core.Result<Unit>.Err(windows_core.errorFromHRESULT(windows_core.E_POINTER))
    }
    windows_core.Result<Unit>.Ok(())
}

