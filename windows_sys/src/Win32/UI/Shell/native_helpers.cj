@When[Windows_Win32_UI_Shell == "on"]
public func AssocCreateForClasses(rgClasses: CPointer<ASSOCIATIONELEMENT>, cClasses: UInt32, riid: CPointer<GUID>, ppv: CPointer<CPointer<Unit>>): Int32 {
    let proc__ = CFunc<(CPointer<ASSOCIATIONELEMENT>, UInt32, CPointer<GUID>, CPointer<CPointer<Unit>>) -> Int32>(windows_libloading.resolveProc("SHELL32.dll", "AssocCreateForClasses"))
    return unsafe { proc__(rgClasses, cClasses, riid, ppv) }
