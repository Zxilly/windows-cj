@When[Windows_Win32_UI_Shell == "on"]
public func SHCreateQueryCancelAutoPlayMonikerChecked(ppmoniker: CPointer<CPointer<Unit>>): windows_core.Result<Unit> {
    if (ppmoniker.isNull()) {
        return windows_core.Result<Unit>.Err(windows_core.errorFromHRESULT(windows_core.E_POINTER))
    }
    unsafe { ppmoniker.write(CPointer<Unit>()) }
    let resultHr__ = windows_core.HRESULT(SHCreateQueryCancelAutoPlayMoniker(ppmoniker))
    if (resultHr__.failed()) {
        windows_core.releaseFailedComOutSlot(ppmoniker)
        return resultHr__.ok()
    }
    if (unsafe { ppmoniker.read() }.isNull()) {
        windows_core.releaseFailedComOutSlot(ppmoniker)
        return windows_core.Result<Unit>.Err(windows_core.errorFromHRESULT(windows_core.E_POINTER))
    }
    windows_core.Result<Unit>.Ok(())
}

