@When[Windows_Win32_UI_Shell == "on"]
public func SHGetImageList(iImageList: Int32, riid: CPointer<GUID>, ppvObj: CPointer<CPointer<Unit>>): Int32 {
    let proc__ = CFunc<(Int32, CPointer<GUID>, CPointer<CPointer<Unit>>) -> Int32>(windows_libloading.resolveProc("SHELL32.dll", "SHGetImageList"))
    return unsafe { proc__(iImageList, riid, ppvObj) }
}

@When[Windows_Win32_UI_Shell == "on"]
public func SHGetImageListChecked(iImageList: Int32, riid: CPointer<GUID>, ppvObj: CPointer<CPointer<Unit>>): windows_core.Result<Unit> {
    if (ppvObj.isNull()) {
        return windows_core.Result<Unit>.Err(windows_core.errorFromHRESULT(windows_core.E_POINTER))
    }
    unsafe { ppvObj.write(CPointer<Unit>()) }
    let resultHr__ = windows_core.HRESULT(SHGetImageList(iImageList, riid, ppvObj))
    if (resultHr__.failed()) {
        windows_core.releaseFailedComOutSlot(ppvObj)
        return resultHr__.ok()
    }
    if (unsafe { ppvObj.read() }.isNull()) {
        windows_core.releaseFailedComOutSlot(ppvObj)
        return windows_core.Result<Unit>.Err(windows_core.errorFromHRESULT(windows_core.E_POINTER))
    }
    windows_core.Result<Unit>.Ok(())
}

