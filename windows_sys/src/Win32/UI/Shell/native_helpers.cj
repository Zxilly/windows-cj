@When[Windows_Win32_UI_Shell == "on"]
public func SHCreateShellFolderViewChecked(pcsfv: CPointer<SFV_CREATE>, ppsv: CPointer<CPointer<Unit>>): windows_core.Result<Unit> {
    if (ppsv.isNull()) {
        return windows_core.Result<Unit>.Err(windows_core.errorFromHRESULT(windows_core.E_POINTER))
    }
    unsafe { ppsv.write(CPointer<Unit>()) }
    let resultHr__ = windows_core.HRESULT(SHCreateShellFolderView(pcsfv, ppsv))
    if (resultHr__.failed()) {
        windows_core.releaseFailedComOutSlot(ppsv)
        return resultHr__.ok()
    }
    if (unsafe { ppsv.read() }.isNull()) {
        windows_core.releaseFailedComOutSlot(ppsv)
        return windows_core.Result<Unit>.Err(windows_core.errorFromHRESULT(windows_core.E_POINTER))
    }
    windows_core.Result<Unit>.Ok(())
