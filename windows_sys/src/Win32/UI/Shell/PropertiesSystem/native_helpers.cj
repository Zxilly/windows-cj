@When[Windows_Win32_UI_Shell_PropertiesSystem == "on"]
public func PSPropertyBag_ReadStream(propBag: CPointer<Unit>, propName: windows_strings.PWSTR, value: CPointer<CPointer<Unit>>): Int32 {
    let proc__ = CFunc<(CPointer<Unit>, CPointer<UInt16>, CPointer<CPointer<Unit>>) -> Int32>(windows_libloading.resolveProc("PROPSYS.dll", "PSPropertyBag_ReadStream"))
    return unsafe { proc__(propBag, propName.asPtr(), value) }
}

@When[Windows_Win32_UI_Shell_PropertiesSystem == "on"]
public func PSPropertyBag_ReadStreamChecked(propBag: CPointer<Unit>, propName: windows_strings.PWSTR, value: CPointer<CPointer<Unit>>): windows_core.Result<Unit> {
    if (value.isNull()) {
        return windows_core.Result<Unit>.Err(windows_core.errorFromHRESULT(windows_core.E_POINTER))
    }
    unsafe { value.write(CPointer<Unit>()) }
    let resultHr__ = windows_core.HRESULT(PSPropertyBag_ReadStream(propBag, propName, value))
    if (resultHr__.failed()) {
        windows_core.releaseFailedComOutSlot(value)
        return resultHr__.ok()
    }
    if (unsafe { value.read() }.isNull()) {
        windows_core.releaseFailedComOutSlot(value)
        return windows_core.Result<Unit>.Err(windows_core.errorFromHRESULT(windows_core.E_POINTER))
    }
    windows_core.Result<Unit>.Ok(())
}

