@When[Windows_Win32_UI_Accessibility == "on"]
public func LegacyIAccessiblePattern_GetIAccessibleChecked(hobj: HUIAPATTERNOBJECT, pAccessible: CPointer<CPointer<Unit>>): windows_core.Result<Unit> {
    if (pAccessible.isNull()) {
        return windows_core.Result<Unit>.Err(windows_core.errorFromHRESULT(windows_core.E_POINTER))
    }
    unsafe { pAccessible.write(CPointer<Unit>()) }
    let resultHr__ = windows_core.HRESULT(LegacyIAccessiblePattern_GetIAccessible(hobj, pAccessible))
    if (resultHr__.failed()) {
        windows_core.releaseFailedComOutSlot(pAccessible)
