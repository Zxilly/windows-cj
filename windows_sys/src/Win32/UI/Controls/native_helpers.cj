@When[Windows_Win32_UI_Controls == "on"]
public func ImageList_CoCreateInstanceChecked(rclsid: CPointer<GUID>, punkOuter: windows_interface.IUnknown, riid: CPointer<GUID>, ppv: CPointer<CPointer<Unit>>): windows_core.Result<Unit> {
    if (ppv.isNull()) {
        return windows_core.Result<Unit>.Err(windows_core.errorFromHRESULT(windows_core.E_POINTER))
    }
    unsafe { ppv.write(CPointer<Unit>()) }
    let resultHr__ = windows_core.HRESULT(ImageList_CoCreateInstance(rclsid, punkOuter, riid, ppv))
    if (resultHr__.failed()) {
        windows_core.releaseFailedComOutSlot(ppv)
        return resultHr__.ok()
    }
    if (unsafe { ppv.read() }.isNull()) {
        windows_core.releaseFailedComOutSlot(ppv)
        return windows_core.Result<Unit>.Err(windows_core.errorFromHRESULT(windows_core.E_POINTER))
    }
    windows_core.Result<Unit>.Ok(())
}

