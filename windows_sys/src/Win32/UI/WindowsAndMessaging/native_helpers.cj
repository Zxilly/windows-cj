public func MsgWaitForMultipleObjectsChecked(nCount: UInt32, pHandles: CPointer<HANDLE>, fWaitAll: Bool, dwMilliseconds: UInt32, dwWakeMask: UInt32): windows_core.Result<WAIT_EVENT> {
