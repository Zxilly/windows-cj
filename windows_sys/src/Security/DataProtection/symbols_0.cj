    public const init() {
        this.value = 0
    }
    public const init(value: Int32) {
        this.value = value
    }
}
@When[Windows_Security_DataProtection == "on"]
public const UserDataStorageItemProtectionStatus_Succeeded = UserDataStorageItemProtectionStatus(0)
@When[Windows_Security_DataProtection == "on"]
public const UserDataStorageItemProtectionStatus_NotProtectable = UserDataStorageItemProtectionStatus(1)
@When[Windows_Security_DataProtection == "on"]
public const UserDataStorageItemProtectionStatus_DataUnavailable = UserDataStorageItemProtectionStatus(2)
