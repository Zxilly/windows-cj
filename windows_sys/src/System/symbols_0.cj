// Windows.System.VirtualKeyModifiers (synthetic:Windows_System_VirtualKeyModifiers)
@When[Windows_System == "on"]
public struct VirtualKeyModifiers {
    public let value: UInt32
    public const init() {
        this.value = 0
    }
    public const init(value: UInt32) {
        this.value = value
    }
    public func contains(other: VirtualKeyModifiers): Bool {
        return (value & other.value) == other.value
    }
    public operator func |(other: VirtualKeyModifiers): VirtualKeyModifiers {
        return VirtualKeyModifiers(value | other.value)
    }
    public operator func &(other: VirtualKeyModifiers): VirtualKeyModifiers {
        return VirtualKeyModifiers(value & other.value)
    }
    public operator func ^(other: VirtualKeyModifiers): VirtualKeyModifiers {
        return VirtualKeyModifiers(value ^ other.value)
    }
    public operator func !(): VirtualKeyModifiers {
        return VirtualKeyModifiers(!value)
    }
}
