                return ptr.read()
            }
        }
        set(val) {
            unsafe {
                var rawStorage = _raw
                let base = CPointer<UInt8>(inout rawStorage)
                let p = base
                let ptr = CPointer<CPointer<Unit>>(p)
                ptr.write(val)
                _raw = rawStorage
            }
        }
    }
}
