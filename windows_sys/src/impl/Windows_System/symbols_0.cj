// Windows.System.VirtualKeyModifiers (synthetic:Windows_System_VirtualKeyModifiers)
@When[Windows_System == "on"]
public struct Windows_System_VirtualKeyModifiers {
    public let value: UInt32
    public init() {
        this.value = 0
    }
    public init(value: UInt32) {
        this.value = value
    }
    public func contains(other: Windows_System_VirtualKeyModifiers): Bool {
        return (value & other.value) == other.value
    }
    public operator func |(other: Windows_System_VirtualKeyModifiers): Windows_System_VirtualKeyModifiers {
        return Windows_System_VirtualKeyModifiers(value | other.value)
    }
    public operator func &(other: Windows_System_VirtualKeyModifiers): Windows_System_VirtualKeyModifiers {
        return Windows_System_VirtualKeyModifiers(value & other.value)
    }
    public operator func ^(other: Windows_System_VirtualKeyModifiers): Windows_System_VirtualKeyModifiers {
        return Windows_System_VirtualKeyModifiers(value ^ other.value)
    }
    public operator func !(): Windows_System_VirtualKeyModifiers {
        return Windows_System_VirtualKeyModifiers(!value)
    }
}
