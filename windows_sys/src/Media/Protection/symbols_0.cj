    func __winrtThunk_Invoke(sender: CPointer<Unit>, e: CPointer<Unit>): Int32
}

@When[Windows_Media_Protection == "on"]
public interface ServiceRequestedEventHandlerInvoker <: ServiceRequestedEventHandlerInvokerErased {
    func Invoke(sender: CPointer<Unit>, e: CPointer<Unit>): Unit {
        ()
    }

    func __winrtThunk_Invoke(sender: CPointer<Unit>, e: CPointer<Unit>): Int32 {
        try {
            this.Invoke(sender, e)
            return windows_core.S_OK.value
        } catch (error: windows_core.WindowsException) {
            return error.code().value
        } catch (_: Exception) {
            return windows_core.E_FAIL.value
        }
    }
}

@When[Windows_Media_Protection == "on"]
private class ServiceRequestedEventHandlerBox <: ServiceRequestedEventHandlerInvoker & Resource {
    public let invoke_: (CPointer<Unit>, CPointer<Unit>) -> Unit
    private let vtblHandle: CPointer<ServiceRequestedEventHandlerVtbl>
    private var closed: Bool = false

    public init(invoke: (CPointer<Unit>, CPointer<Unit>) -> Unit) {
        this.invoke_ = invoke
        this.vtblHandle = unsafe { windows_interface.allocateNativeValue<ServiceRequestedEventHandlerVtbl>(buildServiceRequestedEventHandlerBoxVtbl()) }
    }

    public func vtblPtr(): CPointer<Unit> {
        CPointer<Unit>(vtblHandle)
    }

    public func isClosed(): Bool {
        closed
    }

    ~init() {
        if (!closed) {
            closed = true
        }
    }

    public func close(): Unit {
        if (closed) {
            return
        }
        unsafe { windows_interface.freeNativeValue(vtblHandle) }
        closed = true
    }

    public func Invoke(sender: CPointer<Unit>, e: CPointer<Unit>): Unit {
        invoke_(sender, e)
    }
}

@When[Windows_Media_Protection == "on"]
func buildServiceRequestedEventHandlerBoxVtbl(): ServiceRequestedEventHandlerVtbl {
    var vtbl = ServiceRequestedEventHandlerVtbl()
    vtbl.base_ = windows_core.buildIUnknownVtbl()
    vtbl.Invoke = { instanceRaw: CPointer<Unit>, sender: CPointer<Unit>, e: CPointer<Unit> =>
        match (unsafe { windows_core.asImplFromRaw<ServiceRequestedEventHandlerInvokerErased>(instanceRaw) }) {
            case Some(invoker) =>
                invoker.__winrtThunk_Invoke(sender, e)
            case None =>
                windows_core.E_NOTIMPL.value
        }
    }
    return vtbl
}
