    public static func fromAbiTakeWinrtHandle(raw: CPointer<Unit>): XamlRootChangedEventArgs {
        if (raw.isNull()) {
            throw windows_core.WindowsException(windows_core.E_POINTER)
        }
        XamlRootChangedEventArgs.fromAbiTake(raw)
    }

    public static func viewWinrtHandle(raw: CPointer<Unit>): XamlRootChangedEventArgs {
        XamlRootChangedEventArgs.viewOf(raw)
    }
}
