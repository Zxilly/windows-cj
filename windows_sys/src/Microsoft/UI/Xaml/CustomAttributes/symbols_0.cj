    public static func cloneWinrtValue(value: MUXPropertyValidationCallbackAttribute): MUXPropertyValidationCallbackAttribute {
        let raw = MUXPropertyValidationCallbackAttribute.intoOwnedWinrtHandle(value)
        if (raw.isNull()) {
            throw windows_core.WindowsException(windows_core.E_POINTER)
        }
        MUXPropertyValidationCallbackAttribute(raw, takeOwnership: true)
    }
}
