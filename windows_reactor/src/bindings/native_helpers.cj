public func PropVariantToWinRTPropertyValue(propvar: CPointer<PROPVARIANT>, riid: CPointer<GUID>, ppv: CPointer<CPointer<Unit>>): Int32 {
    let proc__ = CFunc<(CPointer<PROPVARIANT>, CPointer<GUID>, CPointer<CPointer<Unit>>) -> Int32>(windows_libloading.resolveProc("PROPSYS.dll", "PropVariantToWinRTPropertyValue"))
    return unsafe { proc__(propvar, riid, ppv) }
}

public func PropVariantToWinRTPropertyValueChecked(propvar: CPointer<PROPVARIANT>, riid: CPointer<GUID>, ppv: CPointer<CPointer<Unit>>): windows_core.Result<Unit> {
    if (ppv.isNull()) {
        return windows_core.Result<Unit>.Err(windows_core.errorFromHRESULT(windows_core.E_POINTER))
    }
    unsafe { ppv.write(CPointer<Unit>()) }
    let resultHr__ = windows_core.HRESULT(PropVariantToWinRTPropertyValue(propvar, riid, ppv))
    if (resultHr__.failed()) {
        windows_core.releaseFailedComOutSlot(ppv)
        return resultHr__.ok()
    }
    if (unsafe { ppv.read() }.isNull()) {
        windows_core.releaseFailedComOutSlot(ppv)
        return windows_core.Result<Unit>.Err(windows_core.errorFromHRESULT(windows_core.E_POINTER))
    }
    windows_core.Result<Unit>.Ok(())
}

