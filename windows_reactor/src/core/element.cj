func pivotItemArrayEquivalent(a: ArrayList<PivotItem>, b: ArrayList<PivotItem>): Bool {
    if (a.size != b.size) { return false }
    var i = 0
    while (i < a.size) {
        if (!a[i].equivalent(b[i])) { return false }
        i++
    }
    true
}

func tabItemArrayEquivalent(a: ArrayList<TabItem>, b: ArrayList<TabItem>): Bool {
    if (a.size != b.size) { return false }
    var i = 0
    while (i < a.size) {
        if (!a[i].equivalent(b[i])) { return false }
        i++
    }
    true
}
