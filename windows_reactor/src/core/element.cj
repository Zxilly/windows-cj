public func elementArrayEquivalent(a: Array<Element>, b: Array<Element>): Bool {
    if (a.size != b.size) { return false }
    var i = 0
    while (i < a.size) {
        if (!elementEquivalent(a[i], b[i])) { return false }
        i++
    }
    true
}

// True when the reconciler can skip diffing entirely: old/new equivalent and
// no theme bindings needing re-resolution.
public func canSkipUpdate(old: Element, neu: Element): Bool {
    if (!elementEquivalent(old, neu)) { return false }
    match (neu.modifiers()) {
        case Some(m) => !m.hasThemeBindings()
        case None => true
    }
}

// Grid placement field selector for the shared setGridPlacement helper.
public enum GridField { | Row | Column | RowSpan | ColumnSpan }

func setGridPlacement(mods: Modifiers, value: Int32, field: GridField): Unit {
    let p = match (mods.grid) { case Some(g) => g; case None => GridPlacement.default() }
    let np = match (field) {
        case Row => GridPlacement(value, p.column, p.rowSpan, p.columnSpan)
        case Column => GridPlacement(p.row, value, p.rowSpan, p.columnSpan)
        case RowSpan => GridPlacement(p.row, p.column, value, p.columnSpan)
        case ColumnSpan => GridPlacement(p.row, p.column, p.rowSpan, value)
    }
    mods.grid = Some(np)
}

// Canvas attached-position read-modify-write for the canvas* element modifiers.
// Each setter passes Some for the one field it changes; the rest keep their
// current value (default 0 when no CanvasPosition is present yet).
func setCanvasPosition(mods: Modifiers, left: ?Float64, top: ?Float64, zIndex: ?Int32): Unit {
    let p = match (mods.canvasPosition) { case Some(c) => c; case None => CanvasPosition.default() }
    let nl = match (left) { case Some(v) => v; case None => p.left }
    let nt = match (top) { case Some(v) => v; case None => p.top }
    let nz = match (zIndex) { case Some(v) => v; case None => p.zIndex }
    mods.canvasPosition = Some(CanvasPosition(nl, nt, nz))
}

func accessOf(mods: Modifiers): AccessibilityModifiers {
    match (mods.accessibility) {
        case Some(a) => a
        case None =>
            let a = AccessibilityModifiers()
            mods.accessibility = Some(a)
            a
    }
}

func setThemeBinding(mods: Modifiers, which: Prop, t: ThemeRef): Unit {
    let m = match (mods.themeBindings) {
        case Some(x) => x
        case None =>
            let x = HashMap<Prop, ThemeRef>()
            mods.themeBindings = Some(x)
            x
    }
    m.add(which, t)
}

func accelsOf(mods: Modifiers): ArrayList<KeyboardAccelerator> {
    match (mods.keyboardAccelerators) {
        case Some(a) => a
        case None =>
            let a = ArrayList<KeyboardAccelerator>()
            mods.keyboardAccelerators = Some(a)
            a
    }
}

func animModsOf(mods: Modifiers): AnimationModifiers {
    match (mods.animations) {
        case Some(a) => a
        case None =>
            let a = AnimationModifiers()
            mods.animations = Some(a)
            a
    }
}

func implicitTransitionsOf(mods: Modifiers): ImplicitTransitions {
    let am = animModsOf(mods)
    match (am.implicitTransitions) {
        case Some(t) => t
        case None =>
            let t = ImplicitTransitions()
            am.implicitTransitions = Some(t)
            t
    }
}

func optCbUnitEq(a: ?Callback<Unit>, b: ?Callback<Unit>): Bool {
    match ((a, b)) {
        case (Some(x), Some(y)) => x.sameAs(y)
        case (None, None) => true
        case _ => false
    }
}

