    public func kindMatches(other: Element): Bool {
        if (discriminant() != other.discriminant()) { return false }
        match ((this, other)) {
            case (CustomEl(a), CustomEl(b)) => a.customTypeId() == b.customTypeId()
            case _ => true
        }
    }

    public func canUpdate(other: Element): Bool {
        if (!kindMatches(other)) { return false }
        match ((this, other)) {
            case (ComponentEl(a), ComponentEl(b)) => a.obj.componentTypeId() == b.obj.componentTypeId()
            case (CustomEl(a), CustomEl(b)) => a.customTypeId() == b.customTypeId()
            case _ => true
        }
    }

    public func isEmpty(): Bool {
        match (this) { case EmptyEl => true; case _ => false }
    }
